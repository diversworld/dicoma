[2024-06-23T11:56:38.678906+01:00] doctrine.DEBUG: Executing statement: UPDATE courses SET description = ?, requirements = ?, notes = ? WHERE id = ? (parameters: array{"1":"<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Mit diesem Kurs wirst Du an das Tauchen im Freiwasser herangef&uuml;hrt. Du bekommst in Theorie und Praxis alle Kenntnisse vermittelt, um anschlie&szlig;end an, von einem erfahrenen Taucher gef&uuml;hrten Tauchg&auml;ngen im Freiwasser teilnehmen zu k&ouml;nnen.</span></p>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Nach erfolgreicher Teilnahme erh&auml;ltst Du die offizielle Lizenzkarte sowie einen Einkleber f&uuml;r den Taucherpass.</span></p>","2":"<ul>\r\n<li>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Mindestalter: 14 Jahre; Einverst&auml;ndniserkl&auml;rung der Sorgeberechtigten</span></p>\r\n</li>\r\n<li style=\"line-height: 1.4; font-size: 10pt;\">\r\n<p><span style=\"font-size: 10pt;\">G&uuml;ltige tauchsport&auml;rztliche Untersuchung (TSU)</span></p>\r\n</li>\r\n<li style=\"line-height: 1.4; font-size: 10pt;\">\r\n<p><span style=\"font-size: 10pt;\">Schwimmf&auml;higkeit</span></p>\r\n</li>\r\n<li style=\"font-size: 10pt;\">\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Es wird der Kurs Herz-Lungen-Wiederbelebung empfohlen</span></p>\r\n</li>\r\n</ul>","3":"<h3 class=\"ce_accordionStart b14  ce_accordion block\" style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Theoretischer Teil der Ausbildung</span></h3>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">In 3 Lerneinheiten werden die Theoretischen Kenntnisse zu Tauchphysik, Tauchmedizin, Tauchpraxis, Ausr&uuml;stung und Umweltschutz vermittelt.</span></p>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Die Theoretischen Kenntnisse werden im Anschluss durch die Beantwortung eines VDST Basic Fragebogens in einer schriftlichen oder m&uuml;ndlichen Pr&uuml;fung abgefragt.</span></p>\r\n<h3 id=\"ui-id-21\" class=\"toggler ui-accordion-header ui-corner-top ui-state-default ui-accordion-icons ui-accordion-header-active ui-state-active active\" style=\"line-height: 1.4;\" tabindex=\"0\" role=\"tab\" aria-controls=\"ui-id-22\" aria-selected=\"true\" aria-expanded=\"true\"><span style=\"font-size: 10pt;\">Praktischer Teil der Ausbildung</span></h3>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">&Uuml;bungen (mit ABC-Ausr&uuml;stung)</span></p>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">30 Sekunden Zeittauchen unter stetiger Ortsver&auml;nderung (von etwa 10 Meter).</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">25 Meter Streckentauchen ohne Neopren oder 20 Meter Streckentauchen mit Neoprenjacke und -hose.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Dreimal 2 bis 5 Meter Tieftauchen innerhalb von einer Minute.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">20 Minuten (Zeit) Schnorcheln unter Zur&uuml;cklegung einer Strecke von wenigstens 500 Metern in verschiedenen Lagen oder der Nachweis Flossenschwimmabzeichen Bronze nicht &auml;lter als 3 Jahre.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">50 Meter Schnorcheln zu einem Ger&auml;tetaucher, der auf 2 bis 5 Meter Tiefe liegt, Transportieren des Ger&auml;tetauchers an die Wasseroberfl&auml;che und 50 Meter an der Wasseroberfl&auml;che.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Zweimal regelgerechtes Springen (unterschiedliche Spr&uuml;nge) mit kompletter DTG-Ausr&uuml;stung aus einer H&ouml;he von ca. 0,5 Meter ins Wasser.</span></li>\r\n</ul>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">&Uuml;bungstauchg&auml;nge (mit DTG-Ausr&uuml;stung)</span></p>\r\n<ol>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer.</span>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Vollst&auml;ndiges und korrektes Anlegen und &Uuml;berpr&uuml;fen der Ausr&uuml;stung vor dem Tauchgang und Versorgen der Ausr&uuml;stung nach dem Tauchgang.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Atemregler aus dem Mund nehmen, auf den Zweitatemregler wechseln und wieder zur&uuml;ck</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Absetzen, Wiederaufsetzen und Ausblasen der Tauchermaske in 5 Meter Tiefe.</span></li>\r\n</ul>\r\n</li>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer</span>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">10 Minuten Schnorcheln an der Wasseroberfl&auml;che in kompletter Ausr&uuml;stung.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Orientierung: einfache Unterwasser-Navigation (z.B.: auf Anfrage des Pr&uuml;fers kann die Richtung des R&uuml;ckweges bestimmt werden).</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Geschwindigkeitskontrolliertes Aufsteigen aus maximal 10 Meter Tiefe im freien Wasser bis an die Wasseroberfl&auml;che mit einem Stopp von drei Minuten auf 5 Meter Tiefe.</span></li>\r\n</ul>\r\n</li>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer</span>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Transportieren des &bdquo;verunfallten&ldquo; Tauchpartners an die Wasseroberfl&auml;che bis zum Ufer bzw. Boot und anschlie&szlig;end an Land bzw. an Bord.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Demonstrieren der stabilen Seitenlage und der Schocklage.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Aufz&auml;hlen der nachfolgenden Ma&szlig;nahmen, um die Rettungskette in Gang zu setzen.</span></li>\r\n</ul>\r\n</li>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer</span>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Tarieren in drei unterschiedlichen Tiefen mit Hilfe der Atmung &uuml;ber die Lunge und bei Bedarf mit dem Inflator.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Geben von und Reagieren auf 5 Unterwasserpflichtzeichen.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Herausnehmen des Atemreglers in maximal 5 Meter Entfernung zum Tauchpartner, Hin Tauchen zum Tauchpartner, &bdquo;Luftnot&ldquo; Zeichen geben, Hauptatemregler des Tauchpartners nehmen, positionieren und Tauchgang 5 Minuten unter Atmung aus dem Hauptatemregler fortsetzen (einmal als Luftnehmer, einmal als Luftgeber).</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Geschwindigkeitskontrolliertes Aufsteigen am Hauptatemregler des Tauchpartners aus der maximalen Tiefe (vom Tauchlehrer bestimmt) im freien Wasser bis auf 5 Meter mit deutlichem Stopp und dann langsam an die Wasseroberfl&auml;che.</span></li>\r\n</ul>\r\n</li>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: Mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer. Tauchgang unter erschwerten Bedingungen</span>\r\n<ul>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">z.B. Tiefe zwischen 15 und 25 Meter, Nachttauchen, Tauchen vom Boot Str&ouml;mungstauchen, Tauchen bei schlechter Sicht oder Setzen einer Boje am Ende des Tauchgangs auf rund 10m Tiefe mittels Spool</span></li>\r\n</ul>\r\n</li>\r\n</ol>","4":1}, types: array{"1":2,"2":2,"3":2,"4":1}) {"sql":"UPDATE courses SET description = ?, requirements = ?, notes = ? WHERE id = ?","params":{"1":"<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Mit diesem Kurs wirst Du an das Tauchen im Freiwasser herangef&uuml;hrt. Du bekommst in Theorie und Praxis alle Kenntnisse vermittelt, um anschlie&szlig;end an, von einem erfahrenen Taucher gef&uuml;hrten Tauchg&auml;ngen im Freiwasser teilnehmen zu k&ouml;nnen.</span></p>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Nach erfolgreicher Teilnahme erh&auml;ltst Du die offizielle Lizenzkarte sowie einen Einkleber f&uuml;r den Taucherpass.</span></p>","2":"<ul>\r\n<li>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Mindestalter: 14 Jahre; Einverst&auml;ndniserkl&auml;rung der Sorgeberechtigten</span></p>\r\n</li>\r\n<li style=\"line-height: 1.4; font-size: 10pt;\">\r\n<p><span style=\"font-size: 10pt;\">G&uuml;ltige tauchsport&auml;rztliche Untersuchung (TSU)</span></p>\r\n</li>\r\n<li style=\"line-height: 1.4; font-size: 10pt;\">\r\n<p><span style=\"font-size: 10pt;\">Schwimmf&auml;higkeit</span></p>\r\n</li>\r\n<li style=\"font-size: 10pt;\">\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Es wird der Kurs Herz-Lungen-Wiederbelebung empfohlen</span></p>\r\n</li>\r\n</ul>","3":"<h3 class=\"ce_accordionStart b14  ce_accordion block\" style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Theoretischer Teil der Ausbildung</span></h3>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">In 3 Lerneinheiten werden die Theoretischen Kenntnisse zu Tauchphysik, Tauchmedizin, Tauchpraxis, Ausr&uuml;stung und Umweltschutz vermittelt.</span></p>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">Die Theoretischen Kenntnisse werden im Anschluss durch die Beantwortung eines VDST Basic Fragebogens in einer schriftlichen oder m&uuml;ndlichen Pr&uuml;fung abgefragt.</span></p>\r\n<h3 id=\"ui-id-21\" class=\"toggler ui-accordion-header ui-corner-top ui-state-default ui-accordion-icons ui-accordion-header-active ui-state-active active\" style=\"line-height: 1.4;\" tabindex=\"0\" role=\"tab\" aria-controls=\"ui-id-22\" aria-selected=\"true\" aria-expanded=\"true\"><span style=\"font-size: 10pt;\">Praktischer Teil der Ausbildung</span></h3>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">&Uuml;bungen (mit ABC-Ausr&uuml;stung)</span></p>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">30 Sekunden Zeittauchen unter stetiger Ortsver&auml;nderung (von etwa 10 Meter).</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">25 Meter Streckentauchen ohne Neopren oder 20 Meter Streckentauchen mit Neoprenjacke und -hose.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Dreimal 2 bis 5 Meter Tieftauchen innerhalb von einer Minute.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">20 Minuten (Zeit) Schnorcheln unter Zur&uuml;cklegung einer Strecke von wenigstens 500 Metern in verschiedenen Lagen oder der Nachweis Flossenschwimmabzeichen Bronze nicht &auml;lter als 3 Jahre.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">50 Meter Schnorcheln zu einem Ger&auml;tetaucher, der auf 2 bis 5 Meter Tiefe liegt, Transportieren des Ger&auml;tetauchers an die Wasseroberfl&auml;che und 50 Meter an der Wasseroberfl&auml;che.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Zweimal regelgerechtes Springen (unterschiedliche Spr&uuml;nge) mit kompletter DTG-Ausr&uuml;stung aus einer H&ouml;he von ca. 0,5 Meter ins Wasser.</span></li>\r\n</ul>\r\n<p style=\"line-height: 1.4;\"><span style=\"font-size: 10pt;\">&Uuml;bungstauchg&auml;nge (mit DTG-Ausr&uuml;stung)</span></p>\r\n<ol>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer.</span>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Vollst&auml;ndiges und korrektes Anlegen und &Uuml;berpr&uuml;fen der Ausr&uuml;stung vor dem Tauchgang und Versorgen der Ausr&uuml;stung nach dem Tauchgang.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Atemregler aus dem Mund nehmen, auf den Zweitatemregler wechseln und wieder zur&uuml;ck</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Absetzen, Wiederaufsetzen und Ausblasen der Tauchermaske in 5 Meter Tiefe.</span></li>\r\n</ul>\r\n</li>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer</span>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">10 Minuten Schnorcheln an der Wasseroberfl&auml;che in kompletter Ausr&uuml;stung.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Orientierung: einfache Unterwasser-Navigation (z.B.: auf Anfrage des Pr&uuml;fers kann die Richtung des R&uuml;ckweges bestimmt werden).</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Geschwindigkeitskontrolliertes Aufsteigen aus maximal 10 Meter Tiefe im freien Wasser bis an die Wasseroberfl&auml;che mit einem Stopp von drei Minuten auf 5 Meter Tiefe.</span></li>\r\n</ul>\r\n</li>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer</span>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Transportieren des &bdquo;verunfallten&ldquo; Tauchpartners an die Wasseroberfl&auml;che bis zum Ufer bzw. Boot und anschlie&szlig;end an Land bzw. an Bord.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Demonstrieren der stabilen Seitenlage und der Schocklage.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Aufz&auml;hlen der nachfolgenden Ma&szlig;nahmen, um die Rettungskette in Gang zu setzen.</span></li>\r\n</ul>\r\n</li>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer</span>\r\n<ul>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Tarieren in drei unterschiedlichen Tiefen mit Hilfe der Atmung &uuml;ber die Lunge und bei Bedarf mit dem Inflator.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Geben von und Reagieren auf 5 Unterwasserpflichtzeichen.</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Herausnehmen des Atemreglers in maximal 5 Meter Entfernung zum Tauchpartner, Hin Tauchen zum Tauchpartner, &bdquo;Luftnot&ldquo; Zeichen geben, Hauptatemregler des Tauchpartners nehmen, positionieren und Tauchgang 5 Minuten unter Atmung aus dem Hauptatemregler fortsetzen (einmal als Luftnehmer, einmal als Luftgeber).</span></li>\r\n<li style=\"font-size: 10pt;\"><span style=\"font-size: 10pt;\">Geschwindigkeitskontrolliertes Aufsteigen am Hauptatemregler des Tauchpartners aus der maximalen Tiefe (vom Tauchlehrer bestimmt) im freien Wasser bis auf 5 Meter mit deutlichem Stopp und dann langsam an die Wasseroberfl&auml;che.</span></li>\r\n</ul>\r\n</li>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">Tauchgang: Mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer. Tauchgang unter erschwerten Bedingungen</span>\r\n<ul>\r\n<li style=\"font-size: 10pt; line-height: 1.4;\"><span style=\"font-size: 10pt;\">z.B. Tiefe zwischen 15 und 25 Meter, Nachttauchen, Tauchen vom Boot Str&ouml;mungstauchen, Tauchen bei schlechter Sicht oder Setzen einer Boje am Ende des Tauchgangs auf rund 10m Tiefe mittels Spool</span></li>\r\n</ul>\r\n</li>\r\n</ol>","4":1},"types":{"1":2,"2":2,"3":2,"4":1}} []
