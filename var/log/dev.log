[2024-06-23T11:53:29.585572+01:00] doctrine.DEBUG: Executing statement: INSERT INTO courses (title, description, requirements, image, notes, category) VALUES (?, ?, ?, ?, ?, ?) (parameters: array{"1":"GDL Sports Diver (DTSA*)","2":"<p>Mit diesem Kurs wirst Du an das Tauchen im Freiwasser herangef&uuml;hrt. Du bekommst in Theorie und Praxis alle Kenntnisse vermittelt, um anschlie&szlig;end an, von einem erfahrenen Taucher gef&uuml;hrten Tauchg&auml;ngen im Freiwasser teilnehmen zu k&ouml;nnen.</p>\r\n<p>Nach erfolgreicher Teilnahme erh&auml;ltst Du die offizielle Lizenzkarte sowie einen Einkleber f&uuml;r den Taucherpass.</p>","3":"<ul>\r\n<li>Mindestalter: 14 Jahre; Einverst&auml;ndniserkl&auml;rung der Sorgeberechtigten</li>\r\n<li>G&uuml;ltige tauchsport&auml;rztliche Untersuchung (TSU)</li>\r\n<li>Schwimmf&auml;higkeit</li>\r\n<li>Es wird der Kurs Herz-Lungen-Wiederbelebung empfohlen</li>\r\n</ul>","4":"phpOMIUeD.jpg","5":"<section class=\"ce_accordionStart b14  ce_accordion block\">\r\n<h3 id=\"ui-id-19\" class=\"toggler ui-accordion-header ui-corner-top ui-state-default ui-accordion-icons ui-accordion-header-collapsed ui-corner-all\" tabindex=\"0\" role=\"tab\" aria-controls=\"ui-id-20\" aria-selected=\"false\" aria-expanded=\"false\">Theoretischer Teil der Ausbildung</h3>\r\n</section>\r\n<p>In 3 Lerneinheiten werden die Theoretischen Kenntnisse zu Tauchphysik, Tauchmedizin, Tauchpraxis, Ausr&uuml;stung und Umweltschutz vermittelt.</p>\r\n<p>Die Theoretischen Kenntnisse werden im Anschluss durch die Beantwortung eines VDST Basic Fragebogens in einer schriftlichen oder m&uuml;ndlichen Pr&uuml;fung abgefragt.</p>\r\n<h3 id=\"ui-id-21\" class=\"toggler ui-accordion-header ui-corner-top ui-state-default ui-accordion-icons ui-accordion-header-active ui-state-active active\" tabindex=\"0\" role=\"tab\" aria-controls=\"ui-id-22\" aria-selected=\"true\" aria-expanded=\"true\">Praktischer Teil der Ausbildung</h3>\r\n<p>&Uuml;bungen (mit ABC-Ausr&uuml;stung)</p>\r\n<ul>\r\n<li>30 Sekunden Zeittauchen unter stetiger Ortsver&auml;nderung (von etwa 10 Meter).</li>\r\n<li>25 Meter Streckentauchen ohne Neopren oder 20 Meter Streckentauchen mit Neoprenjacke und -hose.</li>\r\n<li>Dreimal 2 bis 5 Meter Tieftauchen innerhalb von einer Minute.</li>\r\n<li>20 Minuten (Zeit) Schnorcheln unter Zur&uuml;cklegung einer Strecke von wenigstens 500 Metern in verschiedenen Lagen oder der Nachweis Flossenschwimmabzeichen Bronze nicht &auml;lter als 3 Jahre.</li>\r\n<li>50 Meter Schnorcheln zu einem Ger&auml;tetaucher, der auf 2 bis 5 Meter Tiefe liegt, Transportieren des Ger&auml;tetauchers an die Wasseroberfl&auml;che und 50 Meter an der Wasseroberfl&auml;che.</li>\r\n<li>Zweimal regelgerechtes Springen (unterschiedliche Spr&uuml;nge) mit kompletter DTG-Ausr&uuml;stung aus einer H&ouml;he von ca. 0,5 Meter ins Wasser.</li>\r\n</ul>\r\n<p>&Uuml;bungstauchg&auml;nge (mit DTG-Ausr&uuml;stung)</p>\r\n<ol>\r\n<li>Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer.\r\n<ul>\r\n<li>Vollst&auml;ndiges und korrektes Anlegen und &Uuml;berpr&uuml;fen der Ausr&uuml;stung vor dem Tauchgang und Versorgen der Ausr&uuml;stung nach dem Tauchgang.</li>\r\n<li>Atemregler aus dem Mund nehmen, auf den Zweitatemregler wechseln und wieder zur&uuml;ck</li>\r\n<li>Absetzen, Wiederaufsetzen und Ausblasen der Tauchermaske in 5 Meter Tiefe.</li>\r\n</ul>\r\n</li>\r\n<li>Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer\r\n<ul>\r\n<li>10 Minuten Schnorcheln an der Wasseroberfl&auml;che in kompletter Ausr&uuml;stung.</li>\r\n<li>Orientierung: einfache Unterwasser-Navigation (z.B.: auf Anfrage des Pr&uuml;fers kann die Richtung des R&uuml;ckweges bestimmt werden).</li>\r\n<li>Geschwindigkeitskontrolliertes Aufsteigen aus maximal 10 Meter Tiefe im freien Wasser bis an die Wasseroberfl&auml;che mit einem Stopp von drei Minuten auf 5 Meter Tiefe.</li>\r\n</ul>\r\n</li>\r\n<li>Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer\r\n<ul>\r\n<li>Transportieren des &bdquo;verunfallten&ldquo; Tauchpartners an die Wasseroberfl&auml;che bis zum Ufer bzw. Boot und anschlie&szlig;end an Land bzw. an Bord.</li>\r\n<li>Demonstrieren der stabilen Seitenlage und der Schocklage.</li>\r\n<li>Aufz&auml;hlen der nachfolgenden Ma&szlig;nahmen, um die Rettungskette in Gang zu setzen.</li>\r\n</ul>\r\n</li>\r\n<li>Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer\r\n<ul>\r\n<li>Tarieren in drei unterschiedlichen Tiefen mit Hilfe der Atmung &uuml;ber die Lunge und bei Bedarf mit dem Inflator.</li>\r\n<li>Geben von und Reagieren auf 5 Unterwasserpflichtzeichen.</li>\r\n<li>Herausnehmen des Atemreglers in maximal 5 Meter Entfernung zum Tauchpartner, Hin Tauchen zum Tauchpartner, &bdquo;Luftnot&ldquo; Zeichen geben, Hauptatemregler des Tauchpartners nehmen, positionieren und Tauchgang 5 Minuten unter Atmung aus dem Hauptatemregler fortsetzen (einmal als Luftnehmer, einmal als Luftgeber).</li>\r\n<li>Geschwindigkeitskontrolliertes Aufsteigen am Hauptatemregler des Tauchpartners aus der maximalen Tiefe (vom Tauchlehrer bestimmt) im freien Wasser bis auf 5 Meter mit deutlichem Stopp und dann langsam an die Wasseroberfl&auml;che.</li>\r\n</ul>\r\n</li>\r\n<li>Tauchgang: Mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer. Tauchgang unter erschwerten Bedingungen\r\n<ul>\r\n<li>z.B. Tiefe zwischen 15 und 25 Meter, Nachttauchen, Tauchen vom Boot Str&ouml;mungstauchen, Tauchen bei schlechter Sicht oder Setzen einer Boje am Ende des Tauchgangs auf rund 10m Tiefe mittels Spool</li>\r\n</ul>\r\n</li>\r\n</ol>","6":"beginner"}, types: array{"1":2,"2":2,"3":2,"4":2,"5":2,"6":2}) {"sql":"INSERT INTO courses (title, description, requirements, image, notes, category) VALUES (?, ?, ?, ?, ?, ?)","params":{"1":"GDL Sports Diver (DTSA*)","2":"<p>Mit diesem Kurs wirst Du an das Tauchen im Freiwasser herangef&uuml;hrt. Du bekommst in Theorie und Praxis alle Kenntnisse vermittelt, um anschlie&szlig;end an, von einem erfahrenen Taucher gef&uuml;hrten Tauchg&auml;ngen im Freiwasser teilnehmen zu k&ouml;nnen.</p>\r\n<p>Nach erfolgreicher Teilnahme erh&auml;ltst Du die offizielle Lizenzkarte sowie einen Einkleber f&uuml;r den Taucherpass.</p>","3":"<ul>\r\n<li>Mindestalter: 14 Jahre; Einverst&auml;ndniserkl&auml;rung der Sorgeberechtigten</li>\r\n<li>G&uuml;ltige tauchsport&auml;rztliche Untersuchung (TSU)</li>\r\n<li>Schwimmf&auml;higkeit</li>\r\n<li>Es wird der Kurs Herz-Lungen-Wiederbelebung empfohlen</li>\r\n</ul>","4":"phpOMIUeD.jpg","5":"<section class=\"ce_accordionStart b14  ce_accordion block\">\r\n<h3 id=\"ui-id-19\" class=\"toggler ui-accordion-header ui-corner-top ui-state-default ui-accordion-icons ui-accordion-header-collapsed ui-corner-all\" tabindex=\"0\" role=\"tab\" aria-controls=\"ui-id-20\" aria-selected=\"false\" aria-expanded=\"false\">Theoretischer Teil der Ausbildung</h3>\r\n</section>\r\n<p>In 3 Lerneinheiten werden die Theoretischen Kenntnisse zu Tauchphysik, Tauchmedizin, Tauchpraxis, Ausr&uuml;stung und Umweltschutz vermittelt.</p>\r\n<p>Die Theoretischen Kenntnisse werden im Anschluss durch die Beantwortung eines VDST Basic Fragebogens in einer schriftlichen oder m&uuml;ndlichen Pr&uuml;fung abgefragt.</p>\r\n<h3 id=\"ui-id-21\" class=\"toggler ui-accordion-header ui-corner-top ui-state-default ui-accordion-icons ui-accordion-header-active ui-state-active active\" tabindex=\"0\" role=\"tab\" aria-controls=\"ui-id-22\" aria-selected=\"true\" aria-expanded=\"true\">Praktischer Teil der Ausbildung</h3>\r\n<p>&Uuml;bungen (mit ABC-Ausr&uuml;stung)</p>\r\n<ul>\r\n<li>30 Sekunden Zeittauchen unter stetiger Ortsver&auml;nderung (von etwa 10 Meter).</li>\r\n<li>25 Meter Streckentauchen ohne Neopren oder 20 Meter Streckentauchen mit Neoprenjacke und -hose.</li>\r\n<li>Dreimal 2 bis 5 Meter Tieftauchen innerhalb von einer Minute.</li>\r\n<li>20 Minuten (Zeit) Schnorcheln unter Zur&uuml;cklegung einer Strecke von wenigstens 500 Metern in verschiedenen Lagen oder der Nachweis Flossenschwimmabzeichen Bronze nicht &auml;lter als 3 Jahre.</li>\r\n<li>50 Meter Schnorcheln zu einem Ger&auml;tetaucher, der auf 2 bis 5 Meter Tiefe liegt, Transportieren des Ger&auml;tetauchers an die Wasseroberfl&auml;che und 50 Meter an der Wasseroberfl&auml;che.</li>\r\n<li>Zweimal regelgerechtes Springen (unterschiedliche Spr&uuml;nge) mit kompletter DTG-Ausr&uuml;stung aus einer H&ouml;he von ca. 0,5 Meter ins Wasser.</li>\r\n</ul>\r\n<p>&Uuml;bungstauchg&auml;nge (mit DTG-Ausr&uuml;stung)</p>\r\n<ol>\r\n<li>Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer.\r\n<ul>\r\n<li>Vollst&auml;ndiges und korrektes Anlegen und &Uuml;berpr&uuml;fen der Ausr&uuml;stung vor dem Tauchgang und Versorgen der Ausr&uuml;stung nach dem Tauchgang.</li>\r\n<li>Atemregler aus dem Mund nehmen, auf den Zweitatemregler wechseln und wieder zur&uuml;ck</li>\r\n<li>Absetzen, Wiederaufsetzen und Ausblasen der Tauchermaske in 5 Meter Tiefe.</li>\r\n</ul>\r\n</li>\r\n<li>Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer\r\n<ul>\r\n<li>10 Minuten Schnorcheln an der Wasseroberfl&auml;che in kompletter Ausr&uuml;stung.</li>\r\n<li>Orientierung: einfache Unterwasser-Navigation (z.B.: auf Anfrage des Pr&uuml;fers kann die Richtung des R&uuml;ckweges bestimmt werden).</li>\r\n<li>Geschwindigkeitskontrolliertes Aufsteigen aus maximal 10 Meter Tiefe im freien Wasser bis an die Wasseroberfl&auml;che mit einem Stopp von drei Minuten auf 5 Meter Tiefe.</li>\r\n</ul>\r\n</li>\r\n<li>Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer\r\n<ul>\r\n<li>Transportieren des &bdquo;verunfallten&ldquo; Tauchpartners an die Wasseroberfl&auml;che bis zum Ufer bzw. Boot und anschlie&szlig;end an Land bzw. an Bord.</li>\r\n<li>Demonstrieren der stabilen Seitenlage und der Schocklage.</li>\r\n<li>Aufz&auml;hlen der nachfolgenden Ma&szlig;nahmen, um die Rettungskette in Gang zu setzen.</li>\r\n</ul>\r\n</li>\r\n<li>Tauchgang: 6-15 Meter Tiefe / mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer\r\n<ul>\r\n<li>Tarieren in drei unterschiedlichen Tiefen mit Hilfe der Atmung &uuml;ber die Lunge und bei Bedarf mit dem Inflator.</li>\r\n<li>Geben von und Reagieren auf 5 Unterwasserpflichtzeichen.</li>\r\n<li>Herausnehmen des Atemreglers in maximal 5 Meter Entfernung zum Tauchpartner, Hin Tauchen zum Tauchpartner, &bdquo;Luftnot&ldquo; Zeichen geben, Hauptatemregler des Tauchpartners nehmen, positionieren und Tauchgang 5 Minuten unter Atmung aus dem Hauptatemregler fortsetzen (einmal als Luftnehmer, einmal als Luftgeber).</li>\r\n<li>Geschwindigkeitskontrolliertes Aufsteigen am Hauptatemregler des Tauchpartners aus der maximalen Tiefe (vom Tauchlehrer bestimmt) im freien Wasser bis auf 5 Meter mit deutlichem Stopp und dann langsam an die Wasseroberfl&auml;che.</li>\r\n</ul>\r\n</li>\r\n<li>Tauchgang: Mindestens 15 Minuten Dauer / mindestens 1 Taucher und Tauchlehrer. Tauchgang unter erschwerten Bedingungen\r\n<ul>\r\n<li>z.B. Tiefe zwischen 15 und 25 Meter, Nachttauchen, Tauchen vom Boot Str&ouml;mungstauchen, Tauchen bei schlechter Sicht oder Setzen einer Boje am Ende des Tauchgangs auf rund 10m Tiefe mittels Spool</li>\r\n</ul>\r\n</li>\r\n</ol>","6":"beginner"},"types":{"1":2,"2":2,"3":2,"4":2,"5":2,"6":2}} []
