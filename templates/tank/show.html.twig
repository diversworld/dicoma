{% extends 'base.html.twig' %}

{% block title %}Tank{% endblock %}

{% block body %}
<section class="portfolio-work section">
    <div class="container">
        <h1>Tank</h1>
        <div class="row text-bg-dark text-center">
            <div class="col-md-12">
                <ul class="list-inline">
                    <li class="list-inline-item">
                        <a href="{{ path('app_tank_index') }}" class="btn btn-transparent btn-solid-border">zurück</a>
                    </li>
                    <li class="list-inline-item">
                        <a href="{{ path('app_tank_edit', {'id': tank.id}) }}" class="btn btn-transparent btn-solid-border">Bearbeiten</a>
                    </li>
                    <li class="list-inline-item">
                        {{ include('tank/_delete_form.html.twig') }}
                    </li>
                </ul>
            </div>
        </div>
        <table class="table">
            <tbody>
                <tr>
                    <th>Inventory</th>
                    <td>{{ tank.inventory }}</td>
                </tr>
                <tr>
                    <th>Serialnumber</th>
                    <td>{{ tank.serialnumber }}</td>
                </tr>
                <tr>
                    <th>Size</th>
                    <td>{{ tank.size }}</td>
                </tr>
                <tr>
                    <th>BuyDate</th>
                    <td>{{ tank.buyDate ? tank.buyDate|date('d.m.Y') : '' }}</td>
                </tr>
                <tr>
                    <th>LastCheckDate</th>
                    <td>{{ tank.lastCheckDate ? tank.lastCheckDate|date('d.m.Y') : '' }}</td>
                </tr>
                <tr>
                    <th>NextCheckDate</th>
                    <td>{{ tank.nextCheckDate ? tank.nextCheckDate|date('d.m.Y') : '' }}</td>
                </tr>
                <tr>
                    <th>Notes</th>
                    <td>{{ tank.notes }}</td>
                </tr>
                <tr>
                    <th>OxigenClean</th>
                    <td>{{ tank.oxigenClean ? 'Yes' : 'No' }}</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
