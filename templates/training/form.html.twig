{% extends 'training/layout.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block training_body %}
<header class="dw-form-heading">
    <h1>{{ title }}</h1>
    <p class="text-muted">Pflichtfelder sind gekennzeichnet. Fehler werden direkt am betroffenen Feld angezeigt.</p>
</header>
<section class="dw-form-card">
    {{ form_start(form, {attr: {class: 'dw-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
        <div class="dw-form-actions">
            <button class="btn btn-primary" type="submit">Speichern</button>
            <a class="btn btn-outline-secondary" href="{{ path(training_route_prefix ~ 'training_portal') }}">Abbrechen</a>
        </div>
    {{ form_end(form, {render_rest: false}) }}
</section>
{% endblock %}
