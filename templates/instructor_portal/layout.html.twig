{% extends 'base.html.twig' %}
{% block title %}DICOMA · Ausbilder{% endblock %}
{% block hero %}{% endblock %}
{% block stylesheets %}{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/pages/instructor-portal-layout.css') }}">
{% endblock %}
{% block body %}
<main class="container py-4 instructor-portal">
    {% for type, messages in app.flashes %}
        {% for message in messages %}<div class="alert alert-{{ type }}" role="status">{{ message }}</div>{% endfor %}
    {% endfor %}
    {% block instructor_body %}{% endblock %}
</main>
{% endblock %}
