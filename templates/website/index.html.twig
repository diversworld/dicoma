{% extends 'base.html.twig' %}
{% block hero %}{% endblock %}
{% block title %}{{ kind == 'event' ? 'Veranstaltungen' : 'Aktuelles' }} | DICOMA{% endblock %}
{% block body %}
<main class="section">
  <div class="container">
    <h1>{{ kind == 'event' ? 'Kommende Veranstaltungen' : 'Aktuelles aus dem Verein' }}</h1>
    {% if kind == 'event' %}
        {% include 'website/_event_cards.html.twig' with {entries: contentPage.items} %}
    {% else %}
        {% include 'website/_cards.html.twig' with {publications: contentPage.items} %}
    {% endif %}
    {% include 'website/_pagination.html.twig' with {pagination: contentPage, parameter: 'seite', label: kind == 'event' ? 'Veranstaltungen' : 'Artikel', anchor: ''} %}
  </div>
</main>
{% endblock %}
