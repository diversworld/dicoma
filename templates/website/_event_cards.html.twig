<div class="row">
    {% for entry in entries %}
        {% set event = entry.event %}
        {% set publication = entry.publication %}
        <article class="col-md-6 mb-4"><div class="block">
            {% if event %}
                {% if event.image %}{% include 'website/_image.html.twig' with {image: event.image, url: path('club_event_image', {id: event.id})} %}{% endif %}
                <h3><a href="{{ path('club_event_detail', {id: event.id}) }}">{{ event.title }}</a></h3>
                <p>{{ event.startsAt|date('d.m.Y H:i') }} · {{ event.location }}</p>
                <p>{{ event.pricing == 'members_free' ? 'Kostenfrei für Mitglieder' : 'Mitglieder und Gäste' }}</p>
                <a class="btn btn-small" href="{{ path('club_event_detail', {id: event.id}) }}">Details und Anmeldung</a>
            {% else %}
                {% if publication.image %}{% include 'website/_image.html.twig' with {image: publication.image, url: path('website_publication_image', {id: publication.id})} %}{% endif %}
                <h3><a href="{{ path('website_publication', {id: publication.id}) }}">{{ publication.title }}</a></h3>
                <p><time datetime="{{ publication.startsAt|date('c') }}">{{ publication.startsAt|date('d.m.Y H:i') }}</time> – {{ publication.endsAt|date('d.m.Y H:i') }} · {{ publication.location }}</p>
                <p>{{ publication.summary }}</p>
                <a class="btn btn-small" href="{{ path('website_publication', {id: publication.id}) }}">Weiterlesen</a>
            {% endif %}
        </div></article>
    {% else %}
        <div class="col-12"><p>Derzeit keine veröffentlichten Veranstaltungen.</p></div>
    {% endfor %}
</div>
