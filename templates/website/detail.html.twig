{% extends 'base.html.twig' %}
{% block hero %}{% endblock %}
{% block title %}{{ publication.title }} | DICOMA{% endblock %}
{% block body %}
<main class="container section"><article>
    <h1>{{ publication.title }}</h1>
    {% if publication.division %}<p><a href="{{ path('website_division', {id: publication.division.id}) }}">{{ publication.division.name }}</a></p>{% endif %}
    {% if publication.image %}{% include 'website/_image.html.twig' with {image: publication.image, url: path('website_publication_image', {id: publication.id})} %}{% endif %}
    <p class="lead">{{ publication.summary }}</p>
    {% if publication.kind == 'event' %}<p><time datetime="{{ publication.startsAt|date('c') }}">{{ publication.startsAt|date('d.m.Y H:i') }}</time> – {{ publication.endsAt|date('d.m.Y H:i') }} · {{ publication.location }}</p>{% endif %}
    <div>{{ publication.body|nl2br }}</div>
    {% if publication.course %}<p><a class="btn btn-main" href="{{ path('app_courses_index') }}">Zum Kursangebot</a></p>{% endif %}
    <p><a href="{{ path(publication.kind == 'event' ? 'website_events' : (publication.kind == 'page' ? 'website_pages' : 'website_articles')) }}">Zurück zur Übersicht</a></p>
    {% if subpages|length %}
        <nav class="mb-4" aria-label="Unterseiten"><h2 class="h4">Unterseiten</h2><ul>{% for page in subpages %}<li><a href="{{ path('website_page', {id: page.id}) }}">{{ page.title }}</a></li>{% endfor %}</ul></nav>
    {% endif %}
    {% if articles|length %}
        <section class="mt-4"><h2 class="h4">Artikel</h2>{% for article in articles %}
            <article class="mb-3"><h3 class="h5"><a href="{{ path('website_publication', {id: article.id}) }}">{{ article.title }}</a></h3><p>{{ article.summary }}</p></article>
        {% endfor %}</section>
    {% endif %}
</article></main>
{% endblock %}
