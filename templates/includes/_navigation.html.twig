{% set navigation = portal_navigation.links %}
{% set current_route = app.request.attributes.get('_route') %}
<nav class="navbar navbar-expand-lg p-0" aria-label="{{ 'Hauptnavigation'|trans }}">
    <a class="navbar-brand" href="{{ path('app_home') }}">
        <img src="{{ asset('images/Diversworld-Wort-Logo-ws.png') }}" width="250" alt="Diversworld">
    </a>
    <button class="navbar-toggler collapsed" type="button" data-toggle="collapse" data-target="#frontendNavbar" aria-controls="frontendNavbar" aria-expanded="false" aria-label="{{ 'Navigation umschalten'|trans }}">
        <span class="ion-android-menu" aria-hidden="true"></span>
    </button>
    <div class="collapse navbar-collapse ml-auto" id="frontendNavbar">
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link{{ current_route == publicMenu.home.route ? ' active' : '' }}" href="{{ path(publicMenu.home.route) }}"{% if current_route == publicMenu.home.route %} aria-current="page"{% endif %}>{{ publicMenu.home.label|trans }}</a>
            </li>
            {% for label, links in publicMenu.groups %}
                <li class="nav-item dropdown">
                    <button class="nav-link dropdown-toggle btn" type="button" id="frontendPublicMenu{{ loop.index }}" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ label|trans }}</button>
                    <ul class="dropdown-menu" aria-labelledby="frontendPublicMenu{{ loop.index }}">
                        {% for item in links %}
                            <li><a class="dropdown-item" href="{{ path(item.route) }}"{% if current_route == item.route %} aria-current="page"{% endif %}>{{ item.label|trans }}</a></li>
                        {% endfor %}
                    </ul>
                </li>
            {% endfor %}
            {% for page in publicMenu.pages %}
                {% set active = current_route == page.route and app.request.attributes.get('id') == page.parameters.id %}
                {% if page.children|default([]) %}
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle btn{{ active ? ' active' : '' }}" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ page.label }}</button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path(page.route, page.parameters) }}">{{ page.label }}</a></li>
                            {% for child in page.children %}<li><a class="dropdown-item" href="{{ path(child.route, child.parameters) }}">{{ child.label }}</a></li>{% endfor %}
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item"><a class="nav-link{{ active ? ' active' : '' }}" href="{{ path(page.route, page.parameters) }}"{% if active %} aria-current="page"{% endif %}>{{ page.label }}</a></li>
                {% endif %}
            {% endfor %}
            {% if app.user %}
                <li class="nav-item dropdown">
                    <button class="nav-link dropdown-toggle btn" type="button" id="frontendPersonalMenu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ 'Mein Bereich'|trans }}</button>
                    <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="frontendPersonalMenu">
                        <li><a class="dropdown-item" href="{{ path('account_profile') }}">{{ 'Mein Konto'|trans }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('account_password') }}">{{ 'Kennwort ändern'|trans }}</a></li>
                        {% for item in navigation.personal %}
                            <li><a class="dropdown-item" href="{{ path(item.route) }}"{% if current_route == item.route %} aria-current="page"{% endif %}>{{ item.label|trans }}</a></li>
                        {% endfor %}
                        <li><form method="post" action="{{ path('app_logout') }}" class="m-0">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button type="submit" class="dropdown-item">{{ 'Abmelden'|trans }}</button>
                        </form></li>
                    </ul>
                </li>
                {% if navigation.roles %}
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle btn" type="button" id="frontendRoleMenu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ 'Funktionen'|trans }}</button>
                        <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="frontendRoleMenu">
                            {% for label, links in navigation.roles %}
                            <li class="dropdown-header">{{ label|trans }}</li>
                            {% for item in links %}
                                <li><a class="dropdown-item" href="{{ path(item.route) }}">{{ item.label|trans }}</a></li>
                            {% endfor %}
                            {% endfor %}
                        </ul>
                    </li>
                {% endif %}
            {% else %}
                <li class="nav-item dropdown">
                    <button class="nav-link dropdown-toggle btn" type="button" id="frontendAccountMenu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ 'Mein Konto'|trans }}</button>
                    <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="frontendAccountMenu">
                        <li><a class="dropdown-item" href="{{ path('app_login') }}">{{ 'Anmelden'|trans }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_register') }}">{{ 'Registrieren'|trans }}</a></li>
                    </ul>
                </li>
            {% endif %}
        </ul>
    </div>
</nav>
