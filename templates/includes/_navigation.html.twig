{% set navigation = portal_navigation.links %}
{% set current_route = app.request.attributes.get('_route') %}
<nav class="navbar navbar-expand-lg p-0" aria-label="{{ 'Hauptnavigation'|trans }}">
    <a class="navbar-brand" href="{{ path('app_home') }}">
        <img src="{{ asset('images/Diversworld-Wort-Logo-ws.png') }}" width="250" alt="Diversworld">
    </a>
    <button class="navbar-toggler collapsed" type="button" data-toggle="collapse" data-target="#frontendNavbar" aria-controls="frontendNavbar" aria-expanded="false" aria-label="{{ 'Navigation umschalten'|trans }}">
        <span class="ion-android-menu" aria-hidden="true"></span>
    </button>
    <div class="collapse navbar-collapse ml-auto" id="frontendNavbar">
        <ul class="navbar-nav ml-auto">
            {% for item in portal_navigation.publicLinks %}
                <li class="nav-item">
                    <a class="nav-link{{ current_route == item.route ? ' active' : '' }}" href="{{ path(item.route) }}"{% if current_route == item.route %} aria-current="page"{% endif %}>{{ item.label|trans }}</a>
                </li>
            {% endfor %}
            {% if app.user %}
                {% if navigation.personal %}
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle btn" type="button" id="frontendPersonalMenu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ 'Mein Bereich'|trans }}</button>
                        <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="frontendPersonalMenu">
                            {% for item in navigation.personal %}
                                <li><a class="dropdown-item" href="{{ path(item.route) }}"{% if current_route == item.route %} aria-current="page"{% endif %}>{{ item.label|trans }}</a></li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endif %}
                {% for label, links in navigation.roles %}
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle btn" type="button" id="frontendRoleMenu{{ loop.index }}" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ label|trans }}</button>
                        <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="frontendRoleMenu{{ loop.index }}">
                            {% for item in links %}
                                <li><a class="dropdown-item" href="{{ path(item.route) }}">{{ item.label|trans }}</a></li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
                <li class="nav-item">
                    <form method="post" action="{{ path('app_logout') }}" class="m-0">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="btn btn-sm btn-outline-light">{{ 'Abmelden'|trans }}</button>
                    </form>
                </li>
            {% else %}
                <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">{{ 'Anmelden'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_register') }}">{{ 'Registrieren'|trans }}</a></li>
            {% endif %}
        </ul>
    </div>
</nav>
