{% extends 'base.html.twig' %}

{% block title %}Vereinsleben | DICOMA{% endblock %}

{% block body %}
    <section class="about section">
        <div class="container">
            <h2>Aktuelles aus dem Verein</h2>
            {% include 'website/_cards.html.twig' with {publications:articles, kind:'article'} %}
            <p><a href="{{ path('website_articles') }}">Alle Artikel</a></p>
            <h2>Kommende Veranstaltungen</h2>
            {% include 'website/_cards.html.twig' with {publications:events, kind:'event'} %}
            <p><a href="{{ path('website_events') }}">Alle Veranstaltungen</a></p>
        </div>
    </section>
{% endblock %}
