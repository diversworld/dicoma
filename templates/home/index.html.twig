{% extends 'base.html.twig' %}

{% block title %}Vereinsleben | DICOMA{% endblock %}

{% block body %}
    <section class="about section">
        <div class="container">
            <h2 id="aktuelles">Aktuelles aus dem Verein</h2>
            {% include 'website/_cards.html.twig' with {publications:articlesPage.items, kind:'article'} %}
            {% include 'website/_pagination.html.twig' with {pagination: articlesPage, parameter: 'artikel_seite', label: 'Artikel', anchor: 'aktuelles'} %}
            <p><a href="{{ path('website_articles') }}">Alle Artikel</a></p>
            <h2 id="veranstaltungen">Kommende Veranstaltungen</h2>
            {% include 'website/_event_cards.html.twig' with {entries: eventsPage.items} %}
            {% include 'website/_pagination.html.twig' with {pagination: eventsPage, parameter: 'veranstaltungen_seite', label: 'Veranstaltungen', anchor: 'veranstaltungen'} %}
            <p><a href="{{ path('website_events') }}">Alle Veranstaltungen</a></p>
        </div>
    </section>
{% endblock %}
