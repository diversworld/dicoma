<form method="post" action="{{ path('app_tank_check_article_delete', {'id': tank_check_article.id}) }}" onsubmit="return confirm({{ 'Are you sure you want to delete this item?'|trans|json_encode|e('html_attr') }});">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tank_check_article.id) }}">
    <button class="btn btn-outline-danger">{{ 'Delete'|trans }}</button>
</form>
