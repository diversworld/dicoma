{% extends 'base.html.twig' %}

{% block title %}{{ 'Anmelden'|trans }}{% endblock %}

{% block body %}
    <section class="about section">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    {% if app.user %}
                        <div class="mb-3">
                            {{ 'Du bist angemeldet als %user%.'|trans({'%user%': app.user.userIdentifier}) }}
                            <form method="post" action="{{ path('app_logout') }}" class="d-inline">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                <button type="submit" class="btn btn-link p-0">{{ 'Abmelden'|trans }}</button>
                            </form>
                        </div>
                    {% endif %}
                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}


                        <h1 class="h3 mb-3 font-weight-normal">{{ 'Bitte melde Dich an'|trans }}</h1>

                        <label for="inputUsername">{{ 'Benutzername'|trans }}</label>
                        <input type="text" value="{{ last_username }}" name="_username" id="inputUsername" class="form-control" autocomplete="username" required autofocus>

                        <label for="inputPassword">{{ 'Passwort'|trans }}</label>
                        <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required>

                        <input type="hidden" name="_csrf_token"
                               value="{{ csrf_token('authenticate') }}"
                        >

                        <button class="btn btn-lg btn-primary" type="submit">
                            {{ 'Anmelden'|trans }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}