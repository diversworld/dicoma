{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <section class="about section">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}

                        {% if app.user %}
                            <div class="mb-3">
                                Du bist angemeldet als {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Abmelden</a>
                            </div>
                        {% endif %}

                        <h1 class="h3 mb-3 font-weight-normal">Bitte melde Dich an</h1>

                        <label for="inputUsername">Benutzername</label>
                        <input type="text" value="{{ last_username }}" name="_username" id="inputUsername" class="form-control" autocomplete="username" required autofocus>

                        <label for="inputPassword">Passwort</label>
                        <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required>

                        <input type="hidden" name="_csrf_token"
                               value="{{ csrf_token('authenticate') }}"
                        >

                        <button class="btn btn-lg btn-primary" type="submit">
                            Anmelden
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}