<form class="form-inline" method="post" action="{{ path('app_booking_delete', {'id': booking.id}) }}" onsubmit="return confirm('Möchtest Du diese Buchung wirklich löschen?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ booking.id) }}">
    <button class="btn btn-transparent btn-solid-border"><i class="ion-trash-a"></i> Löschen</button>
</form>
