{% extends 'admin/membership/layout.html.twig' %}
{% block title %}Aufnahmeverfahren{% endblock %}
{% block membership_body %}
{% set statuses = {pending: 'Prüfung offen', ready: 'Zur Aufnahme bereit', approved: 'Aufgenommen', rejected: 'Abgelehnt'} %}
<dl><dt>Name</dt><dd>{{ application.firstname }} {{ application.lastname }}</dd><dt>Geburtsdatum</dt><dd>{{ application.birthday|date('d.m.Y') }}</dd><dt>Kontakt</dt><dd>{{ application.email }}</dd><dt>Anschrift</dt><dd>{{ application.street }}, {{ application.postalCode }} {{ application.city }}</dd><dt>Status</dt><dd>{{ statuses[application.status]|default(application.status) }}</dd></dl>
<section class="card mb-3">
    <div class="card-body">
        <h2 class="h5">Freigabequorum</h2>
        <p class="mb-2">{{ approvals|length }} von {{ requiredApprovals }} erforderlichen Bestätigungen.</p>
        <div class="progress" role="progressbar" aria-label="Aufnahmebestätigungen" aria-valuemin="0" aria-valuemax="{{ requiredApprovals }}" aria-valuenow="{{ min(approvals|length, requiredApprovals) }}">
            <div class="progress-bar" style="--dw-progress: {{ min(100, (approvals|length / requiredApprovals) * 100) }}%"></div>
        </div>
        <ul class="mb-0 mt-3">
        {% for approval in approvals %}
            <li>{{ approval.approvedAt|date('d.m.Y H:i') }} · {{ approval.reviewerName }} · {{ approval.note }}</li>
        {% else %}
            <li>Noch keine Freigabe bestätigt.</li>
        {% endfor %}
        </ul>
    </div>
</section>
{% if requiredDocuments is not empty %}
<div class="alert alert-secondary">
    <strong>Vor Freigabe zu prüfende Unterlagen:</strong>
    <ul class="mb-0">
    {% for kind, label in requiredDocuments %}
        <li>{{ label }}</li>
    {% endfor %}
    </ul>
</div>
{% endif %}
{% if application.status == 'pending' %}
<p>Jede berechtigte Person prüft selbstständig Identität und Unterlagen und dokumentiert dies. Eine Person zählt nur einmal. Mit der letzten erforderlichen Bestätigung werden die konfigurierten Onboarding-Schritte in einem Vorgang ausgeführt.</p>
{% if canReviewApplication %}
{{ form_start(form) }}{{ form_widget(form) }}<button type="submit" class="btn btn-primary">{{ approvals|length + 1 >= requiredApprovals ? 'Freigeben und Onboarding ausführen' : 'Freigabe bestätigen' }}</button>{{ form_end(form) }}
{% else %}
<div class="alert alert-warning">Ihr Konto gehört nicht zur konfigurierten Freigabegruppe. Der Antrag kann eingesehen, aber nicht bestätigt werden.</div>
{% endif %}
{% else %}<p>{{ application.decidedAt|date('d.m.Y H:i') }} · {{ application.decidedBy }} · {{ application.decisionNote }}</p>{% endif %}
{% endblock %}
