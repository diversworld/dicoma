{% extends 'competition/layout.html.twig' %}
{% block competition_title %}{{ 'Turniere und Historie'|trans }}{% endblock %}
{% block competition_body %}
<p class="text-muted">{{ 'Eigene Turniere, offene Ausschreibungen und Turniere der betreuten Mannschaften.'|trans }}</p>
{% if canCreate %}<p><a class="btn btn-primary" href="{{ path('competition_tournament_new') }}">{{ 'Turnier anlegen'|trans }}</a></p>{% endif %}
<div class="table-responsive"><table class="table"><thead><tr><th>{{ 'Turnier'|trans }}</th><th>{{ 'Sportkennung'|trans }}</th><th>{{ 'Beginn'|trans }}</th><th>{{ 'Ort'|trans }}</th><th>{{ 'Status'|trans }}</th></tr></thead><tbody>
{% for tournament in tournaments %}<tr><td><a href="{{ path('competition_tournament', {id: tournament.id}) }}">{{ tournament.name }}</a></td><td>{{ tournament.sportCode }}</td><td>{{ tournament.startsAt|date('d.m.Y H:i') }}</td><td>{{ tournament.location }}</td><td>{{ tournament.status.label()|trans }}</td></tr>
{% else %}<tr><td colspan="5">{{ 'Keine sichtbaren Turniere vorhanden.'|trans }}</td></tr>{% endfor %}
</tbody></table></div>
{% endblock %}
