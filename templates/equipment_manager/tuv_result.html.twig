{% extends 'equipment_manager/layout.html.twig' %}
{% block title %}{{ 'Prüfergebnis erfassen'|trans }}{% endblock %}
{% block body %}<section class="section"><div class="container py-4 dw-max-width-760px" >
<a href="{{ path('equipment_manager_tuv') }}">← {{ 'Zur TÜV-Übersicht'|trans }}</a><h1 class="h3 mt-3">{{ 'Prüfergebnis erfassen'|trans }}</h1>
<p class="text-muted">{{ 'Anmeldung'|trans }} #{{ booking.id }} · {{ (booking.clubTank ? 'Vereinsflasche' : 'Mitgliederflasche')|trans }}</p>
<div class="alert alert-warning">{{ 'Nur bei bestandener Prüfung wird die nächste Prüffrist um 30 Monate fortgeschrieben.'|trans }}</div>
{% if existing %}
<div class="alert alert-success">{{ 'Prüfergebnis bereits erfasst'|trans }}: <strong>{{ (existing.result == 'passed' ? 'Bestanden' : 'Nicht bestanden')|trans }}</strong> ({{ existing.inspectedAt|date('d.m.Y') }}).</div>
{% else %}
<form method="post" class="card card-body shadow-sm" onsubmit="return confirm({{ 'Ergebnis verbindlich speichern und Anmeldung abschließen?'|trans|json_encode|e('html_attr') }})">
<input type="hidden" name="_token" value="{{ csrf_token('tuv_result_' ~ booking.id) }}">
<fieldset class="mb-3"><legend class="h6">{{ 'Prüfergebnis'|trans }} *</legend>
<div class="form-check"><input required class="form-check-input" type="radio" name="result" id="passed" value="passed"><label class="form-check-label" for="passed">{{ 'Bestanden'|trans }}</label></div>
<div class="form-check"><input required class="form-check-input" type="radio" name="result" id="failed" value="failed"><label class="form-check-label" for="failed">{{ 'Nicht bestanden'|trans }}</label></div></fieldset>
<div class="mb-3"><label class="form-label" for="date">{{ 'Prüfdatum'|trans }} *</label><input class="form-control" type="date" name="date" id="date" value="{{ 'now'|date('Y-m-d') }}" max="{{ 'now'|date('Y-m-d') }}" required></div>
<div class="mb-3"><label class="form-label" for="notes">{{ 'Bemerkung (optional)'|trans }}</label><textarea class="form-control" name="notes" id="notes" maxlength="2000" rows="3"></textarea></div>
<div class="d-flex gap-2"><button class="btn btn-primary">{{ 'Ergebnis speichern und abschließen'|trans }}</button><a class="btn btn-outline-secondary" href="{{ path('equipment_manager_tuv') }}">{{ 'Abbrechen'|trans }}</a></div></form>{% endif %}</div></section>{% endblock %}
