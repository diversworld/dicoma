{% extends 'equipment_manager/layout.html.twig' %}
{% block title %}{{ 'TÜV-Termin planen'|trans }}{% endblock %}
{% block body %}<section class="section"><div class="container py-4 dw-max-width-760px" >
<a href="{{ path('equipment_manager_tuv') }}">← {{ 'Zur TÜV-Übersicht'|trans }}</a><h1 class="h3 mt-3">{{ 'TÜV-Termin planen'|trans }}</h1>
<div class="alert alert-info">{{ 'Der Termin wird als Entwurf angelegt. Da Termine vereinsübergreifend sichtbar sind, erfolgt die Veröffentlichung durch die Administration.'|trans }}</div>
<form method="post" class="card card-body shadow-sm">
<input type="hidden" name="_token" value="{{ csrf_token('tuv_plan_' ~ equipment_manager_club().id) }}">
<div class="mb-3"><label for="date" class="form-label">{{ 'Prüftermin'|trans }} *</label><input required class="form-control" type="date" name="date" id="date" min="{{ 'now'|date('Y-m-d') }}"></div>
<div class="mb-3"><label for="deadline" class="form-label">{{ 'Anmeldeschluss'|trans }}</label><input class="form-control" type="date" name="deadline" id="deadline"></div>
<div class="mb-3"><label for="vendor" class="form-label">{{ 'Prüfstelle (optional)'|trans }}</label><input class="form-control" maxlength="150" name="vendor" id="vendor"></div>
<div class="d-flex gap-2"><button class="btn btn-primary">{{ 'Entwurf anlegen'|trans }}</button><a class="btn btn-outline-secondary" href="{{ path('equipment_manager_tuv') }}">{{ 'Abbrechen'|trans }}</a></div></form></div></section>{% endblock %}
