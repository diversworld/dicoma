{% extends 'equipment_manager/layout.html.twig' %}
{% block title %}{{ 'Inventarakte'|trans }} | DICOMA{% endblock %}
{% block body %}
<main class="container py-4">
    <a href="{{ path('equipment_manager_inventory', {type:type}) }}">{{ 'Zurück zum Inventar'|trans }}</a>
    <h1>{{ 'Inventarakte'|trans }}: {{ asset }}</h1>
    {% for category in ['success', 'danger'] %}{% for message in app.flashes(category) %}<div class="alert alert-{{ category }}">{{ message|trans }}</div>{% endfor %}{% endfor %}
    <p>{{ 'Zustand'|trans }}: <strong>{{ ({'ready':'Einsatzbereit','maintenance':'Wartung erforderlich','damaged':'Beschädigt','retired':'Ausgemustert'}[asset.conditionStatus] ?? asset.conditionStatus)|trans }}</strong> · {{ 'Verleihfreigabe'|trans }}: {{ (asset.lendable ? 'Ja' : 'Nein')|trans }} · {{ 'Nächste Prüfung'|trans }}: {{ due ? due|date('d.m.Y') : 'Nicht hinterlegt'|trans }}</p>
    {% if type == 'tank' %}<p><a href="{{ path('equipment_manager_tank_detail', {id:asset.id}) }}">{{ 'Flaschenprüfungen, TÜV und bisherige Flaschenhistorie'|trans }}</a></p>{% endif %}
    <section class="card card-body mb-3">
        <h2>{{ 'Stammdaten und Prüfplanung'|trans }}</h2>
        {{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-primary">{{ 'Inventarakte speichern'|trans }}</button>{{ form_end(form) }}
    </section>
    <section class="card card-body mb-3">
        <h2>{{ 'Wartung, Reparatur und Defektmeldung'|trans }}</h2>
        <form method="post" action="{{ path('equipment_manager_inventory_maintenance', {type:type, id:asset.id}) }}" class="mb-3">
            <input type="hidden" name="_token" value="{{ csrf_token('inventory_maintenance_' ~ type ~ '_' ~ asset.id) }}">
            <input type="hidden" name="operation" value="inspect">
            <label>{{ 'Prüfung / Revision durchgeführt am'|trans }} <input type="date" name="performed" max="{{ 'now'|date('Y-m-d') }}" required></label>
            <label>{{ 'Nächste Fälligkeit'|trans }} <input type="date" name="next"> ({{ 'leer = eingetragenes Prüfintervall'|trans }})</label>
            <label>{{ 'Prüfer und Nachweis'|trans }} <input name="reference" minlength="10" maxlength="2000" required></label>
            <button class="btn btn-outline-primary">{{ 'Prüfnachweis dokumentieren (keine automatische Freigabe)'|trans }}</button>
        </form>
        <form method="post" action="{{ path('equipment_manager_inventory_maintenance', {type:type, id:asset.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('inventory_maintenance_' ~ type ~ '_' ~ asset.id) }}">
            <input type="hidden" name="operation" value="open">
            <label>{{ 'Auftragsart'|trans }} <select name="kind" required><option value="maintenance">{{ 'Wartung'|trans }}</option><option value="repair">{{ 'Reparatur'|trans }}</option><option value="defect">{{ 'Defekt / Schaden'|trans }}</option></select></label>
            <label>{{ 'Verantwortlich'|trans }} <input name="responsible" maxlength="180" required></label>
            <label>{{ 'Beschreibung'|trans }} <textarea name="description" minlength="10" maxlength="2000" required></textarea></label>
            <button class="btn btn-warning">{{ 'Auftrag eröffnen und technisch sperren'|trans }}</button>
        </form>
        {% for order in orders %}
            <article class="border-top mt-3 pt-3">
                <h3>{{ 'Auftrag'|trans }} #{{ order.id }} · {{ ({'maintenance':'Wartung','repair':'Reparatur','defect':'Defekt / Schaden'}[order.kind] ?? order.kind)|trans }} · {{ ({'open':'Offen','closed':'Abgeschlossen'}[order.status] ?? order.status)|trans }}</h3>
                <p>{{ order.createdAt|date('d.m.Y H:i') }} · {{ 'Verantwortlich'|trans }}: {{ order.responsible ?: 'Gerätewart'|trans }} · {{ 'Erfasst von'|trans }}: {{ order.openedBy ?: 'Altbestand'|trans }}</p>
                <p>{{ order.description }}</p>
                {% if order.status == 'open' %}
                    <form method="post" action="{{ path('equipment_manager_inventory_maintenance', {type:type, id:asset.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('inventory_maintenance_' ~ type ~ '_' ~ asset.id) }}">
                        <input type="hidden" name="operation" value="close"><input type="hidden" name="order_id" value="{{ order.id }}">
                        <label>{{ 'Abschlussbericht'|trans }} <textarea name="resolution" minlength="10" maxlength="2000" required></textarea></label>
                        <button class="btn btn-outline-primary">{{ 'Auftrag abschließen (bleibt gesperrt)'|trans }}</button>
                    </form>
                {% else %}<p>{{ order.resolution }} · {{ order.closedBy }} · {{ order.closedAt|date('d.m.Y H:i') }}</p>{% endif %}
            </article>
        {% endfor %}
        {% if not asset.lendable or asset.conditionStatus != 'ready' %}
            <form class="mt-3" method="post" action="{{ path('equipment_manager_inventory_maintenance', {type:type, id:asset.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('inventory_maintenance_' ~ type ~ '_' ~ asset.id) }}"><input type="hidden" name="operation" value="release">
                <label>{{ 'Freigabebericht'|trans }} <textarea name="reason" minlength="10" maxlength="2000" required></textarea></label>
                <button class="btn btn-success">{{ 'Nach technischer Prüfung freigeben'|trans }}</button>
            </form>
        {% endif %}
    </section>
    <section class="card card-body mb-3"><h2>{{ 'Dokumente'|trans }}</h2>
        <form method="post" enctype="multipart/form-data" action="{{ path('equipment_manager_inventory_document_upload', {type:type, id:asset.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('inventory_document_' ~ type ~ '_' ~ asset.id) }}">
            <label>{{ 'Nachweis (PDF, JPG, PNG; maximal 5 MB)'|trans }} <input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png" required></label>
            <button class="btn btn-primary">{{ 'Dokument ablegen'|trans }}</button>
        </form>
        <ul>{% for document in documents %}<li><a href="{{ path('equipment_manager_inventory_document', {id:document.id}) }}">{{ document.originalName }}</a> · {{ document.uploadedBy }} · {{ document.uploadedAt|date('d.m.Y') }}</li>{% endfor %}</ul>
    </section>
    <section><h2>{{ 'Gerätehistorie'|trans }}</h2>
        <ul>{% for event in record.history|reverse %}<li>{{ event.at|date('d.m.Y H:i') }} · {{ event.actor }} · {{ ({'inventory_updated':'Inventar aktualisiert','maintenance_opened':'Wartungsauftrag eröffnet','maintenance_closed':'Wartungsauftrag abgeschlossen','inspection_recorded':'Prüfung dokumentiert','manual_release':'Manuell freigegeben','document_uploaded':'Dokument abgelegt','issued':'Ausgegeben','returned':'Zurückgegeben'}[event.event] ?? event.event)|trans }}: {{ event.event == 'inventory_updated' and event.description == 'Stammdaten, Lagerort oder Prüfplanung aktualisiert.' ? event.description|trans : event.description }}</li>{% else %}<li>{{ 'Noch keine Einträge in der gemeinsamen Geräteakte.'|trans }}</li>{% endfor %}</ul>
    </section>
</main>
{% endblock %}
