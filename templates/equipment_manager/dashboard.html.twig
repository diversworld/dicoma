{% extends 'base.html.twig' %}
{% block title %}Gerätewart – Übersicht | DICOMA{% endblock %}
{% block hero %}{% endblock %}
{% block body %}
<section class="section"><div class="container">
    <h1>Gerätewart – Übersicht</h1>
    <p class="text-muted">{{ clubName }} · Kennzahlen ausschließlich für den eigenen Verein</p>
    <div class="row mb-4">
        {% set cards = [
            {label: 'Flaschen gesamt', value: total, filter: 'all'},
            {label: 'Freigegeben', value: ready, filter: 'ready'},
            {label: 'Gesperrt', value: blocked, filter: 'blocked'},
            {label: 'Beschädigt', value: damaged, filter: 'damaged'},
            {label: 'Offene Wartungsaufträge', value: openOrders, filter: 'open'}
        ] %}
        {% for card in cards %}
            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card h-100"><div class="card-body">
                    <h2 class="h6">{{ card.label }}</h2>
                    <p class="h2 mb-2">{{ card.value }}</p>
                    <a href="{{ path('equipment_manager_tanks', {filter: card.filter}) }}">Flaschen anzeigen</a>
                </div></div>
            </div>
        {% endfor %}
    </div>
    <h2>Flaschenprüfungen</h2>
    <p><strong>{{ expired }}</strong> überfällig · <strong>{{ dueSoon }}</strong> innerhalb der nächsten 30 Tage fällig · <strong>{{ missingDate }}</strong> ohne hinterlegten Termin</p>
    <p class="text-muted">Die Prüftermine sind eine Übersicht, keine automatische Freigabeentscheidung.</p>
    <h3 class="h5">Überfällige und bald fällige Prüfungen (maximal 10)</h3>
    <div class="table-responsive"><table class="table table-striped table-bordered">
        <thead><tr><th scope="col">Inventar</th><th scope="col">Nächste Prüfung</th><th scope="col">Status</th><th scope="col">Aktion</th></tr></thead>
        <tbody>
        {% for tank in upcoming %}
            <tr>
                <td>{{ tank.inventory }}</td>
                <td>{{ tank.nextCheckDate|date('d.m.Y') }}</td>
                <td>{% if tank.nextCheckDate < today %}Überfällig{% else %}Innerhalb von 30 Tagen{% endif %}</td>
                <td><a href="{{ path('equipment_manager_tank_detail', {id: tank.id}) }}">Details</a></td>
            </tr>
        {% else %}
            <tr><td colspan="4">Keine überfälligen oder bald fälligen Prüfungen.</td></tr>
        {% endfor %}
        </tbody>
    </table></div>
    <p><a class="btn btn-primary" href="{{ path('equipment_manager_tanks') }}">Zur Flaschenübersicht</a></p>
</div></section>
{% endblock %}
