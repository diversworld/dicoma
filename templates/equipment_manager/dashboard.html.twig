{% extends 'equipment_manager/layout.html.twig' %}
{% block title %}{{ 'Gerätewart – Übersicht'|trans }} | DICOMA{% endblock %}
{% block hero %}{% endblock %}
{% block body %}
<section class="section"><div class="container">
    <h1>{{ 'Gerätewart – Übersicht'|trans }}</h1>
    <p class="text-muted">{{ clubName }} · {{ 'Kennzahlen ausschließlich für den eigenen Verein'|trans }}</p>
    <div class="row mb-4">
        {% set cards = [
            {label: 'Flaschen gesamt', value: total, filter: 'all'},
            {label: 'Freigegeben', value: ready, filter: 'ready'},
            {label: 'Gesperrt', value: blocked, filter: 'blocked'},
            {label: 'Beschädigt', value: damaged, filter: 'damaged'},
            {label: 'Offene Wartungsaufträge', value: openOrders, filter: 'open'}
        ] %}
        {% for card in cards %}
            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card h-100"><div class="card-body">
                    <h2 class="h6">{{ card.label|trans }}</h2>
                    <p class="h2 mb-2">{{ card.value }}</p>
                    <a href="{{ path('equipment_manager_tanks', {filter: card.filter}) }}">{{ 'Flaschen anzeigen'|trans }}</a>
                </div></div>
            </div>
        {% endfor %}
    </div>
    <div class="card border-primary shadow-sm mb-4">
      <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div><h2 class="h5 mb-1">{{ 'TÜV-Termine und Prüfungsabwicklung'|trans }}</h2>
        <p class="text-muted mb-0">{{ 'Vereins- und Mitgliederflaschen anmelden, Prüfungen begleiten und Rückgaben bestätigen.'|trans }}</p></div>
        <div class="d-flex gap-2 flex-wrap">
          <a class="btn btn-primary" href="{{ path('equipment_manager_tuv') }}">{{ 'TÜV-Übersicht öffnen'|trans }}</a>
          <a class="btn btn-outline-primary" href="{{ path('equipment_manager_tuv_plan') }}">{{ 'Termin planen'|trans }}</a>
        </div>
      </div>
    </div>
    <div class="card border-primary shadow-sm mb-4"><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div><h2 class="h5 mb-1">{{ 'Ausrüstungsausleihe'|trans }}</h2><p class="text-muted mb-0">{{ 'Reservierungen prüfen, einzelne Gegenstände ausgeben und Rücknahmen dokumentieren.'|trans }}</p></div>
      <a class="btn btn-primary" href="{{ path('equipment_manager_loans') }}">{{ 'Ausleihe und Rücknahme öffnen'|trans }}</a>
    </div></div>
    {% if is_granted('ROLE_EQUIPMENT_CASH') %}
    <div class="card border-primary shadow-sm mb-4"><div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div><h2 class="h5 mb-1">{{ 'Kasse: TÜV und Ausrüstungsverleih'|trans }}</h2><p class="text-muted mb-0">{{ 'Geldannahmen bei Abgabe und Abholung dokumentieren; beide Einnahmearten im Journal prüfen.'|trans }}</p></div>
      <a class="btn btn-primary" href="{{ path('equipment_manager_cashbook') }}">{{ 'Gerätewart-Kasse öffnen'|trans }}</a>
    </div></div>
    {% endif %}
    <h2>{{ 'Flaschenprüfungen'|trans }}</h2>
    <p><strong>{{ expired }}</strong> {{ 'überfällig'|trans }} · <strong>{{ dueSoon }}</strong> {{ 'innerhalb der nächsten 30 Tage fällig'|trans }} · <strong>{{ missingDate }}</strong> {{ 'ohne hinterlegten Termin'|trans }}</p>
    <p class="text-muted">{{ 'Die Prüftermine sind eine Übersicht, keine automatische Freigabeentscheidung.'|trans }}</p>
    <h3 class="h5">{{ 'Überfällige und bald fällige Prüfungen (maximal 10)'|trans }}</h3>
    <div class="table-responsive"><table class="table table-striped table-bordered">
        <thead><tr><th scope="col">{{ 'Inventar'|trans }}</th><th scope="col">{{ 'Nächste Prüfung'|trans }}</th><th scope="col">{{ 'Status'|trans }}</th><th scope="col">{{ 'Aktion'|trans }}</th></tr></thead>
        <tbody>
        {% for tank in upcoming %}
            <tr>
                <td>{{ tank.inventory }}</td>
                <td>{{ tank.nextCheckDate|date('d.m.Y') }}</td>
                <td>{% if tank.nextCheckDate < today %}{{ 'Überfällig'|trans }}{% else %}{{ 'Innerhalb von 30 Tagen'|trans }}{% endif %}</td>
                <td><a href="{{ path('equipment_manager_tank_detail', {id: tank.id}) }}">{{ 'Details'|trans }}</a></td>
            </tr>
        {% else %}
            <tr><td colspan="4">{{ 'Keine überfälligen oder bald fälligen Prüfungen.'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table></div>
    <p><a class="btn btn-primary" href="{{ path('equipment_manager_tanks') }}">{{ 'Zur Flaschenübersicht'|trans }}</a></p>
</div></section>
{% endblock %}
