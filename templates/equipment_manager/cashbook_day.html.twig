{% extends 'equipment_manager/layout.html.twig' %}
{% import 'equipment_manager/_cash_labels.html.twig' as cash %}
{% block title %}{{ 'Tagesauswertung'|trans }} · {{ 'Gerätewart-Kasse'|trans }}{% endblock %}
{% block body %}
<main class="container py-4 dw-max-width-1100px" >
<a href="{{ path('equipment_manager_cashbook') }}">← {{ 'Zur Gerätewart-Kasse'|trans }}</a>
<h1 class="h2 mt-3">{{ 'Tagesauswertung der Kassenbewegungen'|trans }}</h1>
<p>{{ 'Übersicht der erfassten Einnahmen und Barauszahlungen eines Kalendertags. Überweisungen zählen nicht zum Bargeld.'|trans }}</p>
<form method="get" action="{{ path('equipment_manager_cashbook_day') }}" class="d-flex flex-wrap gap-2 align-items-end mb-4">
<div><label for="cash-date" class="form-label">{{ 'Datum'|trans }}</label><input id="cash-date" type="date" class="form-control" name="date" value="{{ date }}" required></div>
<button class="btn btn-primary" type="submit">{{ 'Anzeigen'|trans }}</button>
<a class="btn btn-outline-secondary" href="{{ path('equipment_manager_cashbook_day_csv', {date: date}) }}">{{ 'CSV herunterladen'|trans }}</a>
</form>
<div class="row g-3 mb-4">
<div class="col-md-4"><div class="card card-body"><strong>{{ 'Bar eingenommen'|trans }}</strong><span class="h4">{{ (summary.cash / 100)|number_format(2, ',', '.') }} €</span></div></div>
<div class="col-md-4"><div class="card card-body"><strong>{{ 'Überweisungen'|trans }}</strong><span class="h4">{{ (summary.bank / 100)|number_format(2, ',', '.') }} €</span></div></div>
<div class="col-md-4"><div class="card card-body"><strong>{{ 'Gesamt'|trans }}</strong><span class="h4">{{ ((summary.cash + summary.bank) / 100)|number_format(2, ',', '.') }} €</span></div></div>
</div>
<p><strong>{{ 'Bar-Auszahlungen'|trans }}:</strong> {{ ((summary.payout + summary.correction_out) / 100)|number_format(2, ',', '.') }} € · <strong>{{ 'Netto-Barbewegung'|trans }}:</strong> {{ ((summary.cash + summary.correction_in - summary.payout - summary.correction_out) / 100)|number_format(2, ',', '.') }} €</p>
<p><strong>{{ 'TÜV'|trans }}:</strong> {{ (summary.tuv / 100)|number_format(2, ',', '.') }} € · <strong>{{ 'Ausleihe'|trans }}:</strong> {{ (summary.rental / 100)|number_format(2, ',', '.') }} € · <strong>{{ 'Füllungen'|trans }}:</strong> {{ (summary.fill / 100)|number_format(2, ',', '.') }} €</p>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>{{ 'Zeit'|trans }}</th><th>{{ 'Bereich'|trans }}</th><th>{{ 'Buchung'|trans }}</th><th>{{ 'Zahlungsart'|trans }}</th><th>{{ 'Betrag'|trans }}</th><th>{{ 'Kassiert von'|trans }}</th><th>{{ 'Beleg'|trans }}</th></tr></thead><tbody>
{% for row in rows %}
{% if row.type == 'correction' %}<tr><td>{{ row.receipt.created_at|date('d.m.Y H:i') }}</td><td>{{ 'Korrektur'|trans }} {{ cash.source(row.receipt.source_type) }} #{{ row.receipt.source_id }}</td><td>{{ row.receipt.reason }}</td><td>{{ 'Bar'|trans }}</td><td>{{ row.receipt.direction == 'in' ? '+' : '−' }}{{ (row.receipt.amount_cents / 100)|number_format(2, ',', '.') }} €</td><td>{{ row.receipt.created_by }}</td><td>correction-{{ row.receipt.id }}</td></tr>
{% else %}
<tr><td>{{ (row.type == 'payout' ? row.receipt.paidAt : row.receipt.collectedAt)|date('H:i:s') }}</td><td>{{ cash.source(row.type) }}</td><td>{% if row.type == 'payout' %}{{ row.receipt.recipient }}{% elseif row.type == 'fill' %}{{ cash.fill(row.receipt) }}{% else %}#{{ row.receipt.booking.id }}{% endif %}</td><td>{{ (row.type == 'payout' ? 'Bar ausgezahlt' : (row.receipt.method == 'cash' ? 'Bar' : 'Überweisung'))|trans }}</td><td>{{ row.type == 'payout' ? '−' : '' }}{{ (row.receipt.amountCents / 100)|number_format(2, ',', '.') }} €</td><td>{{ row.type == 'payout' ? row.receipt.paidBy : row.receipt.collectedBy }}</td><td>{{ row.type }}-{{ row.receipt.id }}</td></tr>
{% endif %}{% else %}<tr><td colspan="7">{{ 'Keine Geldannahmen für diesen Tag gespeichert.'|trans }}</td></tr>{% endfor %}
</tbody></table></div>
<p class="text-muted small">{{ 'Diese Tagesauswertung ist kein abgeschlossener Kassensturz: Der Kassensturz und der gezählte Ist-Bestand sind im Tagesabschluss dokumentiert. Die Summen beruhen auf dem gespeicherten Zahlungszeitpunkt.'|trans }}</p>
</main>
{% endblock %}
