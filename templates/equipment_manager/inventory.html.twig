{% extends 'equipment_manager/layout.html.twig' %}
{% block title %}{{ 'Inventar'|trans }} | DICOMA{% endblock %}
{% block body %}
<main class="container py-4">
    <h1>{{ 'Inventar und Gerätewart'|trans }}</h1>
    <nav aria-label="{{ 'Inventarbereiche'|trans }}">
        {% for key, label in {'equipment':'Ausrüstung', 'regulator':'Atemregler', 'tank':'Tauchflaschen'} %}
            <a class="btn btn-outline-primary" href="{{ path('equipment_manager_inventory', {type:key}) }}">{{ label|trans }}</a>
        {% endfor %}
    </nav>
    <p>{{ 'Inventarakte mit Eigentum, Lagerort, Prüfplanung, Wartung, Defekten und Dokumenten. %count% Gegenstände in diesem Bereich.'|trans({'%count%': total}) }}</p>
    <div class="table-responsive"><table class="table">
        <thead><tr><th>{{ 'Inventar'|trans }}</th><th>{{ 'Bezeichnung'|trans }}</th><th>{{ 'Seriennummer'|trans }}</th><th>{{ 'Kategorie'|trans }}</th><th>{{ 'Zustand'|trans }}</th><th>{{ 'Freigabe'|trans }}</th></tr></thead>
        <tbody>{% for asset in assets %}
            <tr>
                <td><a href="{{ path('equipment_manager_inventory_detail', {type:type, id:asset.id}) }}">{{ type == 'tank' ? asset.inventory : asset.inventoryNumber }}</a></td>
                <td>{{ type == 'equipment' ? asset.name : asset }}</td>
                <td>{{ type == 'regulator' ? asset.firstStageSerial : asset.serialNumber }}</td>
                <td>{{ type == 'equipment' ? asset.category : (type == 'tank' ? 'Tauchflasche'|trans : 'Atemregler'|trans) }}</td>
                <td>{{ ({'ready': 'Einsatzbereit', 'maintenance': 'Wartung', 'damaged': 'Beschädigt'}[asset.conditionStatus] ?? asset.conditionStatus)|trans }}</td><td>{{ (asset.lendable ? 'Ja' : 'Nein')|trans }}</td>
            </tr>
        {% else %}<tr><td colspan="6">{{ 'Keine Gegenstände vorhanden.'|trans }}</td></tr>{% endfor %}</tbody>
    </table></div>
    {% if page > 1 %}<a href="{{ path('equipment_manager_inventory', {type:type, page:page - 1}) }}">{{ 'Zurück'|trans }}</a>{% endif %}
    {% if page * 50 < total %}<a href="{{ path('equipment_manager_inventory', {type:type, page:page + 1}) }}">{{ 'Weiter'|trans }}</a>{% endif %}
</main>
{% endblock %}
