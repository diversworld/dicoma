{% extends 'equipment_manager/layout.html.twig' %}
{% block title %}{{ 'Flasche'|trans }} {{ tank.inventory }} – {{ 'Gerätewart'|trans }} | DICOMA{% endblock %}

{% block body %}
<section class="section"><div class="container">
  <p><a href="{{ path('equipment_manager_tanks') }}">← {{ 'Zur Flaschenübersicht'|trans }}</a></p>
  <h1>{{ 'Flasche'|trans }} {{ tank.inventory }}</h1>
  <p class="text-muted">{{ clubName }} · {{ 'Seriennummer'|trans }}: {{ tank.serialnumber }}</p>
  {% for type, messages in app.flashes %}{% for message in messages %}
    <div class="alert alert-{{ type == 'danger' ? 'danger' : 'success' }}" role="alert">{{ message|trans }}</div>
  {% endfor %}{% endfor %}
  <div class="table-responsive"><table class="table table-bordered"><tbody>
    <tr><th scope="row">{{ 'Technischer Zustand'|trans }}</th><td>{{ ({'ready': 'Einsatzbereit', 'maintenance': 'Wartung', 'damaged': 'Beschädigt', 'retired': 'Ausgemustert'}[tank.conditionStatus] ?? tank.conditionStatus)|trans }}</td></tr>
    <tr><th scope="row">{{ 'Verleih'|trans }}</th><td>{{ (tank.lendable ? 'Freigegeben' : 'Gesperrt')|trans }}</td></tr>
    <tr>
		<th scope="row">{{ 'Nächste Prüfung'|trans }}
			<p>
			  <a class="btn btn-outline-primary"
				 href="{{ path('equipment_manager_tank_inspection', {id: tank.id}) }}">
				{{ 'Prüfung dokumentieren'|trans }}
			  </a>
			</p>
		</th><td>{{ tank.nextCheckDate ? tank.nextCheckDate|date('d.m.Y') : 'Nicht hinterlegt'|trans }}</td>
	</tr>
    <tr>
		<th scope="row">{{ 'Letzte Prüfung'|trans }}
			<p>
				<a class="btn btn-outline-primary"
					href="{{ path('equipment_manager_tank_inspection', {id: tank.id}) }}">
					{{ 'Prüfung dokumentieren'|trans }}
				</a>
			</p>
		</th>
		<td>{{ tank.lastCheckDate ? tank.lastCheckDate|date('d.m.Y') : 'Nicht hinterlegt'|trans }}</td>
	</tr>
    <tr><th scope="row">{{ 'Größe'|trans }}</th><td>{{ tank.size is not null ? tank.size : '–' }}</td></tr>
    <tr><th scope="row">{{ 'Notizen'|trans }}</th><td>{{ tank.notes ?: '–' }}</td></tr>
  </tbody></table></div>
  <p><a class="btn btn-primary" href="{{ path('equipment_manager_maintenance', {id: tank.id}) }}">{{ 'Wartungsaufträge verwalten'|trans }}</a></p>
  <h2>{{ 'Technischen Zustand sperren'|trans }}</h2>
  <p>{{ 'Eine technische Sperrung verhindert die weitere Ausgabe dieser Flasche. Ein Wartungsauftrag wird dadurch nicht automatisch eröffnet.'|trans }}</p>
  <form method="post" action="{{ path('equipment_manager_tank_block', {id: tank.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('equipment_block_' ~ tank.id) }}">
    <div class="form-group">
      <label for="block_operation">{{ 'Sperrstatus'|trans }}</label>
      <select id="block_operation" name="operation" class="form-control" required>
        <option value="maintenance">{{ 'Wartung erforderlich'|trans }}</option>
        <option value="damaged">{{ 'Beschädigt'|trans }}</option>
      </select>
    </div>
    <div class="form-group">
      <label for="block_reason">{{ 'Begründung (10–2000 Zeichen)'|trans }}</label>
      <textarea id="block_reason" name="reason" class="form-control" rows="3" minlength="10" maxlength="2000" required></textarea>
    </div>
    <button type="submit" class="btn btn-warning">{{ 'Flasche technisch sperren'|trans }}</button>
  </form>
  <h2>{{ 'Kontrollierte Wiederfreigabe'|trans }}</h2>
  {% set hasOpenOrders = orders|filter(o => o.status == 'open')|length > 0 %}
  {% if tank.conditionStatus == 'ready' and tank.lendable %}
    <p class="alert alert-info">{{ 'Diese Flasche ist bereits freigegeben.'|trans }}</p>
  {% elseif hasOpenOrders %}
    <p class="alert alert-warning">{{ 'Eine Freigabe ist bei offenem Wartungsauftrag nicht möglich.'|trans }}</p>
  {% else %}
    <p>{{ 'Die Freigabe wird serverseitig auf offene Wartungsaufträge, aktive Ausleihen und eine gültige Flaschenprüfung geprüft.'|trans }}</p>
    <form method="post" action="{{ path('equipment_manager_tank_release', {id: tank.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('equipment_release_' ~ tank.id) }}">
      <div class="form-group">
        <label for="release_reason">{{ 'Begründung für die Freigabe (10–2000 Zeichen)'|trans }}</label>
        <textarea id="release_reason" name="reason" class="form-control" rows="3" minlength="10" maxlength="2000" required></textarea>
      </div>
      <button type="submit" class="btn btn-success">{{ 'Flasche kontrolliert freigeben'|trans }}</button>
    </form>
  {% endif %}
  <h2>{{ 'Wartungsaufträge (letzte 20)'|trans }}</h2>
  <div class="table-responsive"><table class="table table-striped"><thead><tr><th>{{ 'Nr.'|trans }}</th><th>{{ 'Eröffnet'|trans }}</th><th>{{ 'Status'|trans }}</th><th>{{ 'Beschreibung'|trans }}</th><th>{{ 'Abschluss'|trans }}</th></tr></thead><tbody>
  {% for order in orders %}<tr><td>{{ order.id }}</td><td>{{ order.createdAt|date('d.m.Y H:i') }}</td><td>{{ (order.status == 'open' ? 'Offen' : 'Abgeschlossen')|trans }}</td><td>{{ order.description }}</td><td>{{ order.closedAt ? order.closedAt|date('d.m.Y H:i') : '–' }}</td></tr>
  {% else %}<tr><td colspan="5">{{ 'Keine Wartungsaufträge.'|trans }}</td></tr>{% endfor %}
  </tbody></table></div>
  <h2>{{ 'Technische Statushistorie (letzte 100)'|trans }}</h2>
  <div class="table-responsive"><table class="table table-striped"><thead><tr><th>{{ 'Zeitpunkt'|trans }}</th><th>{{ 'Ereignis'|trans }}</th><th>{{ 'Zustand'|trans }}</th><th>{{ 'Verleih'|trans }}</th><th>{{ 'Bemerkung'|trans }}</th></tr></thead><tbody>
  {% set eventLabels = {'return': 'Rückgabe', 'returned': 'Rückgabe', 'manual_block': 'Manuelle Sperrung', 'manual_release': 'Manuelle Freigabe', 'maintenance_opened': 'Wartungsauftrag eröffnet', 'maintenance_closed': 'Wartungsauftrag abgeschlossen', 'inspection_recorded': 'Prüfung dokumentiert'} %}
  {% for entry in history %}<tr><td>{{ entry.occurredAt|date('d.m.Y H:i') }}</td><td>{{ (eventLabels[entry.eventType] ?? entry.eventType)|trans }}</td><td>{{ ({'ready': 'Einsatzbereit', 'maintenance': 'Wartung', 'damaged': 'Beschädigt', 'retired': 'Ausgemustert'}[entry.conditionStatus] ?? entry.conditionStatus)|trans }}</td><td>{{ (entry.lendable ? 'Freigegeben' : 'Gesperrt')|trans }}</td><td>{{ entry.notes ?: '–' }}</td></tr>
  {% else %}<tr><td colspan="5">{{ 'Keine Statuseinträge vorhanden.'|trans }}</td></tr>{% endfor %}
  </tbody></table></div>
  <p class="text-muted">{{ 'Jede erfolgreiche Wiederfreigabe wird in der technischen Statushistorie dokumentiert.'|trans }}</p>
</div></section>
{% endblock %}
