{% extends 'equipment_manager/layout.html.twig' %}
{% block title %}{{ 'Kompressor – Füllabende'|trans }} | DICOMA{% endblock %}
{% block body %}
<main class="container py-4 dw-max-width-1150px" >
	{% if is_granted('ROLE_EQUIPMENT_MANAGER') %}<a href="{{ path('equipment_manager_dashboard') }}">← {{ 'Gerätewartportal'|trans }}</a>{% else %}<a href="{{ path('app_portal', {'_locale': app.request.locale}) }}">← {{ 'Mein Bereich'|trans }}</a>{% endif %}
	<h1 class="h2 mt-3">{{ 'Kompressor – Füllabende und Viererfüllungen'|trans }}</h1>
	<p class="text-muted">{{ 'Anlagen- und Filterstatus einmal vor dem Füllabend prüfen. Jede Viererfüllung hat einen gemeinsamen Enddruck; die angeschlossenen Flaschen werden einzeln zugeordnet. Nur Atemluft.'|trans }}</p>
	{% for type in ['success','danger'] %}
		{% for msg in app.flashes(type) %}
			<div class="alert alert-{{ type == 'danger' ? 'danger' : 'success' }}">
				{{ msg|trans }}
			</div>
		{% endfor %}
	{% endfor %}
	{% if selected %}
		<section class="card card-body mb-3">
			<h2 class="h5">{{ 'Füllabend'|trans }} #{{ selected.id }} – {{ selected.compressor }}</h2>
			<p>{{ 'Beginn'|trans }}: {{ selected.openedAt|date('d.m.Y H:i') }} · {{ 'Betriebsstunden'|trans }}: {{ (selected.openingHoursTenths / 10)|number_format(1, ',', '.') }} · {{ 'Bediener'|trans }}: {{ selected.operator }} · {{ (selected.closedAt ? 'Abgeschlossen' : 'Offen')|trans }}</p>
			{% if selected.notes %}
				<p>{{ selected.notes }}</p>
			{% endif %}
			{% if not selected.closedAt %}
				<h3 class="h6" id="naechste-fuellung">{{ 'Nächste Viererfüllung dokumentieren'|trans }}</h3><p>{{ 'Beliebig viele Füllvorgänge pro Abend, maximal vier Flaschen gleichzeitig.'|trans }}</p>
				<form method="post" class="g-3" onsubmit="return confirm({{ 'Alle aufgeführten Flaschen wurden tatsächlich auf den angegebenen Druck gefüllt?'|trans|json_encode|e('html_attr') }})">
				<div class="row">
					<input type="hidden" name="action" value="batch">
					<input type="hidden" name="session_id" value="{{ selected.id }}">
					<input type="hidden" name="_token" value="{{ csrf_token('compressor_evening_batch_' ~ equipment_manager_club().id) }}">
					<div class="col-md-4">
						<label class="form-label">{{ 'Gemeinsamer Enddruck (bar)'|trans }}</label>
						<input class="form-control" type="number" name="pressure" value="210" min="1" max="350" required>
					</div>
				</div>
					<div class="row">
						{% for i in 1..4 %}
							<div class="col-md-3">
								<label class="form-label">{{ 'Flasche'|trans }} {{ i }}</label>
								<input class="form-control mb-1" name="cylinder_{{ i }}" maxlength="100" placeholder="{{ 'Kennung / Vereinsnummer'|trans }}">
								<label class="form-label small">{{ 'Flaschengröße (Liter)'|trans }}</label>
								<input class="form-control mb-1" type="number" name="volume_{{ i }}" min="0.1" max="100" step="0.1" placeholder="{{ 'z. B. 7, 10, 12, 15'|trans }}">
								<select class="form-select" name="tank_{{ i }}">
									<option value="">{{ 'Externe Flasche / Kennung oben'|trans }}</option>
									{% for tank in tanks %}
										<option value="{{ tank.id }}">{{ tank.inventory }} – {{ tank.serialnumber }}</option>
									{% endfor %}
								</select>
							</div>
						{% endfor %}
					</div>
					<div class="col-12">
						<label class="form-label">{{ 'Bemerkung'|trans }}</label>
						<textarea class="form-control" name="notes" maxlength="2000"></textarea>
					</div>
                    <div class="col-12"><label>{{ 'Vereinbarte Füllgebühr für diese Gruppe gesamt (EUR; 0 = kostenlos)'|trans }} <input name="fee" inputmode="decimal" required></label> {% if is_granted('ROLE_EQUIPMENT_MANAGER') and is_granted('ROLE_EQUIPMENT_CASH') %}<a href="{{ path('equipment_manager_fill_billing') }}">{{ 'Füllgebühren und Zahlungen'|trans }}</a>{% endif %}</div>
					<div class="col-12 form-check ms-2">
						<input class="form-check-input" type="checkbox" name="cylinder_check" value="1" id="cylinder_check" required>
						<label class="form-check-label" for="cylinder_check">{{ 'Kennzeichnung, Prüffrist, Zustand und zulässigen Fülldruck aller angeschlossenen Flaschen kontrolliert'|trans }}</label>
					</div>
					<div class="col-12">
						<button class="btn btn-primary">{{ 'Füllvorgang speichern und nächste Vierergruppe erfassen'|trans }}</button>
					</div>
				</form>
				<hr>
				<form method="post" onsubmit="return confirm({{ 'Füllabend abschließen?'|trans|json_encode|e('html_attr') }})">
					<input type="hidden" name="action" value="close">
					<input type="hidden" name="session_id" value="{{ selected.id }}">
					<input type="hidden" name="_token" value="{{ csrf_token('compressor_evening_close_' ~ equipment_manager_club().id) }}">
					<label>{{ 'Abschließende Betriebsstunden'|trans }} <input name="closing_hours" inputmode="decimal" required></label>
					<button class="btn btn-outline-secondary">{{ 'Füllabend abschließen'|trans }}</button>
				</form>
			{% endif %}
		</section>
		<section class="card card-body mb-4">
			<h2 class="h5">{{ 'Füllungen dieses Abends'|trans }}</h2>
			{% set total = 0 %}
			{% for batch in batches %}
				{% set total = total + items[batch.id]|length %}
			{% endfor %}
			<p><strong>{{ '%batches% Füllvorgänge, %total% Flaschen'|trans({'%batches%': batches|length, '%total%': total}) }}</strong></p>
			<table class="table table-sm">
				<thead>
					<tr>
						<th>{{ 'Zeit'|trans }}</th>
						<th>{{ 'Flaschen'|trans }}</th>
						<th>{{ 'Enddruck'|trans }}</th>
						<th>{{ 'Füller'|trans }}</th>
					</tr>
				</thead>
				<tbody>
					{% for batch in batches %}
						<tr>
							<td>{{ batch.filledAt|date('H:i') }}</td>
							<td>
							{% for cylinder in items[batch.id] %}
								{{ cylinder.volumeLiters is not null ? cylinder.volumeLiters ~ ' l – ' : 'Größe unbekannt'|trans ~ ' – ' }}{{ cylinder.identification }}
								{% if not loop.last %}, {% endif %}
							{% endfor %}</td>
							<td>{{ batch.endPressureBar }} bar</td>
							<td>{{ batch.recordedBy }}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4">{{ 'Noch keine Füllung.'|trans }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</section>
	{% endif %}
	<section class="card card-body mb-4"><h2 class="h5">{{ 'Neuen Füllabend eröffnen'|trans }}</h2>
		<p class="small text-muted">{{ 'Voraussetzung: gültiger Filterwechsel mit nächstem Fälligkeitsdatum im Wartungsbuch. Betriebsanleitung und betriebliche Prüfintervalle beachten.'|trans }}</p>
		<form method="post" class="row g-3" onsubmit="return confirm({{ 'Anlagenkontrolle abgeschlossen und Füllabend freigeben?'|trans|json_encode|e('html_attr') }})">
			<input type="hidden" name="action" value="open">
			<input type="hidden" name="_token" value="{{ csrf_token('compressor_evening_open_' ~ equipment_manager_club().id) }}">
			<div class="col-md-6">
				<label class="form-label">{{ 'Kompressor / Anlagenkennung'|trans }}</label>
				<input class="form-control" name="compressor" maxlength="100" required>
			</div>
			<div class="col-md-6">
				<label class="form-label">{{ 'Betriebsstunden'|trans }}</label>
				<input class="form-control" name="hours" placeholder="{{ 'z. B. 123,4'|trans }}" required>
			</div>
			<div class="col-12">
				<label class="form-label">{{ 'Anmerkungen'|trans }}</label>
				<textarea class="form-control" name="notes" maxlength="2000"></textarea>
			</div>
				{% for flag,label in {'system_check':'Anlage vor dem Füllabend geprüft','filter_check':'Filterstatus und Filterfrist geprüft','air_check':'Atemluftfreigabe anhand gültiger Nachweise geprüft'} %}			<div class="col-12 form-check ms-2">
					<input class="form-check-input" type="checkbox" name="{{ flag }}" value="1" id="{{ flag }}" required>
					<label class="form-check-label" for="{{ flag }}">{{ label|trans }}</label>
				</div>
			{% endfor %}
			<div class="col-12"><button class="btn btn-primary">{{ 'Füllabend eröffnen'|trans }}</button>
			</div>
		</form>
	</section>
	<section class="card card-body mb-4">
		<h2 class="h5">{{ 'Wartungs- und Prüfnachweis'|trans }}</h2>
		<p class="small text-muted">{{ 'Filterwechsel nur bei tatsächlicher Durchführung dokumentieren. Jährliches Intervall ist ein Vereinsrichtwert; Hersteller- und Betriebsstundenvorgaben gehen vor. Luftanalyse nur bei tatsächlicher Messung erfassen.'|trans }}</p>
		<form method="post" class="row g-2">
			<input type="hidden" name="action" value="maintenance">
			<input type="hidden" name="_token" value="{{ csrf_token('compressor_evening_maintenance_' ~ equipment_manager_club().id) }}">
			<div class="col-md-4">
				<label class="form-label">{{ 'Kompressor'|trans }}</label>
				<input class="form-control" name="compressor" required maxlength="100">
			</div>
			<div class="col-md-4">
				<label class="form-label">{{ 'Ereignis'|trans }}</label>
				<select class="form-select" name="kind">
					<option value="filter">{{ 'Filterwechsel'|trans }}</option>
					<option value="air_analysis">{{ 'Atemluftanalyse'|trans }}</option>
					<option value="inspection">{{ 'Prüfung / Wartung'|trans }}</option>
					<option value="repair">{{ 'Reparatur'|trans }}</option>
				</select>
			</div>
			<div class="col-md-4">
				<label class="form-label">{{ 'Durchgeführt am'|trans }}</label>
				<input class="form-control" type="date" name="performed" value="{{ 'now'|date('Y-m-d') }}" required>
			</div>
			<div class="col-md-4">
				<label class="form-label">{{ 'Nächste Fälligkeit'|trans }}</label>
				<input class="form-control" type="date" name="due">
			</div>
			<div class="col-md-8">
				<label class="form-label">{{ 'Nachweis / Bericht / Filterreferenz'|trans }}</label>
				<input class="form-control" name="description" maxlength="2000" required>
			</div>
			<div class="col-12">
				<button class="btn btn-outline-primary">{{ 'Wartung dokumentieren'|trans }}</button>
			</div>
		</form>
		<table class="table table-sm mt-3">
			<thead>
				<tr>
					<th>{{ 'Datum'|trans }}</th>
					<th>{{ 'Anlage'|trans }}</th>
					<th>{{ 'Ereignis'|trans }}</th>
					<th>{{ 'Fällig'|trans }}</th>
					<th>{{ 'Nachweis'|trans }}</th>
				</tr>
			</thead>
			<tbody>
			{% for entry in maintenance %}
				<tr>
					<td>{{ entry.performedAt|date('d.m.Y') }}</td>
					<td>{{ entry.compressor }}</td>
					<td>{{ ({'filter':'Filterwechsel', 'air_analysis':'Atemluftanalyse', 'inspection':'Prüfung / Wartung', 'repair':'Reparatur'}[entry.kind] ?? entry.kind)|trans }}</td>
					<td>{{ entry.dueAt ? entry.dueAt|date('d.m.Y') : '–' }}</td>
					<td>{{ entry.description }}</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="5">{{ 'Keine Wartungen dokumentiert.'|trans }}</td>
				</tr>
			{% endfor %}
			</tbody>
		</table>
	</section>
	<div class="d-flex justify-content-between">
		<h2 class="h5">{{ 'Letzte Füllabende'|trans }}</h2>
		<a href="{{ path('equipment_manager_compressor_evenings_csv') }}">{{ 'CSV der Viererfüllungen'|trans }}</a>
	</div>
	<table class="table table-sm">
		<thead>
			<tr>
				<th>{{ 'Datum'|trans }}</th>
				<th>{{ 'Kompressor'|trans }}</th>
				<th>{{ 'Status'|trans }}</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			{% for session in sessions %}
				<tr>
					<td>{{ session.openedAt|date('d.m.Y H:i') }}</td>
					<td>{{ session.compressor }}</td>
					<td>{{ (session.closedAt ? 'Abgeschlossen' : 'Offen')|trans }}</td>
					<td><a href="{{ path('equipment_manager_compressor_evenings',{session:session.id}) }}">{{ 'Öffnen'|trans }}</a></td>
				</tr>
			{% else %}
				<tr>
					<td colspan="4">{{ 'Keine Füllabende.'|trans }}</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
	<p class="small text-muted">
	{{ 'Alte Einzelfüllungen bleiben unverändert im bisherigen Fülllogbuch abrufbar. Keine automatische Bestätigung einer Atemluftmessung pro Flasche.'|trans }}
	<a href="{{ path('equipment_manager_compressor_log') }}">{{ 'Bisheriges Fülllogbuch'|trans }}</a>
	</p>
</main>
{% endblock %}
