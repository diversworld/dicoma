{% extends 'equipment_manager/layout.html.twig' %}
{% block title %}{{ 'Füllgebühren'|trans }} | DICOMA{% endblock %}
{% block body %}
<main class="container py-4">
    <h1>{{ 'Abrechnung der Füllungen'|trans }}</h1>
    <p>{{ 'Bei der Füllung festgeschriebene Gebühr; Zahlung wird separat bestätigt. 0,00 € bedeutet ausdrücklich kostenlos. Altfüllungen ohne Gebührenfestlegung werden nicht nachträglich als bezahlt markiert.'|trans }}</p>
    {% for category in ['success', 'danger'] %}{% for message in app.flashes(category) %}<div class="alert alert-{{ category }}">{{ message|trans }}</div>{% endfor %}{% endfor %}
    <table class="table"><thead><tr><th>{{ 'Füllung'|trans }}</th><th>{{ 'Gebühr'|trans }}</th><th>{{ 'Zahlung'|trans }}</th></tr></thead><tbody>
    {% for charge in charges %}
        <tr><td>{{ (charge.log ? 'Einzelfüllung #%id%' : 'Viererfüllung #%id%')|trans({'%id%': charge.log ? charge.log.id : charge.batch.id}) }}</td><td>{{ (charge.amountCents / 100)|number_format(2, ',', '.') }} €</td><td>
        {% if charge.collectedAt %}{{ (charge.method == 'cash' ? 'Bar' : 'Überweisung')|trans }} · {{ charge.collectedBy }} · {{ charge.collectedAt|date('d.m.Y H:i') }}
        {% elseif charge.amountCents == 0 %}{{ 'Kostenlos'|trans }}
        {% else %}
            <form method="post" action="{{ path('equipment_manager_fill_collect', {id:charge.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('fill_collect_' ~ charge.id) }}">
                <label>{{ 'Zahlungsart'|trans }} <select name="method"><option value="cash">{{ 'Barzahlung'|trans }}</option><option value="bank">{{ 'Überweisung'|trans }}</option></select></label>
                <button class="btn btn-success">{{ 'Zahlung bestätigen'|trans }}</button>
            </form>
        {% endif %}</td></tr>
    {% else %}<tr><td colspan="3">{{ 'Keine Füllgebühren erfasst.'|trans }}</td></tr>{% endfor %}
    </tbody></table>
</main>
{% endblock %}
