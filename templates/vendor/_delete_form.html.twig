<form method="post" action="{{ path('app_vendor_delete', {'id': vendor.id}) }}" onsubmit="return confirm({{ 'Are you sure you want to delete this item?'|trans|json_encode|e('html_attr') }});">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vendor.id) }}">
    <button class="btn">{{ 'Delete'|trans }}</button>
</form>
