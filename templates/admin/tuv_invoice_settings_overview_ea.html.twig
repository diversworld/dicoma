{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}TÜV-Rechnungseinstellungen{% endblock %}
{% block main %}
<p>Rechnungs- und Steuerangaben für den im Benutzermenü ausgewählten Verein.</p>
<div class="list-group">{% for club in clubs %}
<a class="list-group-item list-group-item-action d-flex justify-content-between" href="{{ path('admin_invoice_settings_edit', {id: club.id}) }}">{{ club.name }} <span>→</span></a>
{% else %}<p>Bitte zuerst einen Verein auswählen.</p>{% endfor %}</div>
<p class="mt-4"><a href="{{ path('admin_invoice_agency_confirmations') }}">Bestätigte TÜV-Einzelaufträge prüfen (systemweit)</a></p>
{% endblock %}
