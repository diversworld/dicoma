{# DiCoMa backend only: EasyAdmin context is available on EasyAdmin pages. #}
{% extends '@EasyAdmin/layout.html.twig' %}

{# The vendor layout renders this block inside the user dropdown's ActionList. #}
{% block user_menu %}
    {{ parent() }}
    {% if app.user %}
        <twig:ea:ActionMenu:ActionList:Divider />
        <form method="post" action="{{ path('app_logout') }}" class="dicoma-admin-logout-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="dicoma-admin-logout" aria-label="{{ 'Abmelden'|trans }}">
                <i class="fa fa-right-from-bracket" aria-hidden="true"></i>
                <span>{{ 'Abmelden'|trans }}</span>
            </button>
        </form>
    {% endif %}
{% endblock user_menu %}

{% block header_custom_menu %}
    {% if is_granted('ROLE_ADMIN') %}
        <span class="me-3" data-sport-club-context>
            {{ 'Verein'|trans }}: {{ admin_club_context.club ? admin_club_context.club.name : 'kein Verein ausgewählt'|trans }}
        </span>
    {% endif %}
    {{ parent() }}
{% endblock header_custom_menu %}

{% block responsive_header_logo %}
    {{ parent() }}
    {% if is_granted('ROLE_ADMIN') %}
        <span class="ms-2" data-sport-club-context>
            {{ 'Verein'|trans }}: {{ admin_club_context.club ? admin_club_context.club.name : 'kein Verein ausgewählt'|trans }}
        </span>
    {% endif %}
{% endblock responsive_header_logo %}
