{% extends 'admin/standalone_base.html.twig' %}
{% block title %}Mitgliederzentrale – {{ member.fullName }}{% endblock %}
{% block body %}
<p><a href="{{ path('admin') }}">← Verwaltung</a></p>
<div class="heading"><div><h1>Mitgliederzentrale: {{ member.fullName }}</h1><p class="muted">{{ member.club|default('Kein Verein') }} · Mitgliedsnummer: {{ member.memberNumber|default('—') }}</p></div></div>
<div class="panel"><h2>Überblick</h2><p><strong>{{ qualifications|length }}</strong> Qualifikationen · <strong>{{ courses|length }}</strong> Kursanmeldungen · <strong>{{ teams|length }}</strong> Gruppenzuordnungen · <strong>{{ documents|length }}</strong> Dokumente</p></div>
<section class="panel"><h2>Qualifikationen</h2><div class="table-wrap"><table><thead><tr><th>Qualifikation</th><th>Erteilt</th><th>Gültig bis</th><th>Geprüft</th></tr></thead><tbody>{% for q in qualifications %}<tr><td>{{ q.qualification|default('—') }}</td><td>{{ q.issuedAt ? q.issuedAt|date('d.m.Y') : '—' }}</td><td>{{ q.validUntil ? q.validUntil|date('d.m.Y') : 'Unbefristet / nicht angegeben' }}</td><td>{{ q.verified ? 'Ja' : 'Nein' }}</td></tr>{% else %}<tr><td colspan="4">Keine Qualifikationen vorhanden.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel"><h2>Kursanmeldungen</h2><div class="table-wrap"><table><thead><tr><th>Kurs</th><th>Status</th><th>Angemeldet</th></tr></thead><tbody>{% for p in courses %}<tr><td>{{ p.course|default('—') }}</td><td>{{ p.statusLabel }}</td><td>{{ p.registeredAt|date('d.m.Y') }}</td></tr>{% else %}<tr><td colspan="3">Keine Kursanmeldungen vorhanden.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel"><h2>Gruppen und Mannschaften</h2><div class="table-wrap"><table><thead><tr><th>Gruppe</th><th>Rolle</th><th>Beitritt</th></tr></thead><tbody>{% for t in teams %}<tr><td>{{ t.team.name|default('—') }}</td><td>{{ t.role.value|default('—') }}</td><td>{{ t.joinedAt ? t.joinedAt|date('d.m.Y') : '—' }}</td></tr>{% else %}<tr><td colspan="3">Keine Gruppenzuordnungen vorhanden.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel"><h2>Dokumente</h2><p class="muted small">Dokumente werden nur nach serverseitiger Administratorprüfung aus der privaten Ablage ausgeliefert.</p><div class="table-wrap"><table><thead><tr><th>Datei</th><th>Hochgeladen</th><th>Aktion</th></tr></thead><tbody>{% for d in documents %}<tr><td>{{ d.originalName }}</td><td>{{ d.createdAt|date('d.m.Y H:i') }}</td><td><a class="btn" href="{{ path('admin_member_document_download', {id: member.id, documentId: d.id}) }}">Herunterladen</a></td></tr>{% else %}<tr><td colspan="3">Keine Dokumente vorhanden.</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
