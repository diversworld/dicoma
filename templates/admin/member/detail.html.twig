{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block main %}
    {% set member = entity.instance %}
    <p><a class="btn btn-primary" href="{{ path('membership_member', {id: member.id}) }}">Mitgliedschaft, Vorgänge und Beiträge</a></p>

    {% include 'admin/member/center_field.html.twig' with {
        member: member,
        memberCenterQualifications: memberCenterQualifications|default([]),
        memberCenterCourses: memberCenterCourses|default([]),
        memberCenterTeams: memberCenterTeams|default([]),
        memberCenterDocuments: memberCenterDocuments|default([]),
        memberCenterLinks: memberCenterLinks|default({}),
        memberCenterQualificationEditUrls: memberCenterQualificationEditUrls|default({}),
        memberCenterCourseEditUrls: memberCenterCourseEditUrls|default({}),
        memberCenterTeamEditUrls: memberCenterTeamEditUrls|default({})
    } only %}
{% endblock %}
