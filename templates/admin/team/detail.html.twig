{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block main %}
    {% set team = entity.instance %}
    <div class="container-fluid px-0 dw-max-width-1400px" >
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h2 class="h4 mb-1">{{ team.name }}</h2>
                <p class="text-muted mb-0">{{ 'Sportart'|trans }}: {{ team.sport.name|default('—') }} · {{ 'Verein'|trans }}: {{ team.sport.club|default('—') }}</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-secondary" href="{{ teamCenterLinks.edit }}">{{ 'Gruppe bearbeiten'|trans }}</a>
                <a class="btn btn-primary" href="{{ teamCenterLinks.membersNew }}">{{ 'Mitglied hinzufügen'|trans }}</a>
            </div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-sm-4"><div class="content-panel p-3"><strong>{{ teamCenterMembers|length }}</strong><div>{{ 'Zuordnungen'|trans }}</div></div></div>
            <div class="col-sm-4"><div class="content-panel p-3"><strong>{{ (team.active ? 'Aktiv' : 'Inaktiv')|trans }}</strong><div>{{ 'Gruppenstatus'|trans }}</div></div></div>
            <div class="col-sm-4"><div class="content-panel p-3"><strong>{{ team.type ? team.type.label|trans : '—' }}</strong><div>{{ 'Gruppentyp'|trans }}</div></div></div>
        </div>
        <div class="content-panel p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h3 class="h5 mb-0">{{ 'Mitglieder und Zuordnungen'|trans }}</h3>
                <a class="btn btn-secondary btn-sm" href="{{ teamCenterLinks.membersIndex }}">{{ 'Alle Zuordnungen verwalten'|trans }}</a>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>{{ 'Mitglied'|trans }}</th><th>{{ 'Funktion'|trans }}</th><th>{{ 'Seit'|trans }}</th><th>{{ 'Bis'|trans }}</th><th>{{ 'Aktionen'|trans }}</th></tr></thead>
                    <tbody>
                    {% for item in teamCenterMembers %}
                        <tr>
                            <td>
                                {% if item.member and teamCenterMemberUrls[item.member.id] is defined %}
                                    <a href="{{ teamCenterMemberUrls[item.member.id] }}">{{ item.member.fullName }}</a>
                                {% else %}—{% endif %}
                            </td>
                            <td>{{ item.role ? item.role.label|trans : '—' }}</td>
                            <td>{{ item.joinedAt ? item.joinedAt|date('d.m.Y') : '—' }}</td>
                            <td>{{ item.leftAt ? item.leftAt|date('d.m.Y') : '—' }}</td>
                            <td>{% if teamCenterEditUrls[item.id] is defined %}<a class="btn btn-secondary btn-sm" href="{{ teamCenterEditUrls[item.id] }}">{{ 'Bearbeiten'|trans }}</a>{% endif %}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">{{ 'Dieser Gruppe sind noch keine Mitglieder zugeordnet.'|trans }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
