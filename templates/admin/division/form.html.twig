{% extends 'admin/portal_layout.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block content_title %}Sparte {{ sport.id ? 'bearbeiten' : 'anlegen' }}{% endblock %}
{% block main %}
    <h1>Sportart / Sparte {{ sport.id ? 'bearbeiten' : 'anlegen' }} – {{ club.name }}</h1>
    <p>Die Sparte ist die bestehende Sportart des Vereins; es wird kein zusätzliches Spartenobjekt angelegt.</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="row">
            <div class="col-12 col-md-6">{{ form_row(form.name) }}</div>
            <div class="col-12 col-md-3">{{ form_row(form.shortName) }}</div>
            <div class="col-12 col-md-3">{{ form_row(form.sortOrder) }}</div>
            <div class="col-12">{{ form_row(form.description) }}</div>
        </div>
        <button class="btn btn-primary" type="submit">Sparte speichern</button>
    {{ form_end(form) }}
    {% if sport.id %}
        <h2 class="mt-4">Spartenfunktionen</h2>
        <p>Funktionen gelten nur im angegebenen Zeitraum. Nur die Spartenleitung erhält derzeit zusätzliche Rechte für den Sportbetrieb.</p>
        <ul>
            {% for assignment in assignments %}
                <li><a href="{{ path('admin_division_function_edit', {id: assignment.id}) }}">{{ assignment.member.fullName }} – {{ assignment.role.label }}</a>
                    ({{ assignment.startsAt|date('d.m.Y') }}{% if assignment.endsAt %} – {{ assignment.endsAt|date('d.m.Y') }}{% else %} – offen{% endif %})</li>
            {% else %}
                <li>Keine Funktionen zugeordnet.</li>
            {% endfor %}
        </ul>
        <p><a class="btn btn-secondary" href="{{ path('admin_division_function_new', {id: sport.id}) }}">Funktion zuordnen</a></p>
    {% endif %}
    <p class="mt-3"><a href="{{ path('admin_settings_sports_configuration') }}">Zu den Sportarten</a></p>
{% endblock %}
