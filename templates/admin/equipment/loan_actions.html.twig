{% set reservation = field.value %}
{% if reservation is not null and reservation.id is not null %}
    <div class="d-flex flex-wrap gap-3">
        {% if reservation.status == 'reserved' %}
            <form method="post" action="{{ path('admin_equipment_loan_action', {id: reservation.id, action: 'issue'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('equipment_loan_issue_' ~ reservation.id ~ '_' ~ reservation.member.club.id) }}">
                <button type="submit" class="btn btn-primary">{{ 'Ausrüstung ausgeben'|trans }}</button>
            </form>
            <form method="post" action="{{ path('admin_equipment_loan_action', {id: reservation.id, action: 'cancel'}) }}" onsubmit="return confirm({{ 'Reservierung wirklich stornieren?'|trans|json_encode|e('html_attr') }});">
                <input type="hidden" name="_token" value="{{ csrf_token('equipment_loan_cancel_' ~ reservation.id ~ '_' ~ reservation.member.club.id) }}">
                <button type="submit" class="btn btn-outline-danger">{{ 'Reservierung stornieren'|trans }}</button>
            </form>
        {% elseif reservation.status == 'issued' %}
            <form method="post" action="{{ path('admin_equipment_loan_action', {id: reservation.id, action: 'return'}) }}" class="d-flex flex-column gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('equipment_loan_return_' ~ reservation.id ~ '_' ~ reservation.member.club.id) }}">
                <label for="loan-condition-{{ reservation.id }}">{{ 'Zustand bei Rückgabe'|trans }}</label>
                <select id="loan-condition-{{ reservation.id }}" name="condition" required class="form-select">
                    <option value="ready">{{ 'Einsatzbereit'|trans }}</option>
                    <option value="maintenance">{{ 'Wartung erforderlich'|trans }}</option>
                    <option value="damaged">{{ 'Beschädigt'|trans }}</option>
                </select>
                <label for="loan-notes-{{ reservation.id }}">{{ 'Rückgabenotiz'|trans }}</label>
                <textarea id="loan-notes-{{ reservation.id }}" name="notes" class="form-control" rows="2"></textarea>
                <button type="submit" class="btn btn-primary">{{ 'Rücknahme bestätigen'|trans }}</button>
            </form>
        {% else %}
            <span class="text-muted">{{ 'Keine weiteren Aktionen für diesen Vorgang.'|trans }}</span>
        {% endif %}
    </div>
{% endif %}
