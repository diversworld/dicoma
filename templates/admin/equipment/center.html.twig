{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}{{ 'Ausrüstung und Flaschenprüfungen'|trans }}{% endblock %}
{% block main %}
    <p class="text-muted">{{ 'Prüffristen aus dem vorhandenen Flaschenbestand. Fehlende Prüftermine gelten nicht als Freigabe.'|trans }}</p>
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-primary" href="{{ tankUrl }}">{{ 'Flaschen verwalten'|trans }}</a>
        <a class="btn btn-secondary" href="{{ checkUrl }}">{{ 'Prüftermine verwalten'|trans }}</a>
    </div>
    <div class="row g-3 mb-4">
        {% for title, number in {'Flaschen': overview.counts.total, 'Überfällig': overview.counts.overdue, 'Fällig in 30 Tagen': overview.counts.dueSoon, 'Prüfdatum fehlt': overview.counts.unknown, 'Später fällig': overview.counts.valid} %}
            <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><strong class="fs-3">{{ number }}</strong><div>{{ title|trans }}</div></div></div></div>
        {% endfor %}
    </div>
    <h2 class="h4">{{ 'Prüfungen mit Handlungsbedarf'|trans }}</h2>
    <div class="table-responsive"><table class="table"><thead><tr><th>{{ 'Inventar'|trans }}</th><th>{{ 'Seriennummer'|trans }}</th><th>{{ 'Nächste Prüfung'|trans }}</th><th>{{ 'Status'|trans }}</th></tr></thead><tbody>
    {% for item in overview.attention %}
        <tr><td>{{ item.inventory|default('—') }}</td><td>{{ item.serial|default('—') }}</td><td>{{ item.date ? item.date|date('d.m.Y') : 'Nicht hinterlegt'|trans }}</td><td>{{ item.status|trans }}</td></tr>
    {% else %}<tr><td colspan="4">{{ 'Keine kurzfristig fälligen oder ungeklärten Prüfungen.'|trans }}</td></tr>{% endfor %}
    </tbody></table></div>
    <p class="text-muted small">{{ 'Die Anzeige ist eine Verwaltungshilfe, keine rechtliche oder technische Freigabe zur Verwendung einer Druckgasflasche. Prüffristen sind anhand der geltenden Anforderungen zu beurteilen.'|trans }}</p>
{% endblock %}
