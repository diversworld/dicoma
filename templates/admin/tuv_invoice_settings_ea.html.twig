{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Rechnungseinstellungen – {{ club.name }}{% endblock %}
{% block main %}
<div class="dw-max-width-850px" >
    <h1 class="h3">Rechnungseinstellungen – {{ club.name }}</h1>
    <p class="text-muted">Diese Einstellungen gelten nur für diesen Verein. Die steuerliche Einordnung bitte mit der Buchhaltung abstimmen.</p>
    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('danger') %}<div class="alert alert-danger">{{ message }}</div>{% endfor %}
    {% form_theme form 'bootstrap_5_layout.html.twig' %}
    {{ form_start(form, {action: path('admin_invoice_settings_edit', {id: club.id})}) }}
        {{ form_errors(form) }}
        {{ form_row(form.taxMode) }}
        <div class="row g-3">
            <div class="col-md-6">{{ form_row(form.taxNumber) }}</div>
            <div class="col-md-6">{{ form_row(form.vatId) }}</div>
        </div>
        {{ form_row(form.invoiceNote) }}
        <p class="small text-muted">Mindestens Steuernummer oder Umsatzsteuer-ID erforderlich. Diese Stammdaten allein machen bestehende Rechnungen nicht rechtskonform; sie werden noch nicht automatisch in ausgestellte Rechnungen übernommen.</p>
        <div class="border rounded p-3 mb-3">
            <h2 class="h5">TÜV-Einzelaufträge der Mitglieder</h2>
            <p class="small text-muted">Getrennt von der allgemeinen Besteuerung des Vereins. Nur aktivieren, wenn das Prüfunternehmen die Mitglieder als Auftraggeber akzeptiert und der Verein nachweisbar in deren Namen und für deren Rechnung handelt. Eine Sammelliste oder reine Kostengleichheit genügt nicht.</p>
            {{ form_row(form.memberAgencyEnabled) }}
            <p class="small text-muted mt-2 mb-0">Bei Aktivierung wird die bisherige Erstellung von Vereinsrechnungen für Mitglieder-TÜV gesperrt. Bestehende Rechnungen bleiben unverändert. Die Mitglieder-Zahlungsaufstellung folgt als eigener Entwicklungsschritt.</p>
        </div>
        <button type="submit" class="btn btn-primary">Einstellungen speichern</button>
    {{ form_end(form) }}
</div>
{% endblock %}
