{% extends 'admin/standalone_base.html.twig' %}
{% block title %}Ausbildungsfortschritt – {{ participant.fullName|default('Kursteilnehmer') }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('css/pages/admin-training-progress-show.css') }}">{% endblock %}
{% block admin_body %}
{% include 'admin/partials/course_navigation.html.twig' with {'course': participant.course, 'activeSection': 'Ausbildungsfortschritt'} only %}


<p><a href="javascript:history.back()">← Zurück</a></p>
<h1>Ausbildungsfortschritt</h1>
<div class="card">
<h2>{{ participant.fullName|default('Kursteilnehmer') }}</h2>
<p class="muted">Kurs: {{ participant.course }}</p>
<h3>Pflichtfortschritt: {{ progress.passed }} / {{ progress.target }} angerechnet ({{ progress.percent }} %)</h3>
<div class="bar"><div class="fill dw-progress-fill" style="--dw-progress:{{ progress.percent }}%"></div></div>
<p class="muted">{% if progress.optionalTarget > 0 %}Optionale Ausbildung: {{ progress.optionalCredited }} / {{ progress.optionalTarget }} angerechnet ({{ progress.optionalPercent }} %); tatsächlich bestanden: {{ progress.optionalPassed }}.{% else %}Keine optionalen Einheiten hinterlegt.{% endif %}</p>
<p class="{{ progress.complete ? 'ok' : 'warn' }}">{{ progress.complete ? 'Alle hinterlegten Pflichtanforderungen erfüllt.' : 'Noch nicht alle Pflichtanforderungen erfüllt.' }}</p>
</div>
<div class="card"><h2>Ausbildungsanforderungen</h2>
{% if progress.requirements is empty %}<p>Für diesen Kurs sind noch keine Ausbildungsanforderungen hinterlegt.</p>{% else %}
<table><thead><tr><th>Einheit</th><th>Pflicht</th><th>Tatsächlich bestanden</th><th>Angerechnet</th><th>Erforderlich</th><th>Fehlend</th><th>Fortschritt</th></tr></thead><tbody>
{% for item in progress.requirements %}<tr><td>{{ item.name }}</td><td>{{ item.required ? 'Ja' : 'Nein' }}</td><td>{{ item.passed }}</td><td>{{ item.credited }}</td><td>{{ item.target }}</td><td>{{ item.missing }}</td><td>{{ item.percent }} %</td></tr>{% endfor %}
</tbody></table>{% endif %}</div>
<div class="card"><h2>Erfasste Ausbildungsnachweise</h2>
{% for item in progress.requirements %}
<h3>{{ item.name }}</h3>
{% if item.sessions is empty %}<p class="muted">Noch keine Nachweise.</p>{% else %}
<table><thead><tr><th>Termin</th><th>Datum</th><th>Bewertung</th></tr></thead><tbody>
{% for session in item.sessions %}<tr><td>{{ session.title }}</td><td>{{ session.date|default('—') }}</td><td>{{ session.status }}</td></tr>{% endfor %}
</tbody></table>{% endif %}
{% endfor %}
</div>
<p class="muted">Diese Ansicht ist eine Fortschrittsauskunft. Sie vergibt keine Qualifikation und verändert keinen Kursstatus.</p>

{% endblock %}
