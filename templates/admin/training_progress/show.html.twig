<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Ausbildungsfortschritt</title>
<style>
body{font-family:system-ui,sans-serif;background:#f5f7fb;color:#152238;margin:0;padding:2rem}main{max-width:980px;margin:auto}.card{background:white;border:1px solid #dce2ea;border-radius:12px;padding:1.25rem;margin:1rem 0}table{border-collapse:collapse;width:100%}th,td{padding:.75rem;text-align:left;border-bottom:1px solid #e3e8f0}th{background:#eef2f8}.bar{height:12px;background:#e6eaf0;border-radius:9px;overflow:hidden}.fill{height:100%;background:#238557}.muted{color:#56657a}.ok{color:#167446}.warn{color:#a45309}a{color:#1452ae}
</style>
</head>
<body><main>
<p><a href="javascript:history.back()">← Zurück</a></p>
<h1>Ausbildungsfortschritt</h1>
<div class="card">
<h2>{{ participant.member.fullName|default('Kursteilnehmer') }}</h2>
<p class="muted">Kurs: {{ participant.course }}</p>
<h3>{{ progress.passed }} / {{ progress.target }} verpflichtende Einheiten bestanden ({{ progress.percent }} %)</h3>
<div class="bar"><div class="fill" style="width:{{ progress.percent }}%"></div></div>
<p class="{{ progress.complete ? 'ok' : 'warn' }}">{{ progress.complete ? 'Alle hinterlegten Pflichtanforderungen erfüllt.' : 'Noch nicht alle Pflichtanforderungen erfüllt.' }}</p>
</div>
<div class="card"><h2>Ausbildungsanforderungen</h2>
{% if progress.requirements is empty %}<p>Für diesen Kurs sind noch keine Ausbildungsanforderungen hinterlegt.</p>{% else %}
<table><thead><tr><th>Einheit</th><th>Pflicht</th><th>Bestanden</th><th>Erforderlich</th><th>Fehlend</th><th>Fortschritt</th></tr></thead><tbody>
{% for item in progress.requirements %}<tr><td>{{ item.name }}</td><td>{{ item.required ? 'Ja' : 'Nein' }}</td><td>{{ item.passed }}</td><td>{{ item.target }}</td><td>{{ item.missing }}</td><td>{{ item.percent }} %</td></tr>{% endfor %}
</tbody></table>{% endif %}</div>
<div class="card"><h2>Erfasste Ausbildungsnachweise</h2>
{% for item in progress.requirements %}
<h3>{{ item.name }}</h3>
{% if item.sessions is empty %}<p class="muted">Noch keine Nachweise.</p>{% else %}
<table><thead><tr><th>Termin</th><th>Datum</th><th>Bewertung</th></tr></thead><tbody>
{% for session in item.sessions %}<tr><td>{{ session.title }}</td><td>{{ session.date|default('—') }}</td><td>{{ session.status }}</td></tr>{% endfor %}
</tbody></table>{% endif %}
{% endfor %}
</div>
<p class="muted">Diese Ansicht ist eine Fortschrittsauskunft. Sie vergibt keine Qualifikation und verändert keinen Kursstatus.</p>
</main></body></html>
