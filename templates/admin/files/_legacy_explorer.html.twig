<nav aria-label="{{ 'Ordnerpfad'|trans }}">
    <ol class="breadcrumb">
        {% for crumb in legacy.breadcrumbs %}
            <li class="breadcrumb-item">
                <a href="{{ path('admin_media_index', {folder: mediaFolder ? mediaFolder.id : '', legacy_path: crumb.path, _fragment: 'legacy-course-files'}) }}">{{ loop.first ? crumb.name|trans : crumb.name }}</a>
            </li>
        {% endfor %}
    </ol>
</nav>
<div class="table-responsive">
    <table class="table table-hover">
        <thead><tr><th>{{ 'Name'|trans }}</th><th>{{ 'Größe'|trans }}</th><th>{{ 'Geändert'|trans }}</th><th>{{ 'Aktionen'|trans }}</th></tr></thead>
        <tbody>
        {% for file in legacy.files %}
            <tr>
                <td>
                    {% if file.isDirectory %}
                        <a href="{{ path('admin_media_index', {folder: mediaFolder ? mediaFolder.id : '', legacy_path: file.path, _fragment: 'legacy-course-files'}) }}">{{ file.name }}</a>
                    {% else %}
                        {{ file.name }}
                    {% endif %}
                </td>
                <td>{{ file.isDirectory ? '-' : (file.size / 1024)|number_format(1, ',', '.') ~ ' KB' }}</td>
                <td>{{ file.modified|date('d.m.Y H:i') }}</td>
                <td>
                    {% if file.isDirectory %}
                        <a href="{{ path('admin_media_index', {folder: mediaFolder ? mediaFolder.id : '', legacy_path: file.path, _fragment: 'legacy-course-files'}) }}">{{ 'Öffnen'|trans }}</a>
                    {% else %}
                        <a href="{{ path('admin_files_download', {path: file.path}) }}">{{ 'Herunterladen'|trans }}</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4">{{ 'Dieser Ordner ist leer.'|trans }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
