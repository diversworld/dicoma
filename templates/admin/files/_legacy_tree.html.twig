{% set entries = legacy.tree[currentPath] %}
{% if entries %}
    <ul class="list-unstyled ps-3">
        {% for entry in entries %}
            <li>
                {% if entry.isDirectory %}
                    {% if legacy.tree[entry.path] is defined %}
                        <details open data-legacy-path="{{ entry.path }}">
                            <summary>
                                <a href="{{ path('admin_media_index', {folder: mediaFolder ? mediaFolder.id : '', legacy_path: entry.path, _fragment: 'legacy-course-files'}) }}" {% if entry.path == legacy.path %}aria-current="page"{% endif %}>{{ entry.name }}</a>
                            </summary>
                            {% include 'admin/files/_legacy_tree.html.twig' with {legacy: legacy, currentPath: entry.path, mediaFolder: mediaFolder} only %}
                        </details>
                    {% else %}
                        <a href="{{ path('admin_media_index', {folder: mediaFolder ? mediaFolder.id : '', legacy_path: entry.path, _fragment: 'legacy-course-files'}) }}">{{ entry.name }}</a>
                    {% endif %}
                {% else %}
                    <a href="{{ path('admin_files_download', {path: entry.path}) }}">{{ entry.name }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
