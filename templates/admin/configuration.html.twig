{% extends 'admin/portal_layout.html.twig' %}
{% block content_title %}{{ barOnly ? 'Thekendiensteinstellungen' : 'Konfiguration' }}{% endblock %}
{% block main %}
    <h1>{{ barOnly ? 'Thekendiensteinstellungen' : 'Konfiguration' }}</h1>
    {% if not barOnly %}<p>Technische Zugangsdaten und Umgebungsvariablen werden weiterhin auf dem Server verwaltet.</p>{% endif %}
    {% if websiteForm %}
        {% form_theme websiteForm 'bootstrap_5_layout.html.twig' %}
        <h2>Website-Anzeige – {{ ownClub.name }}</h2>
        <p>Seitengröße für Startseite und Übersichten, jeweils zwischen 1 und 100 Karten.</p>
        {{ form_start(websiteForm) }}
            {{ form_errors(websiteForm) }}
            {{ form_widget(websiteForm) }}
            <button class="btn btn-primary">Anzeige speichern</button>
        {{ form_end(websiteForm) }}
    {% endif %}
    {% if clubForm %}
        {% form_theme clubForm 'bootstrap_5_layout.html.twig' %}
        {{ form_start(clubForm, {attr: {class: 'my-3'}}) }}
            {{ form_errors(clubForm) }}
            {{ form_widget(clubForm) }}
            <button class="btn btn-secondary">Verein auswählen</button>
        {{ form_end(clubForm) }}
    {% endif %}
    {% if policyForm %}
        {% form_theme policyForm 'bootstrap_5_layout.html.twig' %}
        {% form_theme classForm 'bootstrap_5_layout.html.twig' %}
        <h2>Sportarten und Sparten</h2>
        <p>Sparten entsprechen den vorhandenen Sportarten.</p>
        <p><a href="{{ path('admin_settings_sports_configuration') }}">Sportarten im ausgewählten Sportarten-Kontext verwalten</a></p>
        <p><a href="{{ path('admin_course_division_review', {club: club.id}) }}">Ungeprüfte Kurs-Spartenzuordnungen</a></p>
        {% if is_granted('ROLE_SUPER_ADMIN') %}<p><a href="{{ path('admin_course_division_review', {club: 'unassigned'}) }}">Ungeprüfte Kurse ohne Verein</a></p>{% endif %}
        <h2>Mitgliedschaft – {{ club.name }}</h2>
        <p>Ohne beide Stichtage findet keine automatische Kündigungsberechnung statt. Beiträge sind Jahresbeträge ohne automatische anteilige Berechnung.</p>
        {{ form_start(policyForm) }}
        {{ form_errors(policyForm) }}
        {{ form_widget(policyForm) }}
        <button class="btn btn-primary">Vereinsregeln speichern</button>
        {{ form_end(policyForm) }}
        <h2>Beitragsklassen</h2>
        <p>Änderungen gelten nur für zukünftige Forderungen; bestehende Forderungen bleiben unverändert.</p>
        {% for item in classForms %}
            {% form_theme item.form 'bootstrap_5_layout.html.twig' %}
            <details class="my-3" {% if item.form.vars.submitted %}open{% endif %}><summary>{{ item.class.name }}</summary>
                {{ form_start(item.form) }}
                {{ form_errors(item.form) }}
                {{ form_widget(item.form) }}
                <button class="btn btn-primary">Beitragsklasse speichern</button>
                {{ form_end(item.form) }}
            </details>
        {% endfor %}
        <h3>Beitragsklasse anlegen</h3>
        {{ form_start(classForm) }}
            {{ form_errors(classForm) }}
            {{ form_widget(classForm) }}
            <button class="btn btn-primary">Beitragsklasse anlegen</button>
        {{ form_end(classForm) }}
    {% endif %}
    {% if canBar %}
        {% form_theme yearForm 'bootstrap_5_layout.html.twig' %}
        {% form_theme barForm 'bootstrap_5_layout.html.twig' %}
        <h2>Thekendienst-Jahresregel – {{ ownClub.name }}</h2>
        {{ form_start(yearForm, {attr: {class: 'my-3'}}) }}
            {{ form_errors(yearForm) }}
            {{ form_widget(yearForm) }}
            <button class="btn btn-secondary">Jahr auswählen</button>
        {{ form_end(yearForm) }}
        {{ form_start(barForm, {attr: {class: 'card card-body mb-3'}}) }}
            <p>Regel für {{ year }}. {{ barPolicy ? 'Bereits konfiguriert.' : 'Noch nicht konfiguriert; es wird keine Pflicht automatisch angenommen.' }}</p>
            {{ form_errors(barForm) }}
            <div class="row">
                <div class="col-12 col-md-4">{{ form_row(barForm.minutes) }}</div>
                <div class="col-12 col-md-8">{{ form_row(barForm.cash) }}</div>
                <div class="col-12">{{ form_row(barForm.reason) }}</div>
            </div>
            <button class="btn btn-primary">Jahresregel speichern</button>
        {{ form_end(barForm) }}
        {% if barPolicy %}
            <details>
                <summary>Änderungshistorie</summary>
                <ul>
                    {% for event in barPolicy.history %}
                        <li>{{ event.at|date('d.m.Y H:i') }} · {{ event.actor }} · {{ event.minutes }} Minuten · Kasse {{ event.cash ? 'aktiviert' : 'deaktiviert' }} · {{ event.reason }}</li>
                    {% endfor %}
                </ul>
            </details>
        {% endif %}
    {% endif %}
{% endblock %}
