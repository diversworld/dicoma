{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Website-Anzeige{% endblock %}
{% block main %}
    <p>Die Einstellungen gelten für die Startseite und die jeweiligen Übersichtsseiten des Website-Vereins. Pro Rubrik sind 1 bis 100 Karten pro Seite möglich.</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-primary" type="submit">Anzeige speichern</button>
    {{ form_end(form) }}
    <p><a href="{{ path('admin_website_editorial', {'_locale': app.request.locale}) }}">Zur Redaktion</a></p>
{% endblock %}
