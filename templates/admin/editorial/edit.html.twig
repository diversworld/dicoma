{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form '@EasyAdmin/crud/form_theme.html.twig' %}

{% block content_title %}{% if publication.kind == 'page' %}{{ publication.id ? 'Website-Seite bearbeiten' : 'Neue Website-Seite' }}{% elseif publication.kind == 'event' %}Legacy-Veranstaltungsankündigung bearbeiten{% else %}{{ publication.id ? 'Artikel bearbeiten' : 'Neuen Artikel erstellen' }}{% endif %}{% endblock %}

{% block main %}
    {% if canRead %}<p><a href="{{ path(publication.kind == 'page' ? 'admin_website_editorial_pages' : 'admin_website_editorial_articles') }}">Zur passenden Redaktion</a></p>{% endif %}
    <p>{% if publication.kind == 'event' %}Dies ist eine bestehende redaktionelle Altveranstaltung ohne Buchungsfunktion. Neue Veranstaltungen mit Teilnehmern oder Zahlungen werden unter <a href="{{ path('admin_club_events') }}">Veranstaltungen & Buchungen</a> angelegt.{% elseif publication.kind == 'page' %}Website-Seiten bilden die Navigationsstruktur und können Unterseiten enthalten.{% else %}Artikel bilden Beiträge für Neuigkeiten; optional können sie einer Website-Seite zugeordnet werden.{% endif %}</p>
    <p>Bilder zuerst in der <a href="{{ path('admin_media_index') }}">Dateiverwaltung</a> hochladen und anschließend hier auswählen.</p>
    {% if not canReadImage %}<p>Das vorhandene Bild bleibt unverändert, da keine Leseberechtigung für die Datei besteht.</p>{% endif %}
    {% if publication.image and canReadImage %}<img src="{{ path('admin_media_file', {id:publication.image.id}) }}" alt="{{ publication.image.altText }}" width="200">{% endif %}
    {{ form_start(form, {attr: {class: 'ea-form'}}) }}
        {{ form_errors(form) }}
        <div class="form-fieldset">
            <fieldset>
                <div class="form-fieldset-header collapsible"><div class="form-fieldset-title"><a href="#cms-base" data-bs-toggle="collapse" class="form-fieldset-title-content form-fieldset-collapse">{{ publication.kind == 'page' ? 'Seite und Hierarchie' : (publication.kind == 'event' ? 'Veranstaltungsankündigung' : 'Artikelinhalt') }}</a></div></div>
                <div id="cms-base" class="form-fieldset-body collapse show"><div class="row">
                <div class="col-12">{{ form_row(form.title) }}</div>
                {% if publication.kind != 'event' %}<div class="col-md-8">{{ form_row(form.parent) }}</div>{% endif %}
                {% if publication.kind == 'page' %}
                    <div class="col-md-2">{{ form_row(form.sortOrder) }}</div>
                    <div class="col-md-2">{{ form_row(form.menuVisible) }}</div>
                {% endif %}
                <div class="col-12">{{ form_row(form.summary) }}</div>
                <div class="col-12">{{ form_row(form.body) }}</div>
                </div></div>
            </fieldset>
        </div>
        <div class="form-fieldset">
            <fieldset>
                <div class="form-fieldset-header collapsible"><div class="form-fieldset-title"><a href="#cms-scope" data-bs-toggle="collapse" class="form-fieldset-title-content form-fieldset-collapse">Sparte, Bild und Veröffentlichung</a></div></div>
                <div id="cms-scope" class="form-fieldset-body collapse show"><div class="row">
                <div class="col-md-6">{{ form_row(form.division) }}</div>
                <div class="col-md-6">{{ form_row(form.image) }}</div>
                <div class="col-md-6">{{ form_row(form.publishAt) }}</div>
                <div class="col-md-6">{{ form_row(form.published) }}</div>
                </div></div>
            </fieldset>
        </div>
        {% if publication.kind == 'event' %}
        <div class="form-fieldset">
            <fieldset>
                <div class="form-fieldset-header collapsible"><div class="form-fieldset-title"><a href="#cms-legacy-event" data-bs-toggle="collapse" class="form-fieldset-title-content form-fieldset-collapse collapsed">Legacy-Veranstaltungsdaten</a></div></div>
                <div id="cms-legacy-event" class="form-fieldset-body collapse"><div class="row">
                <div class="col-md-6">{{ form_row(form.startsAt) }}</div>
                <div class="col-md-6">{{ form_row(form.endsAt) }}</div>
                <div class="col-12">{{ form_row(form.location) }}</div>
                <div class="col-md-6">{{ form_row(form.course) }}</div>
                <div class="col-md-6">{{ form_row(form.tournament) }}</div>
                </div></div>
            </fieldset>
        </div>
        {% endif %}
        {{ form_row(form.kind) }}
        {{ form_row(form.version) }}
        {{ form_row(form._token) }}
        <div class="form-actions">
            <button class="btn btn-primary action-save" type="submit">Beitrag speichern</button>
        </div>
    {{ form_end(form, {render_rest: false}) }}
    {% if publication.id %}
        <details class="mt-4"><summary>Änderungsnachweis</summary><ul>{% for entry in publication.history %}
            <li>{{ entry.at|date('d.m.Y H:i') }} · {{ entry.actor }} · {{ entry.published ? 'Freigegeben' : 'Entwurf' }} · {{ entry.title }}</li>
        {% endfor %}</ul></details>
    {% endif %}
{% endblock %}
