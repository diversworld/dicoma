{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}TÜV-Nachricht jetzt versenden{% endblock %}
{% block main %}
    <p>Diese E-Mail wird nach Bestätigung unmittelbar über den konfigurierten Mailserver versendet.</p>
    <dl><dt>Empfänger</dt><dd>{{ notification.recipient }}</dd><dt>Betreff</dt><dd>{{ notification.subject }}</dd><dt>Nachricht</dt><dd><pre>{{ notification.body }}</pre></dd></dl>
    <form method="post" action="{{ post_url }}">
        <input type="hidden" name="_token" value="{{ csrf_token('tuv-notification-send-' ~ notification.id) }}">
        <button class="btn btn-primary" type="submit">Jetzt verbindlich senden</button>
        <a class="btn btn-secondary" href="{{ back_url }}">Abbrechen</a>
    </form>
{% endblock %}
