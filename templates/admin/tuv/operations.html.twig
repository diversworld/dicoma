{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}{{ 'TÜV-Abwicklung'|trans }} – {{ 'Anmeldung'|trans }} #{{ booking.id }}{% endblock %}
{% block main %}
{% set bookingStatuses = {'requested':'Angemeldet', 'received':'Angenommen', 'sent':'Bei der Prüfstelle', 'returned':'Zurückerhalten', 'completed':'Abgeschlossen', 'cancelled':'Storniert'} %}
{% set handoverTypes = {'received':'Vom Mitglied / Verein angenommen', 'sent':'An Prüfstelle übergeben', 'returned':'Von Prüfstelle zurückerhalten', 'collected':'An Mitglied / Verein zurückgegeben'} %}
{% set notificationStates = {'pending':'Vorgemerkt', 'sent':'Gesendet', 'failed':'Fehlgeschlagen'} %}
<p><strong>{{ 'Flasche'|trans }}:</strong> {{ booking.tankDisplay }} · <strong>{{ 'Termin'|trans }}:</strong> {{ booking.checkDisplay }} · <strong>{{ 'Status'|trans }}:</strong> {{ bookingStatuses[booking.status] is defined ? bookingStatuses[booking.status]|trans : booking.status }}</p>
<p><a class="btn btn-secondary" href="{{ backUrl }}">{{ 'Zurück zu TÜV-Anmeldungen'|trans }}</a></p>
<h2 class="h5 mt-4">36 · {{ 'Annahme / Übergabe / Rückgabe'|trans }}</h2>
<p><a class="btn btn-outline-primary" href="{{ path('admin_tuv_handover_print', {id: booking.id}) }}" target="_blank" rel="noopener">{{ 'Übergabeprotokoll drucken / als PDF speichern'|trans }}</a></p>
<p class="text-muted">{{ 'Dokumentiert den physischen Übergabevorgang; der Buchungsstatus wird separat verwaltet.'|trans }}</p>
<form method="post" action="{{ path('admin_tuv_handover_save',{id:booking.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('tuv_ops_' ~ booking.id) }}">
<select name="type" class="form-select mb-2" required>
{% for value, label in handoverTypes %}<option value="{{ value }}">{{ label|trans }}</option>{% endfor %}
</select><textarea name="notes" class="form-control mb-2" maxlength="2000" placeholder="{{ 'Zustand / Bemerkung'|trans }}"></textarea>
<button class="btn btn-primary">{{ 'Übergabe protokollieren'|trans }}</button></form>
<table class="table mt-3"><thead><tr><th>{{ 'Zeit'|trans }}</th><th>{{ 'Vorgang'|trans }}</th><th>{{ 'Bearbeiter'|trans }}</th><th>{{ 'Bemerkung'|trans }}</th></tr></thead><tbody>
{% for h in handovers %}<tr><td>{{ h.occurredAt|date('d.m.Y H:i') }}</td><td>{{ handoverTypes[h.eventType] is defined ? handoverTypes[h.eventType]|trans : h.eventType }}</td><td>{{ h.actor }}</td><td>{{ h.notes }}</td></tr>{% else %}<tr><td colspan="4">{{ 'Noch keine Übergabe dokumentiert.'|trans }}</td></tr>{% endfor %}
</tbody></table>
<h2 class="h5 mt-4">37 · {{ 'Prüfbescheinigungen / Dokumente'|trans }}</h2>
<form method="post" enctype="multipart/form-data" action="{{ path('admin_tuv_document_upload',{id:booking.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('tuv_ops_' ~ booking.id) }}"><input type="file" name="document" accept="application/pdf,image/jpeg,image/png" required class="form-control mb-2">
<button class="btn btn-primary">{{ 'Dokument sicher ablegen'|trans }}</button></form>
<h3>{{ 'Rechnung'|trans }}</h3>
<form method="post" action="{{ path('admin_tuv_invoice_issue', {id:booking.id}) }}" onsubmit="return confirm({{ 'Rechnungsdatensatz unwiderruflich erstellen?'|trans|json_encode|e('html_attr') }})">
<input type="hidden" name="_token" value="{{ csrf_token('tuv_invoice_issue_' ~ booking.id) }}">
<button class="btn btn-outline-primary" type="submit">{{ 'Rechnungsdatensatz erstellen'|trans }}</button>
</form>
<p class="small text-muted">{{ 'Ein Rechnungsdatensatz je Anmeldung. Die Druckansicht ist noch kein rechtlich geprüfter Rechnungsbeleg.'|trans }}</p>
<ul class="mt-3">{% for doc in docs %}<li><a href="{{ path('admin_tuv_document_download',{id:doc.id}) }}">{{ doc.originalName }}</a> ({{ doc.uploadedAt|date('d.m.Y H:i') }})</li>{% else %}<li>{{ 'Noch keine Dokumente.'|trans }}</li>{% endfor %}</ul>
<h2 class="h5 mt-4">38 · {{ 'Sammelbuchung / Mehrfachflaschen'|trans }}</h2>
{% if groupLink %}<p>{{ 'Gruppe'|trans }} #{{ groupLink.group.id }} – {{ 'enthaltene Anmeldungen'|trans }}:</p><ul>{% for m in members %}<li>#{{ m.booking.id }} – {{ m.booking.tankDisplay }} ({{ bookingStatuses[m.booking.status] is defined ? bookingStatuses[m.booking.status]|trans : m.booking.status }})</li>{% endfor %}</ul>
{% else %}<form method="post" action="{{ path('admin_tuv_group_save',{id:booking.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('tuv_ops_' ~ booking.id) }}"><label for="booking_ids">{{ 'Weitere Anmeldungsnummern desselben TÜV-Termins (durch Komma getrennt)'|trans }}</label>
<input id="booking_ids" name="booking_ids" class="form-control mb-2" required placeholder="12, 13"><button class="btn btn-primary">{{ 'Sammelbuchung bilden'|trans }}</button></form>{% endif %}
<p class="text-muted">{{ 'Die Flaschen behalten ihre individuellen Status, Prüfergebnisse und Preispositionen.'|trans }}</p>
<h2 class="h5 mt-4">39 / 41 · {{ 'Benachrichtigungen (Postausgang)'|trans }}</h2>
<p><a class="btn btn-outline-secondary" href="{{ path('admin_settings_tuv_notifications') }}">{{ 'Benachrichtigungstexte konfigurieren'|trans }}</a></p>
<form method="post" action="{{ path('admin_tuv_notification_queue',{id:booking.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('tuv_ops_' ~ booking.id) }}">
<input type="email" name="recipient" class="form-control mb-2" placeholder="{{ 'Empfänger-E-Mail'|trans }}" required>
<select name="kind" class="form-select mb-2"><option value="confirmation">{{ 'Buchungsbestätigung'|trans }}</option><option value="status">{{ 'Statusinformation'|trans }}</option><option value="pickup">{{ 'Abholinformation'|trans }}</option><option value="cancellation">{{ 'Stornierungsinformation'|trans }}</option></select>
<button class="btn btn-primary">{{ 'Nachricht vormerken'|trans }}</button></form>
<p class="text-muted">{{ 'Nachrichten werden nicht beim Vormerken versendet. Für den Versand muss der separate CLI-Befehl eingerichtet werden.'|trans }}</p>
<ul>{% for n in notifications %}<li>{{ n.subject }} → {{ n.recipient }} ({{ notificationStates[n.state] is defined ? notificationStates[n.state]|trans : n.state }})</li>{% else %}<li>{{ 'Keine vorgemerkten Nachrichten.'|trans }}</li>{% endfor %}</ul>
{% endblock %}
