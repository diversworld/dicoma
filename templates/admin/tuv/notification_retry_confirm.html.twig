{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}TÜV-Nachricht nochmal versenden{% endblock %}
{% block main %}
<form method="post" action="{{ post_url }}">
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('tuv-notification-retry-' ~ notification.id) }}"
    >

    <button type="submit">
        Erneut vormerken
    </button>
</form>
{% endblock %}