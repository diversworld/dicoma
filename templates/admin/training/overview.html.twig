{% extends 'admin/portal_layout.html.twig' %}
{% block content_title %}Ausbildungsleitung – Übersicht{% endblock %}
{% block main %}
<div class="row mb-3">
  <div class="col-md-4"><div class="card p-3"><strong>{{ total }}</strong> Kurse insgesamt</div></div>
  <div class="col-md-4"><div class="card p-3"><strong>{{ active }}</strong> Kurse mit kommenden Terminen</div></div>
  <div class="col-md-4"><div class="card p-3"><strong>{{ instructors|length }}</strong> eingesetzte Ausbilder</div></div>
</div>
<h2 class="h5">Kursstatus</h2>
<table class="table"><thead><tr><th>Status</th><th>Kurse</th></tr></thead><tbody>
{% for status, count in statuses %}<tr><td>{{ status }}</td><td>{{ count }}</td></tr>{% endfor %}
</tbody></table>
<h2 class="h5 mt-4">Kursbelegung und nächste Termine</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>Kurs</th><th>Status</th><th>Teilnehmer</th><th>Kapazität</th><th>Belegung</th><th>Termine bevorstehend</th></tr></thead><tbody>
{% for course in courses %}<tr><td>{{ course.title }}</td><td>{{ course.status }}</td><td>{{ course.participants }}</td><td>{{ course.capacity ?? '–' }}</td><td>{{ course.occupancy is not null ? course.occupancy ~ ' %' : '–' }}</td><td>{{ course.upcoming }}</td></tr>
{% else %}<tr><td colspan="6">Keine Kurse vorhanden.</td></tr>{% endfor %}
</tbody></table></div>
<h2 class="h5 mt-4">Ausbilderauslastung</h2>
<table class="table"><thead><tr><th>Ausbilder</th><th>Termine gesamt</th><th>Geplante Stunden</th></tr></thead><tbody>
{% for person in instructors %}<tr><td>{{ person.name }}</td><td>{{ person.appointments }}</td><td>{{ person.hours|number_format(1, ',', '.') }} h</td></tr>
{% else %}<tr><td colspan="3">Keine Ausbilderzuweisungen vorhanden.</td></tr>{% endfor %}
</tbody></table>
<p class="text-muted small">Die Auslastung zählt alle erfassten Termine. Zeitüberschneidungen werden hier noch nicht geprüft.</p>
{% endblock %}
