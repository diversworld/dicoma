{% extends 'admin/portal_layout.html.twig' %}
{% block content_title %}{{ 'Vereinsfunktionen verwalten'|trans }}{% endblock %}
{% block main %}
<p>{{ 'Wählen Sie eine Funktion, um ihre Mitglieder und Gültigkeitszeiträume zu verwalten.'|trans }}</p>
<p>{{ 'Die Liste enthält derzeit die bestehenden Berechtigungsrollen. Geschützte Rollen werden in der Benutzerverwaltung durch Superadministratoren verwaltet.'|trans }}</p>
<table class="table datagrid">
    <thead><tr><th scope="col">{{ 'Funktion'|trans }}</th><th scope="col">{{ 'Zuordnungen'|trans }}</th></tr></thead>
    <tbody>
    {% for label, role in functions %}
        <tr>
            <td>{{ label|trans }}</td>
            <td><a href="{{ path('admin_function_members', {role: role}) }}">{{ 'Mitglieder anzeigen'|trans }}</a></td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
