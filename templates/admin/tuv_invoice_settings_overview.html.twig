{% extends 'admin/standalone_base.html.twig' %}
{% block title %}TÜV-Rechnungseinstellungen{% endblock %}
{% block hero %}{% endblock %}
{% block admin_body %}
<main class="container py-4 dw-max-width-900px" >
    <h1 class="h3">TÜV-Rechnungseinstellungen</h1>
    <p class="text-muted">Wähle den Verein aus, dessen Rechnungs- und Steuerangaben du bearbeiten möchtest.</p>
    <div class="list-group">
        {% for club in clubs %}
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="{{ path('admin_tuv_invoice_settings', {id: club.id}) }}">
                <span>{{ club.name }}</span><span aria-hidden="true">→</span>
            </a>
        {% else %}
            <div class="alert alert-info">Es sind noch keine Vereine vorhanden.</div>
        {% endfor %}
    </div>
</main>
{% endblock %}
