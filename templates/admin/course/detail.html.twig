{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block main %}
    {% set course = entity.instance %}
    {% set courseId = course.id %}
    {% set completed = course.status.value == 'completed' %}
    {% set courseController = 'App\\Controller\\Admin\\CoursesCrudController' %}
    {% set editUrl = ea_url().unsetAll().setController(courseController).setAction('edit').setEntityId(courseId) %}
    {% set generateUrl = path('admin_course_generate_confirm', {id: courseId}) %}
    {% set importUrl = path('admin_course_import_confirm', {id: courseId}) %}
    {% set templateUrl = path('admin_course_export_template', {id: courseId}) %}
    {% set completeUrl = path('admin_course_complete_confirm', {id: courseId}) %}
    {% set reopenUrl = path('admin_course_reopen_confirm', {id: courseId}) %}
    {% set matrixUrl = path('admin_course_training_matrix', {id: courseId}) %}
    {% set planUrl = path('admin_course_plan', {id: courseId}) %}

    <section class="container-fluid px-0" aria-label="Kurszentrale">
        <header class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
            <div>
                <h2 class="h4 mb-1">{{ course.title }}</h2>
                <div class="text-muted small">{{ course.club ? course.club : 'Kein Verein' }} · {{ course.status.value|default('')|upper }}</div>
            </div>
            <a class="btn btn-outline-secondary btn-sm" href="{{ ea_url().unsetAll().setController(courseController).setAction('index') }}">Zur Kursliste</a>
        </header>

        {# Eine einzige zentrale Aktionsleiste; EasyAdmin zeigt auf der Detailseite
           keine zusaetzlichen benutzerdefinierten Kursaktionen mehr. #}
        <div class="card mb-4">
            <div class="card-body">
                <h3 class="h6 mb-3">Kurs bearbeiten und organisieren</h3>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" href="{{ matrixUrl }}"><i class="fa fa-table me-1"></i> Ausbildungsübersicht &amp; Bewertungen</a>
                    <a class="btn btn-outline-primary" href="{{ path('admin_portal_training_course', {id: courseId}) }}">Teilnahmen, Zahlungen &amp; Lernziele</a>
                    {% if not completed %}
                        <a class="btn btn-outline-primary" href="{{ planUrl }}"><i class="fa fa-calendar-days me-1"></i> Termine planen</a>
                        <a class="btn btn-outline-secondary" href="{{ editUrl }}"><i class="fa fa-pen me-1"></i> Kurs bearbeiten</a>
                        {% if course.trainingUnits|length > 0 %}
                            <a class="btn btn-outline-secondary" href="{{ generateUrl }}"><i class="fa fa-calendar-plus me-1"></i> Kurstermine erzeugen</a>
                        {% endif %}
                    {% endif %}
                    {% if courseDashboard is defined and courseDashboard.bookingListUrl is defined %}
                        <a class="btn btn-outline-secondary" href="{{ courseDashboard.bookingListUrl }}"><i class="fa fa-ticket me-1"></i> Terminbuchungen</a>
                    {% endif %}
                </div>
                <details class="mt-3">
                    <summary class="text-muted small dw-pointer" >Weitere Aktionen</summary>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        {% if not completed and course.qualification %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ importUrl }}">Ausbildungsplan übernehmen</a>
                        {% endif %}
                        {% if course.club %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ templateUrl }}">Als Planungsvorlage speichern</a>
                        {% endif %}
                        {% if completed %}
                            <a class="btn btn-sm btn-outline-warning" href="{{ reopenUrl }}">Kurs wieder öffnen</a>
                        {% else %}
                            <a class="btn btn-sm btn-outline-warning" href="{{ completeUrl }}">Kurs abschließen</a>
                        {% endif %}
                    </div>
                </details>
            </div>
        </div>

        <div class="row g-3 mb-4" aria-label="Kurskennzahlen">
            <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Kursteilnehmer</div><div class="fs-3 fw-bold">{{ course.participantCount }}</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Kurstermine</div><div class="fs-3 fw-bold">{{ course.schedule|length }}</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Ausbildungsanforderungen</div><div class="fs-3 fw-bold">{{ course.trainingUnits|length }}</div></div></div></div>
            {% if courseDashboard is defined %}
                <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Terminbuchungen</div><div class="fs-3 fw-bold">{{ courseDashboard.bookingCount }}</div></div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Anwesenheit noch geplant</div><div class="fs-3 fw-bold">{{ courseDashboard.attendanceOpenCount }}</div></div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Durchschnittlicher Ausbildungsfortschritt</div><div class="fs-3 fw-bold">{{ courseDashboard.averageProgress }} %</div><div class="progress" role="progressbar" aria-valuenow="{{ courseDashboard.averageProgress }}" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar dw-progress-fill" style="--dw-progress:{{ courseDashboard.averageProgress }}%"></div></div></div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Pflichtnachweise vollständig</div><div class="fs-3 fw-bold">{{ courseDashboard.readyCount }} / {{ courseDashboard.participantCount }}</div></div></div></div>
                <div class="col-sm-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Teilnehmer mit offenen Pflichtnachweisen</div><div class="fs-3 fw-bold">{{ courseDashboard.missingCount }}</div></div></div></div>
            {% endif %}
        </div>

        {% if courseDashboard is defined %}
            <div class="card mb-4">
                <div class="card-header"><strong>Nächste Kurstermine</strong>{% if courseDashboard.undatedCount > 0 %}<span class="badge text-bg-warning ms-2">{{ courseDashboard.undatedCount }} ohne Datum</span>{% endif %}</div>
                <div class="card-body">
                    {% if courseDashboard.upcoming is empty %}
                        <p class="text-muted mb-0">Keine zukünftigen Termine mit Datum vorhanden.</p>
                    {% else %}
                        <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Datum</th><th>Beginn</th><th>Ausbildungstermin</th></tr></thead><tbody>
                            {% for appointment in courseDashboard.upcoming %}<tr><td>{{ appointment.date }}</td><td>{{ appointment.time ? appointment.time ~ ' Uhr' : 'Uhrzeit fehlt' }}</td><td>{{ appointment.title }}</td></tr>{% endfor %}
                        </tbody></table></div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {% if courseCompletionChecklist is defined %}
            {% set checklist = courseCompletionChecklist %}
            <div class="card mb-4" aria-label="Kursabschluss-Checkliste">
                <div class="card-header"><strong>Kursabschluss-Checkliste</strong></div>
                <div class="card-body">
                    <p class="small text-muted">Vorprüfung zur Orientierung. Die verbindliche Abschlussprüfung erfolgt weiterhin beim Kursabschluss.</p>
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between gap-2"><span>Ausbildungsanforderungen hinterlegt</span><span class="{{ checklist.requirementsConfigured ? 'text-success' : 'text-warning' }}">{{ checklist.requirementsConfigured ? 'Erfüllt' : 'Fehlt' }}</span></li>
                        <li class="list-group-item d-flex justify-content-between gap-2"><span>Mindestens ein Kursteilnehmer vorhanden</span><span class="{{ checklist.participantsPresent ? 'text-success' : 'text-warning' }}">{{ checklist.participantsPresent ? 'Erfüllt' : 'Fehlt' }}</span></li>
                        <li class="list-group-item d-flex justify-content-between gap-2"><span>Alle Teilnehmer haben einen abschließenden Kursstatus</span><span class="{{ checklist.participantStatusesFinal ? 'text-success' : 'text-warning' }}">{{ checklist.participantStatusesFinal ? 'Erfüllt' : 'Offen' }}</span></li>
                        <li class="list-group-item d-flex justify-content-between gap-2"><span>Pflichtnachweise vollständig</span><span class="{{ checklist.requiredEvidenceComplete ? 'text-success' : 'text-warning' }}">{{ checklist.requiredEvidenceComplete ? 'Erfüllt' : checklist.missingParticipants ~ ' Teilnehmer mit offenen Nachweisen' }}</span></li>
                    </ul>
                    {% if completed %}<div class="alert alert-secondary mb-0">Dieser Kurs ist bereits abgeschlossen.</div>
                    {% elseif checklist.readyForReview %}<div class="alert alert-success mb-0">Die angezeigten Voraussetzungen sind erfüllt. Der Kursabschluss kann fachlich geprüft werden.</div>
                    {% else %}<div class="alert alert-warning mb-0">Der Kurs ist nach dieser Vorprüfung noch nicht abschlussbereit. Bitte offene Punkte bearbeiten.</div>{% endif %}
                </div>
            </div>
        {% endif %}
    </section>
    <details class="mt-4"><summary class="h6 dw-pointer" >Weitere Kursinformationen</summary><div class="mt-3">{{ parent() }}</div></details>
{% endblock %}
