{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'Planungsvorlage duplizieren'|trans }}{% endblock %}

{% block main %}
    <p>{{ 'Die Vorlage %name% wird einschließlich ihrer Ausbildungstermine kopiert.'|trans({'%name%': original.name}) }}</p>
    <p><strong>{{ 'Verein'|trans }}:</strong> {{ original.club }}<br>
       <strong>{{ 'Ausbildungstermine'|trans }}:</strong> {{ original.entries|length }}</p>

    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('duplicate_schedule_template_' ~ original.id) }}">
        <div class="mb-3">
            <label for="duplicate-template-name" class="form-label">{{ 'Name der neuen Vorlage'|trans }}</label>
            <input id="duplicate-template-name" name="name" type="text"
                   class="form-control" required maxlength="150"
                   value="{{ suggestedName }}">
        </div>
        <button type="submit" class="btn btn-primary">{{ 'Vorlage duplizieren'|trans }}</button>
        <a href="{{ backUrl }}" class="btn btn-secondary">{{ 'Abbrechen'|trans }}</a>
    </form>
{% endblock %}
