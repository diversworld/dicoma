{% extends 'admin/portal_layout.html.twig' %}
{% block content_title %}Mitgliedsbeiträge und Forderungen{% endblock %}
{% block main %}
<div class="row mb-4">
    <div class="col-md-4"><div class="card p-3"><strong>{{ (openCents / 100)|number_format(2, ',', '.') }} EUR</strong><span>Offen</span></div></div>
    <div class="col-md-4"><div class="card p-3"><strong>{{ (overdueCents / 100)|number_format(2, ',', '.') }} EUR</strong><span>Überfällig</span></div></div>
    <div class="col-md-4"><div class="card p-3"><strong>{{ (paidCents / 100)|number_format(2, ',', '.') }} EUR</strong><span>Eingegangen</span></div></div>
</div>
<p class="text-muted">Nur finanzielle Forderungs- und Zahlungsdaten. IBAN, Mandatsnachweise, Kontaktdaten und weitere Mitgliedsverwaltung sind nicht Bestandteil dieser Ansicht.</p>
<div class="table-responsive"><table class="table table-striped">
    <thead><tr><th>Rechnung</th><th>Mitglied</th><th>Forderung</th><th>Fällig</th><th>Betrag</th><th>Bezahlt</th><th>Offen</th><th>Status</th><th>Zahlungen</th></tr></thead>
    <tbody>{% for row in rows %}
        {% set charge = row.charge %}
        <tr>
            <td>{{ charge.invoiceNumber ?? '—' }}</td>
            <td>{{ charge.member.fullName }}</td>
            <td>{{ charge.description }}</td>
            <td>{{ charge.dueAt|date('d.m.Y') }}</td>
            <td>{{ (charge.amountCents / 100)|number_format(2, ',', '.') }} EUR</td>
            <td>{{ (charge.paidCents / 100)|number_format(2, ',', '.') }} EUR</td>
            <td>{{ (charge.outstandingCents / 100)|number_format(2, ',', '.') }} EUR</td>
            <td>{{ charge.status == 'paid' ? 'Bezahlt' : (charge.status == 'reminded' ? 'Gemahnt (' ~ charge.reminderCount ~ ')' : (charge.status == 'overdue' ? 'Überfällig' : 'Offen')) }}</td>
            <td>{% for payment in row.payments %}{{ payment.receivedAt|date('d.m.Y') }}: {{ (payment.amountCents / 100)|number_format(2, ',', '.') }} EUR · {{ payment.reference }}<br>{% endfor %}{% for notice in row.notices %}<a href="{{ path('admin_membership_dunning_pdf', {id: notice.id}) }}">Mahnung {{ notice.createdAt|date('d.m.Y') }} als PDF</a><br>{% endfor %}{% if row.payments is empty and row.notices is empty %}—{% endif %}</td>
        </tr>
    {% else %}<tr><td colspan="9">Keine Mitgliedsforderungen vorhanden.</td></tr>{% endfor %}</tbody>
</table></div>
{% if pages > 1 %}<nav class="mt-3" aria-label="Finanzseiten"><ul class="pagination">
    {% for number in 1..pages %}<li class="page-item {{ number == page ? 'active' : '' }}"><a class="page-link" href="{{ path('admin_membership_finance', {page:number}) }}">{{ number }}</a></li>{% endfor %}
</ul></nav>{% endif %}
{% endblock %}
