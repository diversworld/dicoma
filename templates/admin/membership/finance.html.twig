{% extends 'admin/portal_layout.html.twig' %}
{% block content_title %}Mitgliedsbeiträge und Forderungen{% endblock %}
{% block main %}
<div class="row mb-4">
    <div class="col-md-4"><div class="card p-3"><strong>{{ (openCents / 100)|number_format(2, ',', '.') }} EUR</strong><span>Offen</span></div></div>
    <div class="col-md-4"><div class="card p-3"><strong>{{ (overdueCents / 100)|number_format(2, ',', '.') }} EUR</strong><span>Überfällig</span></div></div>
    <div class="col-md-4"><div class="card p-3"><strong>{{ (paidCents / 100)|number_format(2, ',', '.') }} EUR</strong><span>Eingegangen</span></div></div>
</div>
<p class="text-muted">Nur finanzielle Forderungs- und Zahlungsdaten. IBAN, Mandatsnachweise, Kontaktdaten und weitere Mitgliedsverwaltung sind nicht Bestandteil dieser Ansicht.</p>
<div class="table-responsive"><table class="table table-striped">
    <thead><tr><th>Rechnung</th><th>Mitglied</th><th>Forderung</th><th>Fällig</th><th>Betrag</th><th>Bezahlt</th><th>Offen</th><th>Status</th><th>Zahlungen</th></tr></thead>
    <tbody>{% for row in rows %}
        {% set charge = row.charge %}
        <tr>
            <td>{{ charge.invoiceNumber ?? '—' }}</td>
            <td>{{ charge.member.fullName }}</td>
            <td>{{ charge.description }}</td>
            <td>{{ charge.dueAt|date('d.m.Y') }}</td>
            <td>{{ (charge.amountCents / 100)|number_format(2, ',', '.') }} EUR</td>
            <td>{{ (charge.paidCents / 100)|number_format(2, ',', '.') }} EUR</td>
            <td>{{ (charge.outstandingCents / 100)|number_format(2, ',', '.') }} EUR</td>
            <td>{{ charge.status == 'paid' ? 'Bezahlt' : (charge.status == 'reminded' ? 'Gemahnt (' ~ charge.reminderCount ~ ')' : (charge.status == 'overdue' ? 'Überfällig' : 'Offen')) }}</td>
            <td>{% for payment in row.payments %}{{ payment.receivedAt|date('d.m.Y') }}: {{ (payment.amountCents / 100)|number_format(2, ',', '.') }} EUR · {{ payment.reference }}<br>{% endfor %}{% for notice in row.notices %}<a href="{{ path('admin_membership_dunning_pdf', {id: notice.id}) }}">Mahnung {{ notice.createdAt|date('d.m.Y') }} als PDF</a><br>{% endfor %}{% if row.payments is empty and row.notices is empty %}—{% endif %}</td>
        </tr>
    {% else %}<tr><td colspan="9">Keine Mitgliedsforderungen vorhanden.</td></tr>{% endfor %}</tbody>
</table></div>
{% if rows and canFinanceWrite %}
<form method="post" action="{{ path('admin_membership_sepa_create') }}" class="card card-body mt-4">
    <input type="hidden" name="_token" value="{{ csrf_token('sepa_batch_create') }}">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4"><label class="form-label" for="sepa-key">Laufschlüssel</label><input class="form-control" id="sepa-key" name="batchKey" required value="SEPA-{{ 'now'|date('Ymd-His') }}"></div>
        <div class="col-lg-3"><label class="form-label" for="sepa-date">Einzugsdatum</label><input class="form-control" id="sepa-date" type="date" name="collectionDate" required value="{{ 'now'|date_modify('+3 days')|date('Y-m-d') }}"></div>
        <div class="col-lg-5"><fieldset><legend class="form-label">Forderungen für Lastschriftlauf</legend>{% for row in rows %}{% if row.charge.outstandingCents > 0 %}<div class="form-check"><input class="form-check-input" id="sepa-charge-{{ row.charge.id }}" type="checkbox" name="charges[]" value="{{ row.charge.id }}"><label class="form-check-label" for="sepa-charge-{{ row.charge.id }}">{{ row.charge.invoiceNumber ?? row.charge.description }} – {{ row.charge.member.fullName }}</label></div>{% endif %}{% endfor %}</fieldset></div>
        <div class="col-12"><button class="btn btn-primary">Lastschriftentwurf anlegen</button></div>
    </div>
</form>
{% endif %}
<div class="card mt-4"><div class="card-header"><h2 class="h5 mb-0">SEPA-Lastschriftläufe</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Lauf</th><th>Einzug</th><th>Status</th><th>Betrag</th><th>Aktion</th></tr></thead><tbody>
{% for batch in sepaBatches %}<tr><td>{{ batch.batchKey }}</td><td>{{ batch.collectionDate|date('d.m.Y') }}</td><td>{{ batch.status }}</td><td>{{ (batch.totalCents / 100)|number_format(2, ',', '.') }} EUR</td><td>
{% if batch.status == 'draft' and canFinanceWrite %}<form method="post" action="{{ path('admin_membership_sepa_approve', {id:batch.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sepa_batch_approve_' ~ batch.id) }}"><button class="btn btn-sm btn-outline-primary">Freigeben</button></form>{% elseif batch.status in ['approved', 'exported'] and canFinanceWrite %}<form method="post" action="{{ path('admin_membership_sepa_export', {id:batch.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sepa_batch_export_' ~ batch.id) }}"><button class="btn btn-sm btn-outline-success">pain.008 herunterladen</button></form>{% else %}<span class="text-muted">Nur Lesen</span>{% endif %}
</td></tr>{% else %}<tr><td colspan="5">Noch keine Lastschriftläufe.</td></tr>{% endfor %}
</tbody></table></div></div>
{% if pages > 1 %}<nav class="mt-3" aria-label="Finanzseiten"><ul class="pagination">
    {% for number in 1..pages %}<li class="page-item {{ number == page ? 'active' : '' }}"><a class="page-link" href="{{ path('admin_membership_finance', {page:number}) }}">{{ number }}</a></li>{% endfor %}
</ul></nav>{% endif %}
{% endblock %}
