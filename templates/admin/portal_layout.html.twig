{% extends '@EasyAdmin/page/content.html.twig' %}

{% block sidebar %}
    {% if is_granted('ROLE_ADMIN') %}
        {{ parent() }}
    {% else %}
        <aside class="sidebar" data-training-staff-navigation>
            <nav aria-label="Fachverwaltung" class="p-3">
                {% if is_granted('ROLE_INSTRUCTOR') or is_granted('ROLE_COURSE_ADMIN') %}
                    <h2>Ausbildung</h2>
                    <p><a href="{{ path('admin_portal_training_portal') }}">Zugeordnete Kurse</a></p>
                {% endif %}
                {% if is_granted('ROLE_TRAINING_MANAGER') %}
                    <p><a href="{{ path('admin_training_overview') }}">Ausbildungsübersicht</a></p>
                {% endif %}
                {% if is_granted('ROLE_BAR_MANAGER') %}
                    <p><a href="{{ path('admin_portal_bar_duty') }}">Clubheimverwaltung</a></p>
                {% endif %}
                {% if is_granted('ROLE_BAR_MANAGER') or is_granted('ROLE_PRESS_OFFICER') %}
                    <p><a href="{{ path('admin_configuration') }}">Konfiguration</a></p>
                {% endif %}
            </nav>
        </aside>
    {% endif %}
{% endblock %}
