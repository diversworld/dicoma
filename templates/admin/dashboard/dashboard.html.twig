{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    DiCoMa Dashboard
{% endblock %}

{% block main %}
    <div class="row mb-4">
        <div class="col-md-6 col-xl-3 mb-3">
            <a href="{{ expiredQualificationsUrl }}" class="text-decoration-none text-reset" >
                <div class="card-body">
                    <div class="text-muted">
                        Qualifikationen abgelaufen
                    </div>
                    <div class="fs-1 fw-bold">
                        {{ expiredQualificationCount }}
                    </div>
                    {% if expiredQualificationCount > 0 %}
                        <div class="text-danger">
                            Handlungsbedarf
                        </div>
                    {% else %}
                        <div class="text-success">
                            Keine
                        </div>
                    {% endif %}
                </div>
			</a>
		</div>
		<div class="col-md-6 col-xl-3 mb-3">
			<a href="{{ expiringQualificationsUrl }}" class="text-decoration-none text-reset">
				<div class="card-body">
					<div class="text-muted">
						Ablauf innerhalb 30 Tagen
					</div>
					<div class="fs-1 fw-bold">
						{{ expiringQualificationCount }}
					</div>
					{% if expiringQualificationCount > 0 %}
					<div class="text-warning">
						Bitte prüfen
					</div>
					{% else %}
					<div class="text-success">
						Keine
					</div>
					{% endif %}
				</div>
			</a>
		</div>
		<div class="col-md-6 col-xl-3 mb-3">
			<a href="{{ allQualificationsUrl }}" class="text-decoration-none text-reset">
				<div class="card h-100">
					<div class="card-body">
						<div class="text-muted">
							Mitgliedsqualifikationen
						</div>
						<div class="fs-1 fw-bold">
							<i class="fa fa-certificate"></i>
						</div>
						<div>
							Alle anzeigen
						</div>
					</div>
				</div>
			</a>
		</div>
	</div>

    <div class="row">
        <div class="col-xl-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <strong>
                        Abgelaufene Qualifikationen
                    </strong>
                </div>
                <div class="card-body p-0">
                    {% if expiredQualifications is empty %}

                        <div class="p-3 text-muted">
                            Keine abgelaufenen Qualifikationen.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                <tr>
                                    <th>Mitglied</th>
                                    <th>Qualifikation</th>
                                    <th>Abgelaufen am</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for item in expiredQualifications %}
                                    <tr>
                                        <td>
                                            {{ item.member.fullName }}
                                        </td>
                                        <td>
                                            {{ item.qualification }}
                                        </td>
                                        <td class="text-danger">
                                            {{ item.validUntil|date('d.m.Y') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-xl-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <strong>
                        Ablauf innerhalb 30 Tagen
                    </strong>
                </div>
                <div class="card-body p-0">
                    {% if expiringQualifications is empty %}
                        <div class="p-3 text-muted">
                            Keine anstehenden Abläufe.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                <tr>
                                    <th>Mitglied</th>
                                    <th>Qualifikation</th>
                                    <th>Gültig bis</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for item in expiringQualifications %}
                                    <tr>
                                        <td>
                                            {{ item.member.fullName }}
                                        </td>
                                        <td>
                                            {{ item.qualification }}
                                        </td>
                                        <td>
                                            {{ item.validUntil|date('d.m.Y') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}