{% extends 'admin/portal_layout.html.twig' %}
{% block content_title %}Audit und Datenschutz{% endblock %}
{% block main %}
<div class="row g-4"><section class="col-lg-4"><div class="card"><div class="card-header"><h2 class="h5 mb-0">Aufbewahrungsrichtlinie</h2></div><div class="card-body"><form method="post" class="vstack gap-3">
<input type="hidden" name="_token" value="{{ csrf_token('privacy_policy') }}">
<label class="form-label">Mitgliedsdaten nach Austritt in Jahren<input class="form-control" type="number" min="1" max="10" name="memberRetentionYears" value="{{ policy.memberRetentionYears }}"></label>
<label class="form-label">Nachrichten in Tagen<input class="form-control" type="number" min="30" max="3650" name="messageRetentionDays" value="{{ policy.messageRetentionDays }}"></label>
<label class="form-label">Finanzdaten in Jahren<input class="form-control" type="number" min="10" max="30" name="financialRetentionYears" value="{{ policy.financialRetentionYears }}"></label>
<label class="form-label">Auditdaten in Jahren<input class="form-control" type="number" min="1" max="10" name="auditRetentionYears" value="{{ policy.auditRetentionYears }}"></label>
<div class="form-check"><input class="form-check-input" type="checkbox" id="purge-enabled" name="purgeEnabled" value="1" {{ policy.purgeEnabled ? 'checked' : '' }}><label class="form-check-label" for="purge-enabled">Automatische Bereinigung zulassen</label></div>
<button class="btn btn-primary">Speichern</button></form></div></div></section>
<section class="col-lg-8"><div class="card"><div class="card-header"><h2 class="h5 mb-0">Audit-Trail</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Zeit</th><th>Akteur</th><th>Aktion</th><th>Objekt</th></tr></thead><tbody>
{% for event in audit %}<tr><td>{{ event.occurredAt|date('d.m.Y H:i:s') }}</td><td>{{ event.actor }}</td><td>{{ event.action }}</td><td>{{ event.subjectType }} {{ event.subjectId }}</td></tr>{% else %}<tr><td colspan="4">Keine Audit-Ereignisse.</td></tr>{% endfor %}
</tbody></table></div></div></section></div>
{% endblock %}
