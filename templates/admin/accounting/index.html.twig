{% extends 'admin/portal_layout.html.twig' %}
{% block content_title %}Buchhaltung und Jahresabschluss{% endblock %}
{% block main %}
<div class="card mb-4">
  <div class="card-header"><h2 class="h5 mb-0">Kassenabschlüsse übernehmen</h2></div>
  <div class="card-body">
    <p class="text-muted">Pro Abschluss werden Bareinnahmen gegen ein Erlöskonto und Barausgaben gegen ein Aufwandskonto gebucht. Die Neben- oder Kompressorkasse bleibt anschließend mit ihrem gezählten Restbestand bestehen.</p>
    <div class="table-responsive"><table class="table align-middle mb-0">
      <thead><tr><th>Kasse / Abschluss</th><th>Einnahmen</th><th>Ausgaben</th><th>Kontierung</th></tr></thead>
      <tbody>
      {% for closing in cashClosings %}
        <tr>
          <td><strong>{{ closing.label }}</strong><div class="small text-muted">{{ closing.type == 'bar' ? 'Thekenkasse 19120' : 'Kompressorkasse 19110' }}</div></td>
          <td>{{ (closing.incomeCents / 100)|number_format(2, ',', '.') }} EUR</td>
          <td>{{ (closing.expenseCents / 100)|number_format(2, ',', '.') }} EUR</td>
          <td>
            {% if closing.posted %}
              <span class="badge bg-success">Übernommen</span>
            {% else %}
              <form method="post" class="row g-2">
                <input type="hidden" name="_token" value="{{ csrf_token('accounting_post') }}">
                <input type="hidden" name="operation" value="cash-close-booking">
                <input type="hidden" name="cashType" value="{{ closing.type }}">
                <input type="hidden" name="sourceId" value="{{ closing.id }}">
                <div class="col-xl-4"><label class="form-label">Kassenkonto<select class="form-select form-select-sm" name="cashAccount" required>
                  {% for account in accounts %}{% if account.type == 'asset' %}<option value="{{ account.id }}" {{ account.code == (closing.type == 'bar' ? '19120' : '19110') ? 'selected' : '' }}>{{ account.code }} – {{ account.name }}</option>{% endif %}{% endfor %}
                </select></label></div>
                <div class="col-xl-4"><label class="form-label">Erlöskonto<select class="form-select form-select-sm" name="incomeAccount" required>
                  {% for account in accounts %}{% if account.type == 'income' %}<option value="{{ account.id }}">{{ account.code }} – {{ account.name }}</option>{% endif %}{% endfor %}
                </select></label></div>
                <div class="col-xl-4"><label class="form-label">Aufwandskonto<select class="form-select form-select-sm" name="expenseAccount" required>
                  {% for account in accounts %}{% if account.type == 'expense' %}<option value="{{ account.id }}">{{ account.code }} – {{ account.name }}</option>{% endif %}{% endfor %}
                </select></label></div>
                <div class="col-12"><button class="btn btn-sm btn-primary">In Buchhaltung übernehmen</button></div>
              </form>
            {% endif %}
          </td>
        </tr>
      {% else %}
        <tr><td colspan="4" class="text-muted">Keine abgeschlossenen Kassen vorhanden.</td></tr>
      {% endfor %}
      </tbody>
    </table></div>
  </div>
</div>
<div class="card mb-4">
  <div class="card-header"><h2 class="h5 mb-0">Bargeld zwischen Kassen übernehmen</h2></div>
  <div class="card-body">
    <p class="text-muted">Eine Übergabe aus Kompressor- oder Thekenkasse in die Hauptkasse bzw. ein Girokonto ist eine reine Umbuchung und verändert Einnahmen/Ausgaben nicht.</p>
    <form method="post" class="row g-3">
      <input type="hidden" name="_token" value="{{ csrf_token('accounting_post') }}">
      <input type="hidden" name="operation" value="cash-transfer">
      <div class="col-lg-3"><label class="form-label">Von Kasse<select class="form-select" name="fromCashAccount" required>{% for account in accounts %}{% if account.type == 'asset' %}<option value="{{ account.id }}">{{ account.code }} – {{ account.name }}</option>{% endif %}{% endfor %}</select></label></div>
      <div class="col-lg-3"><label class="form-label">Nach Kasse / Bank<select class="form-select" name="toCashAccount" required>{% for account in accounts %}{% if account.type == 'asset' %}<option value="{{ account.id }}">{{ account.code }} – {{ account.name }}</option>{% endif %}{% endfor %}</select></label></div>
      <div class="col-lg-2"><label class="form-label">Betrag EUR<input class="form-control" name="transferAmount" inputmode="decimal" required></label></div>
      <div class="col-lg-2"><label class="form-label">Datum<input class="form-control" type="date" name="transferDate" value="{{ 'now'|date('Y-m-d') }}" required></label></div>
      <div class="col-lg-4"><label class="form-label">Übergabebeleg<input class="form-control" name="transferReference" maxlength="180" required placeholder="Kassenübergabe 27.11.2026"></label></div>
      <div class="col-12"><button class="btn btn-primary">Geldübergabe buchen</button></div>
    </form>
  </div>
</div>
<div class="card mt-4">
  <div class="card-header">
    <h2 class="h5 mb-0">Buchung erfassen</h2>
  </div>
  <div class="card-body">
    <form method="post" class="row g-3">
      <input type="hidden" name="_token" value="{{ csrf_token('accounting_post') }}">
      <input type="hidden" name="operation" value="transaction">
      <div class="col-md-3">
        <label class="form-label">Datum<input class="form-control" type="date" name="date" value="{{ 'now'|date('Y-m-d') }}" required></label>
      </div>
      <div class="col-md-3">
        <label class="form-label">Sollkonto<select class="form-select" name="debit" required>
          {% for account in accounts %}
            <option value="{{ account.id }}">{{ account.code }} – {{ account.name }}{% if account.sphere %} ({{ account.sphere }}){% endif %}</option>
          {% endfor %}</select>
        </label>
      </div>
      <div class="col-md-3">
        <label class="form-label">Habenkonto
          <select class="form-select" name="credit" required>
            {% for account in accounts %}
              <option value="{{ account.id }}">{{ account.code }} – {{ account.name }}{% if account.sphere %} ({{ account.sphere }}){% endif %}</option>
            {% endfor %}
          </select>
        </label>
      </div>
      <div class="col-md-3">
        <label class="form-label">Betrag in EUR<input class="form-control" type="number" min="0.01" step="0.01" name="amount" required></label>
      </div>
      <div class="col-md-6">
        <label class="form-label">Buchungstext<input class="form-control" name="description" maxlength="240" required></label>
      </div>
      <div class="col-md-4">
        <label class="form-label">Belegreferenz<input class="form-control" name="reference" maxlength="180"></label>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100">Buchen</button>
      </div>
    </form>
  </div>
</div>
<div class="row g-4 mt-1">
  <section class="col-xl-8">
    <div class="card">
      <div class="card-header">Journal</div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th>Datum</th>
              <th>Soll</th>
              <th>Haben</th>
              <th>Text</th>
              <th class="text-end">Betrag</th>
            </tr>
          </thead>
          <tbody>
          {% for transaction in transactions %}
            <tr>
              <td>{{ transaction.effectiveAt|date('d.m.Y') }}</td>
              <td>{{ transaction.debitAccount.code }}</td>
              <td>{{ transaction.creditAccount.code }}</td>
              <td>{{ transaction.description }}</td>
              <td class="text-end">{{ (transaction.amountCents / 100)|number_format(2, ',', '.') }} EUR</td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5">Keine Buchungen.</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="col-xl-4">
    <div class="card">
      <div class="card-header">Jahresabschluss</div>
      <div class="card-body">
        <form method="post" class="d-grid gap-2 mb-3">
        <input type="hidden" name="_token" value="{{ csrf_token('accounting_post') }}">
        <input type="hidden" name="operation" value="close">
        <label class="visually-hidden" for="close-year">Jahr</label>
        <input id="close-year" class="form-control" name="year" type="number" min="2000" value="{{ ('now'|date('Y')) - 1 }}">
        <button class="btn btn-outline-primary">Jahr endgültig abschließen</button>
        </form>
        {% for close in closes %}
          <div class="border-top pt-2 mb-2">
            <strong>{{ close.year }}</strong><br>Einnahmen {{ (close.incomeCents / 100)|number_format(2, ',', '.') }} EUR<br>Ausgaben {{ (close.expenseCents / 100)|number_format(2, ',', '.') }} EUR<br>Ergebnis {{ (close.resultCents / 100)|number_format(2, ',', '.') }} EUR
          </div>
        {% else %}
          <p class="text-muted">Noch kein Abschluss.</p>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

<div class="row g-4 mt-1">
  <section class="col-xl-4">
    <div class="card">
      <div class="card-header">
        <h2 class="h5 mb-0">Konto anlegen</h2>
      </div>
      <div class="card-body">
        <form method="post" class="vstack gap-3">
          <input type="hidden" name="_token" value="{{ csrf_token('accounting_post') }}">
          <input type="hidden" name="operation" value="account">
          <label class="form-label">Kontonummer<input class="form-control" name="code" required maxlength="20"></label>
          <label class="form-label">Bezeichnung<input class="form-control" name="name" required maxlength="120"></label>
          <label class="form-label">Kontotyp
            <select class="form-select" name="type">
              <option value="asset">Vermögen / Kasse / Bank</option>
              <option value="liability">Verbindlichkeit</option>
              <option value="equity">Eigenkapital</option>
              <option value="income">Einnahmen</option>
              <option value="expense">Ausgaben</option>
            </select>
          </label>
          <button class="btn btn-primary">Konto anlegen</button>
        </form>
      </div>
    </div>
  </section>
  <section class="col-xl-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Kontostände</h2>
        <form method="post">
          <input type="hidden" name="_token" value="{{ csrf_token('accounting_post') }}">
          <input type="hidden" name="operation" value="import_skr42">
          <button class="btn btn-sm {{ skr42Installed ? 'btn-outline-secondary' : 'btn-primary' }}">{{ skr42Installed ? 'SKR42 erneut prüfen' : 'SKR42 2026 importieren' }}</button>
        </form>
      </div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <th>Konto</th>
              <th>Kontenrahmen / Sphäre</th>
              <th>Typ</th>
              <th class="text-end">Saldo</th>
            </tr>
          </thead>
          <tbody>
            {% for account in accounts %}
              <tr>
                <td>
                  {{ account.code }} – {{ account.name }}
                  {% if account.usage %}
                    <div class="small text-muted">{{ account.usage }}</div>
                  {% endif %}
                </td>
                <td>
                  {{ account.chart }}
                  {% if account.sphere %}
                    <div class="small text-muted">{{ account.sphere }}</div>
                  {% endif %}
                </td>
                <td>{{ account.type }}</td>
                <td class="text-end">{{ (balances[account.id] / 100)|number_format(2, ',', '.') }} EUR</td>
              </tr>
            {% else %}
              <tr>
                <td colspan="4">Noch keine Konten.</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
{% endblock %}
