{% extends app.request.attributes.get('routeCreatedByEasyAdmin') ? 'admin/portal_layout.html.twig' : 'base.html.twig' %}
{% set duty_route_prefix = app.request.attributes.get('routeCreatedByEasyAdmin') ? 'admin_portal_' : '' %}
{% block title %}Thekendienst | DICOMA{% endblock %}
{% block content_title %}Thekendienste und Thekenkasse{% endblock %}
{% block hero %}{% endblock %}
{% block stylesheets %}{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/pages/bar-duty-portal.css') }}">
{% endblock %}
{% block body %}
    {% if duty_route_prefix %}{{ parent() }}{% else %}
        <main class="container py-4" data-bar-duty-portal>
            {{ block('duty_content') }}
        </main>
    {% endif %}
{% endblock %}
{% block main %}<div data-bar-duty-portal>{{ block('duty_content') }}</div>{% endblock %}
{% block duty_content %}
    <h1>Thekendienst im Vereinsheim</h1>
    {% if duty_route_prefix %}
        <nav class="d-flex flex-wrap gap-3 mb-4" aria-label="Clubheimverwaltung">
            <a href="{{ path('admin_portal_bar_duty') }}">Dienstkalender</a>
            <a href="{{ path('admin_portal_bar_duty_plan') }}">Veranstaltung / Serie eintragen</a>
            <a href="{{ path('admin_portal_bar_duty_settings') }}">Vorlagen und Pflichtstunden</a>
            <a href="{{ path('admin_portal_bar_duty_report') }}">Stundenkonten und Thekenkassen</a>
        </nav>
    {% endif %}
    {% for type, messages in app.flashes %}
        {% for message in messages %}<div role="status" class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}
    {% endfor %}
    {% block duty_body %}{% endblock %}
{% endblock %}
