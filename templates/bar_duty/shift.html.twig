{% extends 'bar_duty/layout.html.twig' %}
{% import 'bar_duty/_forms.html.twig' as f %}
{% block duty_body %}
<h2>{{ shift.title }} · #{{ shift.id }}</h2>
<p><a href="{{ path('bar_duty', {month:shift.startsAt|date('Y-m')}) }}">Zurück zum Veranstaltungskalender</a></p>
<p>{{ shift.startsAt|date('d.m.Y H:i') }} – {{ shift.endsAt|date('d.m.Y H:i') }} · {{ shift.location }} · {{ shift.capacity }} Plätze · {{ {'open':'Offen', 'completed':'Abgeschlossen', 'cancelled':'Abgesagt'}[shift.status] }}</p>
{% if shift.status == 'open' and shift.startsAt > date() %}
    <form method="post" action="{{ path('bar_duty_action', {operation:'signup', id:shift.id}) }}" class="mb-3">{{ f.token('signup', shift.id) }}<button class="btn btn-primary">Für Dienst anmelden</button></form>
    {% if manager %}
        <form class="card card-body mb-3" method="post" action="{{ path('bar_duty_action', {operation:'assign', id:shift.id}) }}">
            {{ f.token('assign', shift.id) }}<label>Mitglied zuweisen <select name="member" class="form-control" required>{% for member in members %}<option value="{{ member.id }}">{{ member }}</option>{% endfor %}</select></label><button class="btn btn-primary">Dienst zuweisen</button>
        </form>
    {% endif %}
{% endif %}
<section><h2>Einteilung und Anwesenheit</h2>
{% for assignment in assignments %}
    <article class="card card-body mb-3">
        <h3>{{ assignment.member }} · Dienst #{{ assignment.id }}</h3>
        <p>{{ assignment.status == 'active' ? 'Eingeteilt' : 'Zurückgezogen / ersetzt' }} · {{ {'pending':'Anwesenheit offen', 'present':'Anwesend', 'absent':'Abwesend'}[assignment.attendance] }} · {{ assignment.creditedMinutes }} bestätigte Minuten</p>
        {% if assignment.status == 'active' and shift.status == 'open' %}
            {% if shift.startsAt > date() and (manager or assignment.member.id == app.user.member.id) %}
                <form method="post" action="{{ path('bar_duty_action', {operation:'withdraw', id:assignment.id}) }}" class="mb-3">
                    {{ f.token('withdraw', assignment.id) }}{{ f.reason() }}<button class="btn btn-outline-danger">Dienst zurückziehen</button>
                </form>
                {% if assignment.member.id == app.user.member.id %}
                    <form method="post" action="{{ path('bar_duty_action', {operation:'propose', id:assignment.id}) }}">
                        {{ f.token('propose', assignment.id) }}
                        <label>Vertretung / Tauschpartner <select class="form-control" name="member" required>{% for member in members %}{% if member.id != app.user.member.id %}<option value="{{ member.id }}">{{ member }}</option>{% endif %}{% endfor %}</select></label>
                        <label>Gegendienst (für Tausch muss er dem ausgewählten Partner gehören)
                            <select class="form-control" name="counterpart"><option value="">Keiner: nur Vertretung</option>{% for other in counterparts %}{% if other.member.id != app.user.member.id and other.shift.id != shift.id %}<option value="{{ other.id }}">#{{ other.id }} · {{ other.member }} · {{ other.shift.startsAt|date('d.m.Y H:i') }} · {{ other.shift.title }}</option>{% endif %}{% endfor %}</select>
                        </label><button class="btn btn-outline-primary">Tausch / Vertretung anfragen</button>
                    </form>
                {% endif %}
            {% endif %}
            {% if manager and shift.endsAt <= date() %}
                <form method="post" action="{{ path('bar_duty_action', {operation:'attendance', id:assignment.id}) }}">
                    {{ f.token('attendance', assignment.id) }}
                    <label>Anwesenheit <select name="attendance" class="form-control"><option value="present">Anwesend</option><option value="absent">Abwesend (0 Minuten)</option></select></label>
                    <label>Tatsächlich geleistete Minuten (maximal 1440) <input class="form-control" name="minutes" type="number" min="0" max="1440" required></label>
                    {{ f.reason() }}<button class="btn btn-primary">Anwesenheit und Stunden bestätigen / korrigieren</button>
                </form>
            {% endif %}
        {% endif %}
        {% if manager or assignment.member.id == app.user.member.id %}<details><summary>Diensthistorie</summary><ul>{% for event in assignment.history %}<li>{{ event.at|date('d.m.Y H:i') }} · {{ event.actor }} · {{ event.event }} · {{ event.reason }}</li>{% endfor %}</ul></details>{% endif %}
    </article>
{% else %}<p>Noch keine Einteilungen.</p>{% endfor %}
</section>
{% if manager %}
    {% if shift.status == 'open' %}
        <section class="card card-body mb-4"><h2>Schicht abschließen oder absagen</h2>
            {% for op, label in {'complete':'Schicht abschließen', 'cancel':'Schicht absagen'} %}
                <form method="post" action="{{ path('bar_duty_action', {operation:op, id:shift.id}) }}" class="mb-3">{{ f.token(op, shift.id) }}{{ f.reason() }}<button class="btn btn-outline-danger">{{ label }}</button></form>
            {% endfor %}
            <p>Abschluss erst nach Schichtende und vollständiger Anwesenheitsprüfung; anschließend keine Stundenänderung. Eine eröffnete Thekenkasse verhindert die Absage.</p>
        </section>
    {% endif %}
    <section class="card card-body mb-4"><h2>Separate Thekenkasse</h2>
        <p>Nur tatsächlich übergebenes Bargeld. Keine Verrechnung mit Gerätewartkasse oder Dienststunden. Eigenständiger Kassensturz je Schicht.</p>
        {% if not session %}
            {% if shift.status != 'cancelled' %}
                <form method="post" action="{{ path('bar_duty_action', {operation:'cash-open', id:shift.id}) }}">
                    {{ f.token('cash-open', shift.id) }}<label>Gezählter Anfangsbestand (EUR) <input class="form-control" name="amount" inputmode="decimal" required></label>{{ f.reason() }}<button class="btn btn-primary">Separate Thekenkasse eröffnen</button>
                </form>
                <p>Erfordert aktivierte Thekenkasse in der Jahresregel.</p>
            {% endif %}
        {% else %}
            <p>Kasse #{{ session.id }} · Anfang {{ (session.openingCents / 100)|number_format(2, ',', '.') }} EUR · {{ session.openingNote }} · Eröffnet von {{ session.openedBy }}</p>
            <p>Sollbestand <strong>{{ (cashBalance / 100)|number_format(2, ',', '.') }} EUR</strong> · {{ session.closedAt ? 'Unveränderlich abgeschlossen' : 'Offen' }}</p>
            <a href="{{ path('bar_duty_cash_csv', {id:session.id}) }}">Kassenjournal als CSV</a>
            <div class="table-responsive"><table class="table"><thead><tr><th>Beleg</th><th>Zeit</th><th>Betrag EUR</th><th>Grund / Referenz</th><th>Bearbeiter</th><th>Korrektur</th></tr></thead><tbody>
            {% for entry in cashEntries %}<tr><td>#{{ entry.id }}</td><td>{{ entry.createdAt|date('d.m.Y H:i') }}</td><td>{{ (entry.amountCents / 100)|number_format(2, ',', '.') }}</td><td>{{ entry.reason }} · {{ entry.reference }}</td><td>{{ entry.createdBy }}</td><td>
                {% if entry.reversalOf %}Gegenbuchung zu #{{ entry.reversalOf.id }}
                {% elseif not session.closedAt %}
                    <form method="post" action="{{ path('bar_duty_action', {operation:'cash-reverse', id:session.id}) }}">{{ f.token('cash-reverse', session.id) }}<input type="hidden" name="entry" value="{{ entry.id }}">{{ f.reason() }}<button class="btn btn-sm btn-outline-danger">Gegenbuchung erfassen</button></form>
                {% endif %}
            </td></tr>{% else %}<tr><td colspan="6">Keine Bewegungen.</td></tr>{% endfor %}</tbody></table></div>
            {% if not session.closedAt %}
                <form method="post" action="{{ path('bar_duty_action', {operation:'cash-book', id:session.id}) }}" class="mb-3">
                    {{ f.token('cash-book', session.id) }}<label>Richtung <select name="direction" class="form-control"><option value="in">Einnahme</option><option value="out">Ausgabe</option></select></label>
                    <label>Betrag (EUR) <input name="amount" inputmode="decimal" class="form-control" required></label><label>Belegreferenz <input name="reference" maxlength="120" class="form-control"></label>
                    {{ f.reason() }}<button class="btn btn-primary">Bargeldbewegung buchen</button>
                </form>
                <form method="post" action="{{ path('bar_duty_action', {operation:'cash-close', id:session.id}) }}">
                    {{ f.token('cash-close', session.id) }}<label>Gezählter Istbestand (EUR) <input name="amount" inputmode="decimal" class="form-control" required></label>
                    {{ f.reason() }}<button class="btn btn-danger">Thekenkasse unwiderruflich abschließen</button>
                </form>
            {% else %}
                <p>Istbestand: {{ (session.countedCents / 100)|number_format(2, ',', '.') }} EUR · Differenz: {{ ((session.countedCents - session.expectedCents) / 100)|number_format(2, ',', '.') }} EUR · {{ session.closedBy }} · {{ session.closedAt|date('d.m.Y H:i') }} · {{ session.closingNote }}</p>
                <p class="small">Bewegungshash: {{ session.movementHash }}</p>
            {% endif %}
        {% endif %}
    </section>
    <details><summary>Schichthistorie</summary><ul>{% for event in shift.history %}<li>{{ event.at|date('d.m.Y H:i') }} · {{ event.actor }} · {{ event.event }} · {{ event.reason }}</li>{% endfor %}</ul></details>
{% endif %}
{% endblock %}
