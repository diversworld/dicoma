{% extends 'bar_duty/layout.html.twig' %}
{% block duty_body %}
<h2>{{ 'Thekenkasse'|trans }}</h2>
<p>{{ 'Du kannst ausschließlich die Kasse deiner aktiven eigenen Einteilung bedienen. Abgeschlossene Kassen bleiben unveränderlich.'|trans }}</p>
<ul>
{% for assignment in assignments %}
    <li><a href="{{ path(duty_route_prefix ~ 'bar_duty_shift', {id: assignment.shift.id}) }}#thekenkasse">{{ assignment.shift.startsAt|date('d.m.Y H:i') }} · {{ assignment.shift.title }}</a></li>
{% else %}<li>{{ 'Keine aktive eigene Diensteinteilung vorhanden.'|trans }}</li>{% endfor %}
</ul>
{% endblock %}
