{% extends 'base.html.twig' %}
{% block title %}Meine TÜV-Anmeldung | DICOMA{% endblock %}
{% block hero %}{% endblock %}
{% block body %}
<section class="section"><div class="container">
  <h1>Meine TÜV-Anmeldung #{{ booking.id }}</h1>
  <p><a href="{{ path('member_equipment_index') }}">← Zurück zu meiner Ausrüstung</a></p>
  <dl class="row">
    <dt class="col-sm-3">Flasche</dt><dd class="col-sm-9">{{ booking.memberTank.label }} ({{ booking.memberTank.serialNumber }})</dd>
    <dt class="col-sm-3">Prüftermin</dt><dd class="col-sm-9">{{ booking.tankCheck.checkDate ? booking.tankCheck.checkDate|date('d.m.Y') : 'Noch nicht festgelegt' }}</dd>
    <dt class="col-sm-3">Prüfstelle</dt><dd class="col-sm-9">{{ booking.tankCheck.vendorName ?: '–' }}</dd>
    <dt class="col-sm-3">Anmeldedatum</dt><dd class="col-sm-9">{{ booking.createdAt|date('d.m.Y H:i') }}</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">{{ {'requested': 'Angemeldet', 'cancelled': 'Storniert'}[booking.status] ?? booking.status }}</dd>
  </dl>
  <h2>Gebuchte Leistungen</h2>
  <div class="table-responsive"><table class="table table-striped">
    <thead><tr><th>Leistung</th><th>Menge</th><th class="text-right">Netto gesamt</th><th class="text-right">Brutto gesamt</th></tr></thead>
    <tbody>
      {% for item in items %}
      <tr>
        <td>{{ item.titleSnapshot }}</td>
        <td>{{ item.quantity }}</td>
        <td class="text-right">{{ (item.netSnapshot * item.quantity)|number_format(2, ',', '.') }} €</td>
        <td class="text-right">{{ (item.grossSnapshot * item.quantity)|number_format(2, ',', '.') }} €</td>
      </tr>
      {% else %}
      <tr><td colspan="4">Für diese Anmeldung sind keine Einzelpositionen gespeichert.</td></tr>
      {% endfor %}
    </tbody>
    <tfoot><tr><th colspan="2">Gesamt</th><th class="text-right">{{ netTotal|number_format(2, ',', '.') }} €</th><th class="text-right">{{ grossTotal|number_format(2, ',', '.') }} €</th></tr></tfoot>
  </table></div>
  <p class="text-muted">Die Beträge stammen aus den bei der Anmeldung gespeicherten Preisen. Spätere Preisänderungen beeinflussen diese Übersicht nicht.</p>
</div></section>
{% endblock %}
