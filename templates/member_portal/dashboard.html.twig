{% extends 'base.html.twig' %}
{% block title %}{{ 'Mein Mitgliederbereich'|trans }} | DICOMA{% endblock %}
{% block hero %}{% endblock %}
{% block stylesheets %}{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/pages/member-portal-dashboard.css') }}">
{% endblock %}
{% block body %}
<main class="member-portal"><div class="container">
<div class="row"><div class="col-sm-12"><h1>{{ 'Mein Mitgliederbereich'|trans }}</h1><p class="mp-subtitle">{{ 'Alles Wichtige rund um deine Ausrüstung, TÜV-Prüfungen und Ausbildung.'|trans }}</p></div></div>
<div class="row">
  <div class="col-md-4 col-sm-6 dw-margin-bottom-20px"><div class="mp-card"><h2>{{ 'Thekendienst'|trans }}</h2><p>{{ 'Dienste übernehmen, Tausch und Vertretungen abstimmen, Nachrichten und bestätigte Stunden ansehen.'|trans }}</p><a class="btn btn-primary mp-link" href="{{ path('bar_duty') }}">{{ 'Dienste und Stundenkonto'|trans }}</a><br><a class="mp-link" href="{{ path('member_calendar') }}">{{ 'Vereinskalender'|trans }}</a></div></div>
  <div class="col-md-4 col-sm-6 dw-margin-bottom-20px" ><div class="mp-card"><h2>{{ 'Meine Flaschen'|trans }}</h2><div class="mp-kpi">{{ tankCount }}</div><p>{{ dueCount > 0 ? '%count% Prüffrist(en) bald fällig oder überfällig'|trans({'%count%': dueCount}) : 'Deine private Ausrüstung im Blick'|trans }}</p><a class="btn btn-primary mp-link" href="{{ path('member_equipment_index') }}#meine-flaschen">{{ 'Flaschen ansehen'|trans }}</a></div></div>
  <div class="col-md-4 col-sm-6 dw-margin-bottom-20px" ><div class="mp-card"><h2>{{ 'TÜV-Prüfungen'|trans }}</h2><div class="mp-kpi">{{ upcoming|length }}</div><p>{{ 'Kommende veröffentlichte TÜV-Termine'|trans }}</p><a class="btn btn-primary mp-link" href="{{ path('member_equipment_index') }}#tuv-termine">{{ 'TÜV-Termin auswählen'|trans }}</a></div></div>
  <div class="col-md-4 col-sm-6 dw-margin-bottom-20px" ><div class="mp-card"><h2>{{ 'Meine Ausbildung'|trans }}</h2><p>{{ 'Fortschritt, anstehende Kurse und meine Anmeldungen.'|trans }}</p><a class="btn btn-primary mp-link" href="{{ path('app_my_training_progress') }}">{{ 'Fortschritt ansehen'|trans }}</a><br><a class="mp-link" href="{{ path('frontend_course_registration_index') }}">{{ 'Kurse entdecken →'|trans }}</a></div></div>
</div>
<div class="row"><div class="col-12 mb-3"><div class="mp-card dw-card-toolbar" ><div><h2>{{ 'Ausrüstung ausleihen'|trans }}</h2><p class="mb-0">{{ 'Verleihbare Vereinsausrüstung finden, für einen Zeitraum reservieren und eigene Reservierungen verwalten.'|trans }}</p></div><a class="btn btn-primary" href="{{ path('member_reservations') }}">{{ 'Zur Reservierung →'|trans }}</a></div></div></div>
<div class="row mp-section"><div class="col-md-7 dw-margin-bottom-20px" ><div class="mp-card"><h2>{{ 'Meine letzten TÜV-Anmeldungen'|trans }}</h2>
{% for booking in bookings %}<div class="mp-row"><strong>{{ booking.tankCheck.checkDate|date('d.m.Y') }}</strong> · {{ booking.memberTank ? booking.memberTank.label : 'Flasche'|trans }}<div class="text-muted">{{ 'Status'|trans }}: {% include 'member_portal/_booking_status.html.twig' with {status: booking.status} only %}</div><a href="{{ path('member_tank_check_booking_detail', {id: booking.id}) }}">{{ 'Details ansehen →'|trans }}</a></div>{% else %}<p>{{ 'Du hast noch keine Flasche zum TÜV angemeldet.'|trans }}</p><a href="{{ path('member_equipment_index') }}#tuv-termine">{{ 'Zur TÜV-Anmeldung →'|trans }}</a>{% endfor %}
</div></div><div class="col-md-5 dw-margin-bottom-20px" ><div class="mp-card"><h2>{{ 'Schnellzugriff'|trans }}</h2><div class="mp-row"><a href="{{ path('member_equipment_index') }}#flasche-hinzufuegen">{{ '+ Private Flasche hinzufügen'|trans }}</a></div><div class="mp-row"><a href="{{ path('frontend_course_registrations') }}">{{ 'Meine Kursanmeldungen'|trans }}</a></div><div class="mp-row"><a href="{{ path('app_my_training_attendance') }}">{{ 'Meine Anwesenheit'|trans }}</a></div><div class="mp-row"><a href="{{ path('app_profile') }}">{{ 'Profil und Dokumente'|trans }}</a></div></div></div></div>
</div></main>
{% endblock %}
