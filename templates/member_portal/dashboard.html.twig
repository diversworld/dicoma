{% extends 'base.html.twig' %}
{% block title %}Mein Mitgliederbereich | DICOMA{% endblock %}
{% block hero %}{% endblock %}
{% block stylesheets %}{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/pages/member-portal-dashboard.css') }}">
{% endblock %}
{% block body %}
<main class="member-portal"><div class="container">
<div class="row"><div class="col-sm-12"><h1>Mein Mitgliederbereich</h1><p class="mp-subtitle">Alles Wichtige rund um deine Ausrüstung, TÜV-Prüfungen und Ausbildung.</p></div></div>
<div class="row">
  <div class="col-md-4 col-sm-6 dw-margin-bottom-20px"><div class="mp-card"><h2>Thekendienst</h2><p>Dienste übernehmen, Tausch und Vertretungen abstimmen, Nachrichten und bestätigte Stunden ansehen.</p><a class="btn btn-primary mp-link" href="{{ path('bar_duty') }}">Dienste und Stundenkonto</a><br><a class="mp-link" href="{{ path('member_calendar') }}">Vereinskalender</a></div></div>
  <div class="col-md-4 col-sm-6 dw-margin-bottom-20px" ><div class="mp-card"><h2>Meine Flaschen</h2><div class="mp-kpi">{{ tankCount }}</div><p>{{ dueCount > 0 ? dueCount ~ ' Prüffrist(en) bald fällig oder überfällig' : 'Deine private Ausrüstung im Blick' }}</p><a class="btn btn-primary mp-link" href="{{ path('member_equipment_index') }}#meine-flaschen">Flaschen ansehen</a></div></div>
  <div class="col-md-4 col-sm-6 dw-margin-bottom-20px" ><div class="mp-card"><h2>TÜV-Prüfungen</h2><div class="mp-kpi">{{ upcoming|length }}</div><p>Kommende veröffentlichte TÜV-Termine</p><a class="btn btn-primary mp-link" href="{{ path('member_equipment_index') }}#tuv-termine">TÜV-Termin auswählen</a></div></div>
  <div class="col-md-4 col-sm-6 dw-margin-bottom-20px" ><div class="mp-card"><h2>Meine Ausbildung</h2><p>Fortschritt, anstehende Kurse und meine Anmeldungen.</p><a class="btn btn-primary mp-link" href="{{ path('app_my_training_progress') }}">Fortschritt ansehen</a><br><a class="mp-link" href="{{ path('frontend_course_registration_index') }}">Kurse entdecken →</a></div></div>
</div>
<div class="row"><div class="col-12 mb-3"><div class="mp-card dw-card-toolbar" ><div><h2>Ausrüstung ausleihen</h2><p class="mb-0">Verleihbare Vereinsausrüstung finden, für einen Zeitraum reservieren und eigene Reservierungen verwalten.</p></div><a class="btn btn-primary" href="{{ path('member_reservations') }}">Zur Reservierung →</a></div></div></div>
<div class="row mp-section"><div class="col-md-7 dw-margin-bottom-20px" ><div class="mp-card"><h2>Meine letzten TÜV-Anmeldungen</h2>
{% for booking in bookings %}<div class="mp-row"><strong>{{ booking.tankCheck.checkDate|date('d.m.Y') }}</strong> · {{ booking.memberTank ? booking.memberTank.label : 'Flasche' }}<div class="text-muted">Status: {% include 'member_portal/_booking_status.html.twig' with {status: booking.status} only %}</div><a href="{{ path('member_tank_check_booking_detail', {id: booking.id}) }}">Details ansehen →</a></div>{% else %}<p>Du hast noch keine Flasche zum TÜV angemeldet.</p><a href="{{ path('member_equipment_index') }}#tuv-termine">Zur TÜV-Anmeldung →</a>{% endfor %}
</div></div><div class="col-md-5 dw-margin-bottom-20px" ><div class="mp-card"><h2>Schnellzugriff</h2><div class="mp-row"><a href="{{ path('member_equipment_index') }}#flasche-hinzufuegen">+ Private Flasche hinzufügen</a></div><div class="mp-row"><a href="{{ path('frontend_course_registrations') }}">Meine Kursanmeldungen</a></div><div class="mp-row"><a href="{{ path('app_my_training_attendance') }}">Meine Anwesenheit</a></div><div class="mp-row"><a href="{{ path('app_profile') }}">Profil und Dokumente</a></div></div></div></div>
</div></main>
{% endblock %}
