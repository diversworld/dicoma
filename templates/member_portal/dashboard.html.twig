{% extends 'base.html.twig' %}
{% block title %}Mein Mitgliederbereich | DICOMA{% endblock %}
{% block hero %}{% endblock %}
{% block body %}
<style>
.member-portal{padding:35px 0 65px;background:#f7f9fc;min-height:65vh}.member-portal .mp-card{background:white;border:1px solid #e4eaf0;border-radius:12px;padding:22px;height:100%;box-shadow:0 3px 14px rgba(24,49,73,.04)}.member-portal .mp-card h2{font-size:20px;margin:0 0 10px}.member-portal .mp-card p{color:#526274;min-height:40px}.member-portal .mp-kpi{font-size:32px;font-weight:700;color:#16476b}.member-portal .mp-link{display:inline-block;margin-top:10px}.member-portal .mp-subtitle{color:#526274}.member-portal .mp-section{margin-top:32px}.member-portal .mp-row{padding:12px 0;border-bottom:1px solid #edf0f3}.member-portal .mp-row:last-child{border-bottom:0}
</style>
<main class="member-portal"><div class="container">
<div class="row"><div class="col-sm-12"><h1>Mein Mitgliederbereich</h1><p class="mp-subtitle">Alles Wichtige rund um deine Ausrüstung, TÜV-Prüfungen und Ausbildung.</p></div></div>
<div class="row">
  <div class="col-md-4 col-sm-6" style="margin-bottom:20px"><div class="mp-card"><h2>Meine Flaschen</h2><div class="mp-kpi">{{ tankCount }}</div><p>{{ dueCount > 0 ? dueCount ~ ' Prüffrist(en) bald fällig oder überfällig' : 'Deine private Ausrüstung im Blick' }}</p><a class="btn btn-primary mp-link" href="{{ path('member_equipment_index') }}#meine-flaschen">Flaschen ansehen</a></div></div>
  <div class="col-md-4 col-sm-6" style="margin-bottom:20px"><div class="mp-card"><h2>TÜV-Prüfungen</h2><div class="mp-kpi">{{ upcoming|length }}</div><p>Kommende veröffentlichte TÜV-Termine</p><a class="btn btn-primary mp-link" href="{{ path('member_equipment_index') }}#tuv-termine">TÜV-Termin auswählen</a></div></div>
  <div class="col-md-4 col-sm-6" style="margin-bottom:20px"><div class="mp-card"><h2>Meine Ausbildung</h2><p>Fortschritt, anstehende Kurse und meine Anmeldungen.</p><a class="btn btn-primary mp-link" href="{{ path('app_my_training_progress') }}">Fortschritt ansehen</a><br><a class="mp-link" href="{{ path('frontend_course_registration_index') }}">Kurse entdecken →</a></div></div>
</div>
<div class="row"><div class="col-12 mb-3"><div class="mp-card" style="height:auto;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap"><div><h2>Ausrüstung ausleihen</h2><p class="mb-0">Verleihbare Vereinsausrüstung finden, für einen Zeitraum reservieren und eigene Reservierungen verwalten.</p></div><a class="btn btn-primary" href="{{ path('member_reservations') }}">Zur Reservierung →</a></div></div></div>
<div class="row mp-section"><div class="col-md-7" style="margin-bottom:20px"><div class="mp-card"><h2>Meine letzten TÜV-Anmeldungen</h2>
{% for booking in bookings %}<div class="mp-row"><strong>{{ booking.tankCheck.checkDate|date('d.m.Y') }}</strong> · {{ booking.memberTank ? booking.memberTank.label : 'Flasche' }}<div class="text-muted">Status: {% include 'member_portal/_booking_status.html.twig' with {status: booking.status} only %}</div><a href="{{ path('member_tank_check_booking_detail', {id: booking.id}) }}">Details ansehen →</a></div>{% else %}<p>Du hast noch keine Flasche zum TÜV angemeldet.</p><a href="{{ path('member_equipment_index') }}#tuv-termine">Zur TÜV-Anmeldung →</a>{% endfor %}
</div></div><div class="col-md-5" style="margin-bottom:20px"><div class="mp-card"><h2>Schnellzugriff</h2><div class="mp-row"><a href="{{ path('member_equipment_index') }}#flasche-hinzufuegen">+ Private Flasche hinzufügen</a></div><div class="mp-row"><a href="{{ path('frontend_course_registrations') }}">Meine Kursanmeldungen</a></div><div class="mp-row"><a href="{{ path('app_my_training_attendance') }}">Meine Anwesenheit</a></div><div class="mp-row"><a href="{{ path('app_profile') }}">Profil und Dokumente</a></div></div></div></div>
</div></main>
{% endblock %}
