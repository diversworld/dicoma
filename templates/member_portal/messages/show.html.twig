{% extends 'base.html.twig' %}
{% block title %}{{ message.subject }} | DICOMA{% endblock %}
{% block hero %}{% endblock %}
{% block body %}
<main class="container py-4">
    <div class="mb-3">
        <a href="{{ path('member_messages') }}">← Zum Posteingang</a>
    </div>
    <article class="card">
        <div class="card-header">
            <h1 class="h3 mb-1">{{ message.subject }}</h1>
            <div class="text-muted">
                Von {{ message.sender.member ? message.sender.member.fullName : message.sender.userIdentifier }}
                · {{ message.sentAt|date('d.m.Y H:i') }}
            </div>
        </div>
        <div class="card-body">{{ message.body|nl2br }}</div>
    </article>
    {% if canReply %}
        <p class="mt-3">Antworten über die Direktnachricht-Auswahl im Posteingang.</p>
    {% endif %}
</main>
{% endblock %}
