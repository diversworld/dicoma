{% extends 'base.html.twig' %}

{% block title %}{{ 'Edit Student'|trans }}{% endblock %}

{% block body %}
<section class="about section">
    <div class="container">
        <h1>{{ 'Edit Student'|trans }}</h1>
        <div class="row">
            <div class="col-md-2">
                <div class="block">
                    <a class="btn btn-transparent btn-solid-border" href="{{ path('app_student_index') }}">{{ 'back to list'|trans }}</a>
                </div>
            </div>
            <div class="col-md-2">
                <div class="block">
                    <a class="btn btn-transparent btn-solid-border" href="{{ path('app_student_edit', {'id': student.id}) }}">{{ 'Edit'|trans }}</a>
                </div>
            </div>
            <div class="col-md-2">
                <div class="block">
                    {{ include('student/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
        <div class="row">
            &nbsp;
        </div>

        {{ include('student/_form.html.twig', {'button_label': 'Update'}) }}

    </div>
</section>
{% endblock %}
