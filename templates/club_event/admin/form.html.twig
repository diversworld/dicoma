{% extends 'admin/portal_layout.html.twig' %}
{% form_theme form '@EasyAdmin/crud/form_theme.html.twig' %}
{% block content_title %}Veranstaltung anlegen{% endblock %}
{% block main %}
{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
<p>Bis zur ersten Anmeldung können Veranstaltungen bearbeitet werden. Danach bleiben die Angaben unveränderlich; bei Bedarf absagen und neu anlegen.</p>
<p>Bilder zuerst in der <a href="{{ path('admin_media_index') }}">Dateiverwaltung</a> hochladen und anschließend auswählen. Das Bild kann auch später separat geändert werden.</p>
{{ form_start(form, {attr: {class: 'ea-form', novalidate: 'novalidate'}}) }}
    {{ form_errors(form) }}
    <div class="form-fieldset">
        <fieldset>
            <div class="form-fieldset-header collapsible"><div class="form-fieldset-title"><a href="#event-basics" data-bs-toggle="collapse" class="form-fieldset-title-content form-fieldset-collapse">Grunddaten und Inhalt</a></div></div>
            <div id="event-basics" class="form-fieldset-body collapse show"><div class="row">
            <div class="col-md-8">{{ form_row(form.title) }}</div>
            <div class="col-md-4">{{ form_row(form.eventType) }}</div>
            <div class="col-12">{{ form_row(form.description) }}</div>
            <div class="col-md-6">{{ form_row(form.division) }}</div>
            <div class="col-md-6">{{ form_row(form.responsible) }}</div>
            </div></div>
        </fieldset>
    </div>
    <div class="form-fieldset">
        <fieldset>
            <div class="form-fieldset-header collapsible"><div class="form-fieldset-title"><a href="#event-time" data-bs-toggle="collapse" class="form-fieldset-title-content form-fieldset-collapse">Termin und Wiederholung</a></div></div>
            <div id="event-time" class="form-fieldset-body collapse show"><div class="row">
            <div class="col-md-6">{{ form_row(form.startsAt) }}</div>
            <div class="col-md-6">{{ form_row(form.endsAt) }}</div>
            <div class="col-md-6">{{ form_row(form.deadline) }}</div>
            <div class="col-md-6">{{ form_row(form.location) }}</div>
            <div class="col-md-6">{{ form_row(form.recurrence) }}</div>
            <div class="col-md-6">{{ form_row(form.recurrenceUntil) }}</div>
            </div></div>
        </fieldset>
    </div>
    <div class="form-fieldset">
        <fieldset>
            <div class="form-fieldset-header collapsible"><div class="form-fieldset-title"><a href="#event-module" data-bs-toggle="collapse" class="form-fieldset-title-content form-fieldset-collapse">Kurs, Turnier, Anmeldung und Preise</a></div></div>
            <div id="event-module" class="form-fieldset-body collapse show"><div class="row">
            <div class="col-md-6">{{ form_row(form.course) }}</div>
            <div class="col-md-6">{{ form_row(form.tournament) }}</div>
            <div class="col-md-4">{{ form_row(form.pricing) }}</div>
            <div class="col-md-4">{{ form_row(form.memberFeeCents) }}</div>
            <div class="col-md-4">{{ form_row(form.guestFeeCents) }}</div>
            <div class="col-md-4">{{ form_row(form.capacity) }}</div>
            <div class="col-md-4">{{ form_row(form.registrationEnabled) }}</div>
            <div class="col-md-4">{{ form_row(form.published) }}</div>
            </div></div>
        </fieldset>
    </div>
    {% if form.image is defined %}
    <div class="form-fieldset">
        <fieldset>
            <div class="form-fieldset-header collapsible"><div class="form-fieldset-title"><a href="#event-image" data-bs-toggle="collapse" class="form-fieldset-title-content form-fieldset-collapse collapsed">Bild</a></div></div>
            <div id="event-image" class="form-fieldset-body collapse"><div class="row">{{ form_row(form.image) }}</div></div>
        </fieldset>
    </div>
    {% endif %}
    {{ form_row(form._token) }}
    <div class="form-actions">
        <button class="btn btn-primary action-save" type="submit">Veranstaltung speichern</button>
        <a class="btn btn-secondary" href="{{ path('admin_club_events') }}">Abbrechen</a>
    </div>
{{ form_end(form, {render_rest: false}) }}
{% endblock %}
