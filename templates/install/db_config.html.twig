{# templates/db_config.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Konfigurieren Sie Ihre Datenbank{% endblock %}

{% block body %}
    <h1>Konfigurieren Sie Ihre Datenbank</h1>

    {% if error is defined %}
        <p>{{ error }}</p>
    {% endif %}

    <form action="{{ path('save_db_config') }}" method="post">
        <label for="db_host">Datenbank-Host:</label><br>
        <input type="text" id="db_host" name="db_host"><br>
        <label for="db_name">Datenbank-Name:</label><br>
        <input type="text" id="db_name" name="db_name"><br>
        <label for="db_user">Datenbank-Benutzername:</label><br>
        <input type="text" id="db_user" name="db_user"><br>
        <label for="db_pass">Datenbank-Passwort:</label><br>
        <input type="password" id="db_pass" name="db_pass"><br>
        <input type="submit" value="Konfigurationsdaten speichern">
    </form>
{% endblock %}
