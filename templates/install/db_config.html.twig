{# templates/db_config.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'Konfigurieren Sie Ihre Datenbank'|trans }}{% endblock %}

{% block body %}
<section class="portfolio-work section">
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <div class="block">
                    <div class="form-group">
                        <h1>{{ 'Konfigurieren Sie Ihre Datenbank'|trans }}</h1>
                    </div>
                </div>
            </div>
        </div>
        {% if error is defined %}
            <div class="alert alert-danger" role="alert">{{ error|trans }}</div>
        {% endif %}
        <div class="row">
            <div class="col-md-8">
                <div class="block">
                    <div class="form-group">
                        {{ form_start(form) }}
                            {{ form_widget(form) }}
                            <button type="submit">{{ 'Konfigurationsdaten speichern'|trans }}</button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
