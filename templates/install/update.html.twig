{% extends 'admin/portal_layout.html.twig' %}

{% block content_title %}Installation und Funktionsprüfung{% endblock %}

{% block main %}
<div class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">DICOMA-Softwareversion</h2></div>
    <div class="card-body">
        {% if not softwareVersion.checked %}
            <div class="alert alert-warning mb-3">
                Die Versionsprüfung war nicht möglich: {{ softwareVersion.error }}
            </div>
        {% elseif softwareVersion.available %}
            <div class="alert alert-warning mb-3">
                <strong>Neue Version verfügbar:</strong> {{ softwareVersion.latest }}<br>
                Installiert ist {{ softwareVersion.installed }}.
            </div>
        {% else %}
            <div class="alert alert-success mb-3">
                Die installierte Version {{ softwareVersion.installed }} ist aktuell. Neuester Git-Tag: {{ softwareVersion.latest }}.
            </div>
        {% endif %}
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="{{ softwareVersion.url }}" target="_blank" rel="noopener noreferrer">Git-Tags im Repository ansehen</a>
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('installation_update') }}">
                <input type="hidden" name="operation" value="check_version">
                <button class="btn btn-primary btn-sm">Jetzt erneut prüfen</button>
            </form>
        </div>
    </div>
</div>
<div class="alert alert-info">
    Installationskatalog Version {{ version }}. Bestehende Datensätze werden nicht überschrieben; es werden ausschließlich fehlende Kernfunktionen ergänzt.
</div>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Verfügbare Kernfunktionen</h2>
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('installation_update') }}">
            <button class="btn btn-primary">Alle fehlenden Funktionen installieren</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead><tr><th>Komponente</th><th>Status</th><th class="text-end">Aktion</th></tr></thead>
            <tbody>
            {% for component in components %}
                <tr>
                    <td>{{ component.label }}</td>
                    <td>{% if component.installed %}<span class="badge text-bg-success">Installiert</span>{% else %}<span class="badge text-bg-warning">Fehlt</span>{% endif %}</td>
                    <td class="text-end">
                        {% if not component.installed %}
                            <form method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('installation_update') }}">
                                <input type="hidden" name="component" value="{{ component.id }}">
                                <button class="btn btn-sm btn-outline-primary">Installieren</button>
                            </form>
                        {% else %}—{% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
