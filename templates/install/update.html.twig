{% extends 'admin/portal_layout.html.twig' %}

{% block content_title %}Installation und Funktionsprüfung{% endblock %}

{% block main %}
<div class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">DICOMA-Softwareversion</h2></div>
    <div class="card-body">
        {% if not softwareVersion.checked %}
            <div class="alert alert-warning mb-3">
                Die Versionsprüfung war nicht möglich: {{ softwareVersion.error }}
            </div>
        {% elseif softwareVersion.available %}
            <div class="alert alert-warning mb-3">
                <strong>Neue Version verfügbar:</strong> {{ softwareVersion.latest }}<br>
                Installiert ist {{ softwareVersion.installed }}.<br>
                Vor der Installation werden die Datenbank, Konfiguration und Projektdateien automatisch gesichert.
            </div>
        {% else %}
            <div class="alert alert-success mb-3">
                Die installierte Version {{ softwareVersion.installed }} ist aktuell. Neuester Git-Tag: {{ softwareVersion.latest }}.
            </div>
        {% endif %}
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="{{ softwareVersion.url }}" target="_blank" rel="noopener noreferrer">Git-Tags im Repository ansehen</a>
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('installation_update') }}">
                <input type="hidden" name="operation" value="check_version">
                <button class="btn btn-primary btn-sm">Jetzt erneut prüfen</button>
            </form>
            {% if softwareVersion.checked and softwareVersion.available %}
                <form method="post" class="d-flex align-items-center gap-2" onsubmit="return confirm('Backup erstellen und Version {{ softwareVersion.latest }} installieren? Individuell geänderte Programmdateien werden überschrieben.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('installation_update') }}">
                    <input type="hidden" name="operation" value="install_version">
                    <input type="hidden" name="backup_confirmed" value="1">
                    <button class="btn btn-warning btn-sm">Version {{ softwareVersion.latest }} mit Backup installieren</button>
                </form>
            {% endif %}
        </div>
        {% if softwareVersion.checked and softwareVersion.available %}
            <p class="text-muted small mt-3 mb-0">
                Das Update benötigt PHP-CLI, Composer, PHP-cURL, PHP-Zip und
                das zum Datenbanksystem passende Backup-Programm (mysqldump beziehungsweise pg_dump).
                Ein Git-Arbeitsverzeichnis ist nicht erforderlich. Individuell geänderte Programmdateien
                werden nach dem Backup überschrieben; Konfiguration und hochgeladene Dateien bleiben erhalten.
                Die Backups werden im nicht öffentlich erreichbaren Verzeichnis <code>var/backups</code> gespeichert.
                Für die Dauer des Updates müssen die Server-Timeouts ausreichend hoch eingestellt sein;
                währenddessen sollten keine anderen Nutzer Änderungen vornehmen.
            </p>
        {% endif %}
    </div>
</div>
<div class="alert alert-info">
    Installationskatalog Version {{ version }}. Bestehende Datensätze werden nicht überschrieben; es werden ausschließlich fehlende Kernfunktionen ergänzt.
</div>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Verfügbare Kernfunktionen</h2>
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('installation_update') }}">
            <button class="btn btn-primary">Alle fehlenden Funktionen installieren</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead><tr><th>Komponente</th><th>Status</th><th class="text-end">Aktion</th></tr></thead>
            <tbody>
            {% for component in components %}
                <tr>
                    <td>{{ component.label }}</td>
                    <td>{% if component.installed %}<span class="badge text-bg-success">Installiert</span>{% else %}<span class="badge text-bg-warning">Fehlt</span>{% endif %}</td>
                    <td class="text-end">
                        {% if not component.installed %}
                            <form method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('installation_update') }}">
                                <input type="hidden" name="component" value="{{ component.id }}">
                                <button class="btn btn-sm btn-outline-primary">Installieren</button>
                            </form>
                        {% else %}—{% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
