{# templates/install.html.twig #}

{% extends 'base.html.twig' %}

{% block install %}
    <h1>Create a new User</h1>
    <form method="post" action="{{ path('install') }}">
        {{ form_widget(registrationForm) }}
        <button class="btn" type="submit">Create</button>
    </form>
{% endblock %}
