{% extends backend ? 'account/backend_layout.html.twig' : 'account/frontend_layout.html.twig' %}
{% block account_title %}{{ 'Kennwort ändern'|trans }}{% endblock %}
{% block account_body %}
    <p>{{ 'Nach der Änderung melden Sie sich mit dem neuen Kennwort erneut an.'|trans }}</p>
    {{ form_start(form) }}
    {{ form_row(form.currentPassword) }}
    {{ form_row(form.plainPassword) }}
    <button class="btn btn-primary" type="submit">{{ 'Kennwort ändern'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
